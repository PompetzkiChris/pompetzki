#lang racket/gui
(require json racket/file "gui.rkt")
(define arguments (vector->list (current-command-line-arguments)))
(unless (= (length arguments) 1) (error 'test-gui "provide a fresh output directory"))
(define output (path->complete-path (car arguments)))
(when (or (directory-exists? output) (file-exists? output)) (error 'test-gui "output exists"))
(make-directory* output)
(define cases
  (list
   (list "rref-zero-pivot" 0 "[0,1;1,2]" "" "The reduced row echelon form")
   (list "rank-rectangular" 1 "[1,2,3;2,4,6]" "" "The rank is 1 and the nullity is 2")
   (list "solve-infinite" 4 "[1,2,3;2,4,6]" "[4;8]" "infinitely many solutions")
   (list "solve-inconsistent" 4 "[1,2;2,4]" "[1;3]" "no solution")
   (list "det-exact" 5 "[1/2,1/3;2/5,3/7]" "irrelevant unfinished B" "17/210")
   (list "inverse-singular" 6 "[1,2;2,4]" "" "no inverse")
   (list "invalid-decimal" 0 "[0.5]" "" "Rejected")
   (list "empty-product" 9 "empty 2 0" "empty 0 3" "2 by 3 zero matrix")))
(define results
  (for/list ([case cases])
    (define-values (name op a b expected) (apply values case))
    (send a-text erase) (send a-text insert a)
    (send b-text erase) (send b-text insert b)
    (send op-choice set-selection op)
    (send compute-button command (new control-event% [event-type 'button]))
    (define answer (answer-string))
    (call-with-output-file (build-path output (string-append name ".answer.txt")) #:exists 'error (lambda (o) (display answer o)))
    (unless (string-contains? answer expected) (error 'test-gui "~a answer differs: ~a" name answer))
    (hash 'case name 'expected_substring expected 'answer answer 'passed #t)))
(change-font-size! 2) (change-font-size! -2)
(define answer-path (build-path output "saved-answer.txt"))
(save-answer-to answer-path)
(define prior (file->bytes answer-path))
(define refused? (with-handlers ([exn:fail? (lambda (e) #t)]) (save-answer-to answer-path) #f))
(unless (and refused? (bytes=? prior (file->bytes answer-path))) (error 'test-gui "save refusal failed"))
(export-answer-to (build-path output "exported-answer.txt"))
(define report (hash 'compute_cases (length results) 'passed (length results) 'tests results
                     'answer_locked (send answer-text is-locked?) 'existing_save_refused refused?
                     'frame_shown (send frame is-shown?) 'interaction "owned Racket Compute control callback; no simulated keys or focus"))
(call-with-output-file (build-path output "results.json") #:exists 'error (lambda (o) (write-json report o)))
(write-json (hash 'compute_cases (length results) 'passed (length results) 'existing_save_refused refused?))
(newline)
(exit 0)
