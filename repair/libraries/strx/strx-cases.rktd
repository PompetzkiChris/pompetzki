((1 pad-left (#"a" 3 #"0") #"00a")
 (2 pad-right (#"a" 4 #"xy") #"axyx")
 (3 pad-left (#"abc" 3 #"x") #"abc")
 (4 pad-right (#"abc" -1 #"x") #"abc")
 (5 pad-left (#"" 5 #"ab") #"ababa")
 (6 pad-right (#"" 4 #"xyz") #"xyzx")
 (7 pad-left (#"a" 5 #"") #"a")
 (8 pad-right (#"a" 5 #"") #"a")
 (9 pad-left (#"\0b" 5 #"XY") #"XYX\0b")
 (10 pad-right (#"\316\273" 5 #"\303\251") #"\316\273\303\251\303")
 (11 split (#"a,b,c" #",") (#"a" #"b" #"c"))
 (12 split (#",a," #",") (#"" #"a" #""))
 (13 split (#"aaa" #"aa") (#"" #"a"))
 (14 split (#"" #",") (#""))
 (15 split (#"abc" #"") (#"abc"))
 (16 split (#"abc" #"xyz") (#"abc"))
 (17 split (#"a--b----c--" #"--") (#"a" #"b" #"" #"c" #""))
 (18 split (#"\0a\0\0" #"\0") (#"" #"a" #"" #""))
 (19 split (#"\316\273|\303\251|" #"|") (#"\316\273" #"\303\251" #""))
 (20 split (#"abababa" #"aba") (#"" #"b" #""))
 (21 join (() #",") #"")
 (22 join ((#"a") #",") #"a")
 (23 join ((#"a" #"b" #"c") #",") #"a,b,c")
 (24 join ((#"" #"a" #"") #"|") #"|a|")
 (25 join ((#"a" #"b") #"") #"ab")
 (26 join ((#"" #"" #"") #"--") #"----")
 (27 join ((#"\0" #"a\0") #"\0") #"\0\0a\0")
 (28 join ((#"\316\273" #"\303\251") #"/") #"\316\273/\303\251")
 (29 replace (#"banana" #"ana" #"X") #"bXna")
 (30 replace (#"aaaa" #"aa" #"B") #"BB")
 (31 replace (#"aaa" #"aa" #"B") #"Ba")
 (32 replace (#"abc" #"" #"X") #"abc")
 (33 replace (#"" #"a" #"X") #"")
 (34 replace (#"abc" #"x" #"y") #"abc")
 (35 replace (#"foo" #"foo" #"") #"")
 (36 replace (#"a-b-a-b" #"a" #"XX") #"XX-b-XX-b")
 (37 replace (#"ababab" #"ab" #"ab") #"ababab")
 (38 replace (#"aaaa" #"a" #"aa") #"aaaaaaaa")
 (39 replace (#"\0a\0" #"\0" #"Z") #"ZaZ")
 (40 replace (#"xx\316\273xx\316\273" #"\316\273" #"\303\251") #"xx\303\251xx\303\251")
 (41 trim (#" abc ") #"abc")
 (42 trim (#"\t\n\013\014\r abc \t\n\013\014\r") #"abc")
 (43 trim (#"") #"")
 (44 trim (#"\t\n\013\014\r ") #"")
 (45 trim (#"a b\tc") #"a b\tc")
 (46 trim (#"\0 a \0") #"\0 a \0")
 (47 trim (#"\302\240abc\302\240") #"\302\240abc\302\240")
 (48 trim (#" \316\273\t") #"\316\273")
 (49 trim (#" \0 ") #"\0")
 (50 trim (#"\t a \n b \r") #"a \n b"))
