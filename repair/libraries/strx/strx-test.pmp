blob TEST_C49_E0_B [ 0 ]
set TEST_C49_E0_B_len const 1
text TEST_EXPECT pad TEST_C49_E0_B 1
set TEST_EXPECT_len const 1
gosub TEST_CHECK
gosub TEST_EMIT
text TEST_OUT join TEST_OUT TEST_LF

; case 50: trim
blob TEST_C50_S_B [ 9 32 97 32 10 32 98 32 13 ]
set TEST_C50_S_B_len const 9
text SX_S pad TEST_C50_S_B 9
set SX_S_len const 9
gosub SX_TRIM
text TEST_PREFIX "50|trim|1|"
text TEST_OUT join TEST_OUT TEST_PREFIX
blob TEST_C50_E0_B [ 97 32 10 32 98 ]
set TEST_C50_E0_B_len const 5
text TEST_EXPECT pad TEST_C50_E0_B 5
set TEST_EXPECT_len const 5
gosub TEST_CHECK
gosub TEST_EMIT
text TEST_OUT join TEST_OUT TEST_LF
text TEST_ACCEPT "ACCEPT 50\n"
text TEST_OUT join TEST_OUT TEST_ACCEPT
text TEST_FILE arg
write TEST_FILE TEST_OUT TEST_OUT_len
say "ACCEPT 50"
goto TEST_END

label TEST_CHECK
set TEST_DIFF sub SX_T_len TEST_EXPECT_len
check zero TEST_DIFF
set TEST_CHECK_I const 0
label TEST_CHECK_LOOP
set TEST_DIFF sub TEST_CHECK_I TEST_EXPECT_len
when zero TEST_DIFF goto TEST_CHECK_DONE
set TEST_CHECK_A add SX_T TEST_CHECK_I
set TEST_CHECK_B add TEST_EXPECT TEST_CHECK_I
set TEST_CHECK_X peek TEST_CHECK_A 1
set TEST_CHECK_Y peek TEST_CHECK_B 1
set TEST_DIFF sub TEST_CHECK_X TEST_CHECK_Y
check zero TEST_DIFF
set TEST_CHECK_I add TEST_CHECK_I 1
goto TEST_CHECK_LOOP
label TEST_CHECK_DONE
return

label TEST_EMIT
text TEST_LENGTH int SX_T_len
text TEST_OUT join TEST_OUT TEST_LENGTH TEST_COLON
set TEST_HEX_LEN mul SX_T_len 2
set TEST_HEX_ALLOC add TEST_HEX_LEN 1
set TEST_HEX_BUF alloc TEST_HEX_ALLOC
set TEST_EMIT_I const 0
label TEST_EMIT_LOOP
set TEST_DIFF sub TEST_EMIT_I SX_T_len
when zero TEST_DIFF goto TEST_EMIT_DONE
set TEST_EMIT_ADDR add SX_T TEST_EMIT_I
set TEST_BYTE peek TEST_EMIT_ADDR 1
set TEST_BYTE band TEST_BYTE 255
set TEST_HIGH div TEST_BYTE 16
set TEST_LOW mod TEST_BYTE 16
set TEST_DIFF sub TEST_HIGH 10
when negative TEST_DIFF goto TEST_HIGH_DECIMAL
set TEST_HIGH add TEST_HIGH 87
goto TEST_HIGH_DONE
label TEST_HIGH_DECIMAL
set TEST_HIGH add TEST_HIGH 48
label TEST_HIGH_DONE
set TEST_DIFF sub TEST_LOW 10
when negative TEST_DIFF goto TEST_LOW_DECIMAL
set TEST_LOW add TEST_LOW 87
goto TEST_LOW_DONE
label TEST_LOW_DECIMAL
set TEST_LOW add TEST_LOW 48
label TEST_LOW_DONE
set TEST_HEX_POS mul TEST_EMIT_I 2
set TEST_HEX_ADDR add TEST_HEX_BUF TEST_HEX_POS
poke TEST_HEX_ADDR 1 TEST_HIGH
set TEST_HEX_ADDR add TEST_HEX_ADDR 1
poke TEST_HEX_ADDR 1 TEST_LOW
set TEST_EMIT_I add TEST_EMIT_I 1
goto TEST_EMIT_LOOP
label TEST_EMIT_DONE
set TEST_HEX_ADDR add TEST_HEX_BUF TEST_HEX_LEN
poke TEST_HEX_ADDR 1 0
set TEST_HEX_BUF_len const TEST_HEX_LEN
text TEST_HEX pad TEST_HEX_BUF TEST_HEX_LEN
text TEST_OUT join TEST_OUT TEST_HEX
return

label TEST_END
