#lang racket/base
(require json racket/cmdline racket/file racket/list racket/path racket/port racket/string racket/system
         "book-post-v3.rkt")

(define (hex bs) (apply string-append (for/list ([b bs]) (define s (number->string b 16)) (if (= (string-length s) 1) (string-append "0" s) s))))
(define (sha bs) (hex (sha256-bytes bs)))
(define (digest p) (call-with-input-file p (lambda (i) (hex (sha256-bytes i)))))
(define (need condition message) (unless condition (error 'verified-book-check "~a" message)))
(define (field row prefix) (for/first ([s row] #:when (string-prefix? s prefix)) (substring s (string-length prefix))))
(define (canon bs)
  (string->bytes/utf-8 (string-join (for/list ([t (string-split (bytes->string/latin-1 bs))])
    (if (regexp-match? #px"^[0-9]+$" t) (number->string (string->number t 10)) t)) " ")))
(define (read-chain path metadata-sha)
  (define head (make-string 64 #\0))
  (define rows
    (for/list ([line (file->lines path)])
      (define columns (string-split line "\t" #:trim? #f))
      (need (> (length columns) 1) "a ledger record has no chain field")
      (define body (drop-right columns 1))
      (define expected (sha (string->bytes/utf-8 (string-append head "\n" (string-join body "\t")))))
      (need (equal? expected (last columns)) (format "chain differs in ~a at ~a" path (car body)))
      (set! head expected)
      body))
  (need (and (pair? rows) (string-prefix? (caar rows) "H") (string-prefix? (car (last rows)) "E")) "ledger must start with H and end with E")
  (need (equal? (field (car rows) "run-metadata.json ") metadata-sha) "ledger metadata hash differs")
  (need (equal? (field (last rows) "records ") (number->string (sub1 (length rows)))) "ledger end record count differs")
  rows)

(define (local-file folder category recorded)
  (define name (file-name-from-path (string->path recorded)))
  (need name "recorded path has no filename")
  (define result (build-path folder category name))
  (need (file-exists? result) (format "recorded file missing: ~a" result))
  result)

(define (run command timeout)
  (define-values (sp out in err) (apply subprocess #f #f #f (car command) (cdr command)))
  (close-output-port in)
  (define stdout (open-output-bytes)) (define stderr (open-output-bytes))
  (define t1 (thread (lambda () (copy-port out stdout))))
  (define t2 (thread (lambda () (copy-port err stderr))))
  (define finished? (sync/timeout timeout sp))
  (unless finished? (subprocess-kill sp #t))
  (subprocess-wait sp) (thread-wait t1) (thread-wait t2)
  (close-input-port out) (close-input-port err)
  (define code (if finished? (subprocess-status sp) 124))
  (define answer (bytes->string/utf-8 (get-output-bytes stdout) #\?))
  (hasheq 'command (map path->string command) 'exit code 'stdout answer
          'stderr (bytes->string/utf-8 (get-output-bytes stderr) #\?)
          'verdict (cond [(and (= code 0) (regexp-match? #px"\\bACCEPT\\b" answer)) "ACCEPT"]
                         [(and (= code 1) (regexp-match? #px"\\bREJECT\\b" answer)) "REJECT"] [else "UNKNOWN"])))

(define (check-post bundle posting timeout)
  (define home (path->complete-path bundle)) (define folder (path->complete-path posting))
  (define meta-path (build-path folder "run-metadata.json"))
  (define meta (call-with-input-file meta-path read-json))
  (need (equal? (hash-ref meta 'schema #f) "verified-book-run-v1") "unknown posting metadata schema")
  (define book (read-chain (build-path folder "BOOK-1.0.ledger") (digest meta-path)))
  (define negative (read-chain (build-path folder "NEGATIVE-1.0.ledger") (digest meta-path)))
  (define f-rows (filter (lambda (r) (string-prefix? (car r) "F")) book))
  (define n-rows (filter (lambda (r) (string-prefix? (car r) "N")) negative))
  (define b-rows (filter (lambda (r) (string-prefix? (car r) "B")) book))
  (define native (build-path home "judge" "judge-v4-windows.exe"))
  (define pmp-command (if (file-exists? native) (list native) (list (build-path home "pompetzki.exe") (build-path home "judge" "judge-v4.pmp"))))
  (define racket-exe (build-path home "judge-rkt.exe"))
  (define rkt-command (if (file-exists? racket-exe) (list racket-exe)
                          (list (or (find-executable-path "racket") (error 'verified-book-check "racket executable missing")) (build-path home "judge" "judge-v4.rkt"))))
  (define seen-f (make-hash)) (define seen-n (make-hash)) (define checked-b 0)
  (define runs
    (for/list ([receipt (hash-ref meta 'runs)])
      (define input (local-file folder "judge-inputs" (hash-ref receipt 'snapshot)))
      (define input-sha (digest input))
      (need (and (hash-ref receipt 'unchanged #f) (equal? input-sha (hash-ref receipt 'input_sha256_before))
                 (equal? input-sha (hash-ref receipt 'input_sha256_after))) "snapshot input hash differs")
      (for ([name '(pmp racket)])
        (define old (hash-ref receipt name))
        (need (and (member (hash-ref old 'verdict) '("ACCEPT" "REJECT"))
                   (= (hash-ref old 'exit_code) (if (equal? (hash-ref old 'verdict) "ACCEPT") 0 1))) "stored verdict and exit code differ")
        (for ([kind '(stdout stderr)] [hash-key '(stdout_sha256 stderr_sha256)])
          (need (equal? (digest (local-file folder "judge-runs" (hash-ref old kind))) (hash-ref old hash-key)) "recorded judge output hash differs")))
      (define fresh-pmp (run (append pmp-command (list input)) timeout))
      (define fresh-rkt (run (append rkt-command (list input)) timeout))
      (need (equal? input-sha (digest input)) "snapshot changed during verification")
      (define verdict (hash-ref fresh-pmp 'verdict))
      (need (and (member verdict '("ACCEPT" "REJECT")) (equal? verdict (hash-ref fresh-rkt 'verdict))) "gated judges disagree or did not complete")
      (for ([name '(pmp racket)] [fresh (list fresh-pmp fresh-rkt)])
        (need (equal? (hash-ref (hash-ref receipt name) 'verdict) (hash-ref fresh 'verdict)) "rerun differs from the stored verdict"))
      (define matching (filter (lambda (r) (equal? (field r "sha256 ") input-sha)) (if (equal? verdict "ACCEPT") f-rows n-rows)))
      (define seen (if (equal? verdict "ACCEPT") seen-f seen-n))
      (define used (hash-ref seen input-sha 0))
      (need (< used (length matching)) "judge run has no corresponding ledger record")
      (hash-set! seen input-sha (add1 used))
      (when (equal? verdict "ACCEPT")
        (define f (list-ref matching used))
        (define fid (car f))
        (define bs (file->bytes input))
        (define-values (n0 registry authenticated? theorem-count step-count theorems) (inspect-jdg bs))
        (need authenticated? "ledger input registry is not authenticated")
        (need (and (equal? (field f "theorems ") (number->string theorem-count))
                   (equal? (field f "steps ") (number->string step-count))) "file record counts differ from checked JDG")
        (define postings (filter (lambda (r) (equal? (cadr r) fid)) b-rows))
        (need (= (length postings) theorem-count) "theorem posting count differs from checked JDG")
        (for ([row postings] [theorem theorems])
          (define-values (j start statement-end proof-end steps cites trace hyps) (apply values theorem))
          (need (and (equal? (field row "stmt ") (sha (canon (subbytes bs start statement-end))))
                     (equal? (field row "drv ") (sha (canon (subbytes bs start proof-end))))
                     (equal? (field row "steps ") (number->string steps))
                     (equal? (list-ref row 4) (if (null? hyps) "Proved" "Qualified"))) "theorem posting differs from its checked derivation"))
        (set! checked-b (+ checked-b theorem-count)))
      (hasheq 'input (path->string input) 'sha256 input-sha 'verdict verdict 'pmp fresh-pmp 'racket fresh-rkt)))
  (need (and (= (apply + 0 (hash-values seen-f)) (length f-rows))
             (= (apply + 0 (hash-values seen-n)) (length n-rows)) (= checked-b (length b-rows))) "ledger includes postings without a checked input")
  (hasheq 'status "CHECK OK" 'files (length runs) 'positive_files (length f-rows) 'theorems checked-b 'negative_files (length n-rows)
          'metadata_sha256 (digest meta-path) 'reruns runs))

(module+ main
  (define bundle #f) (define timeout 300)
  (define posting
    (command-line #:program "verified-book-check" #:once-each
      [("--bundle") directory "Installed mathematics bundle" (set! bundle directory)]
      [("--timeout") seconds "Seconds per judge" (define n (string->number seconds))
       (unless (and (exact-positive-integer? n) (<= n 3600)) (error 'verified-book-check "invalid timeout")) (set! timeout n)]
      #:args (posting) posting))
  (unless bundle (error 'verified-book-check "--bundle is required"))
  (with-handlers ([exn:fail? (lambda (e) (eprintf "CHECK FAILED: ~a\n" (exn-message e)) (exit 1))])
    (write-json (check-post bundle posting timeout)) (newline)))
