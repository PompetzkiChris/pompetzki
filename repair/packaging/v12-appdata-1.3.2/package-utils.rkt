#lang racket/base
(require racket/file racket/list racket/path racket/port racket/string racket/system json
         ffi/unsafe)
(provide version bundle-root sha256-file safe-path read-manifest verify-manifest run-process
         validate-new-target write-json-new read-json-file reparse? new-record powershell-path runtime-modules windows-programs-path windows-local-appdata-path)
(define version "1.3.2")
(define (runtime-modules)
  (define handle (get-ffi-obj "GetModuleHandleW" (ffi-lib "kernel32") (_fun _string/utf-16 -> _pointer)))
  (define filename (get-ffi-obj "GetModuleFileNameW" (ffi-lib "kernel32") (_fun _pointer _bytes _uint32 -> _uint32)))
  (define exe (or (find-executable-path (find-system-path 'exec-file)) (find-system-path 'exec-file)))
  (define folder (path-only (path->complete-path exe)))
  (define candidates (remove-duplicates
    (for*/list ([base (list folder (build-path folder 'up))]
                #:when (directory-exists? (build-path base "lib"))
                [file (in-directory (build-path base "lib"))]
                #:when (and (file-exists? file) (regexp-match? #px"(?i:.*\\.dll)$" (path->string (file-name-from-path file)))))
      (path->string (file-name-from-path file)))))
  (for/list ([name candidates] #:when (handle name))
    (define buffer (make-bytes 65536))
    (unless (positive? (filename (handle name) buffer 32768)) (error 'runtime "loaded DLL path lookup failed: ~a" name))
    (hasheq 'module name 'path (cast buffer _bytes _string/utf-16))))
(define (powershell-path)
  (or (find-executable-path "powershell.exe")
      (let ([windows (getenv "SystemRoot")])
        (and windows
             (let ([program (build-path windows "System32" "WindowsPowerShell" "v1.0" "powershell.exe")])
               (and (file-exists? program) program))))
      (error 'Abschluss "Windows PowerShell executable was not found")))
(define (windows-known-folder csidl)
  (unless (eq? (system-type) 'windows) (error 'install "Windows folder resolution requires Windows"))
  (define lookup (get-ffi-obj "SHGetFolderPathW" (ffi-lib "shell32")
                            (_fun _pointer _int _pointer _uint32 _bytes -> _int32)))
  (define buffer (make-bytes 65536))
  (define result (lookup #f csidl #f 0 buffer))
  (unless (zero? result) (error 'install "Windows folder lookup failed: ~a" result))
  (define text (cast buffer _bytes _string/utf-16))
  (unless (and text (not (string=? (string-trim text) "")))
    (error 'install "Windows folder lookup returned an empty path"))
  (simplify-path (string->path text) #f))
(define (environment-folder name)
  (define text (getenv name))
  (and text (not (string=? (string-trim text) ""))
       (let ([path (string->path text)])
         (define (separator? c) (or (char=? c #\\) (char=? c #\/)))
         (define size (string-length text))
         (define drive-relative?
           (and (>= size 2) (char=? (string-ref text 1) #\:)
                (or (= size 2) (not (separator? (string-ref text 2))))))
         (define root-relative?
           (and (positive? size) (separator? (string-ref text 0))
                (or (= size 1) (not (separator? (string-ref text 1))))))
         (unless (and (complete-path? path) (not drive-relative?) (not root-relative?))
           (error 'install "~a must name a complete Windows path" name))
         (simplify-path path #f))))
(define (windows-programs-path)
  (define roaming (environment-folder "APPDATA"))
  (if roaming (build-path roaming "Microsoft" "Windows" "Start Menu" "Programs")
      (windows-known-folder 2)))
(define (windows-local-appdata-path)
  (or (environment-folder "LOCALAPPDATA") (windows-known-folder 28)))
(define (hex bytes)
  (apply string-append (for/list ([b (in-bytes bytes)])
    (define s (number->string b 16)) (if (= 1 (string-length s)) (string-append "0" s) s))))
(define (sha256-file path) (call-with-input-file path (lambda (in) (hex (sha256-bytes in)))))
(define (read-json-file path) (call-with-input-file path read-json))
(define (write-json-new path value)
  (call-with-output-file path #:exists 'error (lambda (out) (write-json value out) (newline out))))
(define (bundle-root [explicit #f])
  (define exe (or (find-executable-path (find-system-path 'exec-file)) (find-system-path 'exec-file)))
  (define folder (path-only (path->complete-path exe)))
  (define candidates (if explicit (list (path->complete-path explicit)) (list folder (build-path folder 'up))))
  (or (for/first ([candidate candidates]
                  #:when (and (file-exists? (build-path candidate "VERSION"))
                              (equal? (string-trim (file->string (build-path candidate "VERSION"))) version)))
        (simplify-path candidate))
      (error 'Abschluss "VERSION ~a is required beside the launcher or its bin folder" version)))
(define (safe-path root relative)
  (define p (string->path relative))
  (unless (and (relative-path? p)
               (not (regexp-match? #px"^[A-Za-z]:" relative))
               (not (regexp-match? #px"^[\\\\/]" relative))
               (for/and ([part (explode-path p)])
                 (and (path? part) (not (member (path->string part) '("." ".."))))))
    (error 'manifest "unsafe relative file name: ~a" relative))
  (build-path root p))
(define attributes
  (and (eq? (system-type) 'windows)
       (get-ffi-obj "GetFileAttributesW" (ffi-lib "kernel32") (_fun _string/utf-16 -> _uint32))))
(define (reparse? path)
  (or (link-exists? path)
      (and attributes
           (let ([value (attributes (path->string path))])
             (and (not (= value #xffffffff)) (not (zero? (bitwise-and value #x400))))))))
(define (read-manifest root)
  (define seen (make-hash))
  (for/list ([line (in-list (file->lines (build-path root "MANIFEST.sha256")))]
             #:unless (string=? (string-trim line) ""))
    (define match (regexp-match #px"^([0-9a-fA-F]{64})  (.+)$" line))
    (unless match (error 'manifest "malformed manifest line: ~a" line))
    (define name (caddr match))
    (safe-path root name)
    (define canonical (string-downcase name))
    (when (hash-ref seen canonical #f) (error 'manifest "duplicate manifest file: ~a" name))
    (hash-set! seen canonical #t)
    (hasheq 'path name 'sha256 (string-downcase (cadr match)))))
(define (verify-manifest root)
  (for/list ([row (in-list (read-manifest root))])
    (define file (safe-path root (hash-ref row 'path)))
    (define actual (and (file-exists? file) (not (reparse? file)) (sha256-file file)))
    (hasheq 'path (hash-ref row 'path) 'expected (hash-ref row 'sha256) 'actual (or actual "MISSING_OR_LINK")
            'match (equal? actual (hash-ref row 'sha256)))))
(define (run-process command root [timeout 300])
  (define started (current-inexact-milliseconds))
  (define-values (process stdout stdin stderr)
    (parameterize ([current-directory root])
      (apply subprocess #f #f #f (car command) (cdr command))))
  (close-output-port stdin)
  (define out (open-output-bytes)) (define err (open-output-bytes))
  (define out-thread (thread (lambda () (copy-port stdout out))))
  (define err-thread (thread (lambda () (copy-port stderr err))))
  (define done (sync/timeout timeout process))
  (unless done (subprocess-kill process #t))
  (subprocess-wait process) (thread-wait out-thread) (thread-wait err-thread)
  (close-input-port stdout) (close-input-port stderr)
  (hasheq 'command (map (lambda (x) (if (path? x) (path->string x) x)) command)
          'exit (if done (subprocess-status process) 124)
          'milliseconds (inexact->exact (round (- (current-inexact-milliseconds) started)))
          'stdout (bytes->string/utf-8 (get-output-bytes out) #\?)
          'stderr (bytes->string/utf-8 (get-output-bytes err) #\?)))
(define (validate-new-target source target)
  (define p (simplify-path (path->complete-path target)))
  (when (or (file-exists? p) (directory-exists? p) (link-exists? p))
    (error 'install "installation folder already exists: ~a" p))
  (define-values (parent name directory?) (split-path p))
  (unless (and (path? parent) (path? name) (directory-exists? parent))
    (error 'install "choose a new folder inside an existing local directory: ~a" p))
  (when (or (equal? p (simplify-path source))
            (for/or ([ancestor (in-list (let loop ([x parent] [items '()])
                                         (define-values (up n d?) (split-path x))
                                         (if (path? up) (loop up (cons x items)) (cons x items))))])
              (reparse? ancestor)))
    (error 'install "installation through a link or reparse directory is refused: ~a" p))
  p)
(define (new-record source rows)
  (hasheq 'schema "Abschluss-installation-v1" 'version version
          'manifest_sha256 (sha256-file (build-path source "MANIFEST.sha256"))
          'files (append rows (list (hasheq 'path "MANIFEST.sha256" 'sha256 (sha256-file (build-path source "MANIFEST.sha256")))))))
