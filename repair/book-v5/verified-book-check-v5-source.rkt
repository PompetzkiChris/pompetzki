#lang racket/base
;; Version 5: rejudge the mathematics and reconstruct its recorded evidence.
;; Project code uses the accompanying MIT license.
(require json racket/bytes racket/cmdline racket/file racket/list racket/path racket/port racket/string racket/system
         "book-post-v4.rkt")
(define (hex bs) (apply string-append (for/list ([b bs]) (define s (number->string b 16)) (if (= (string-length s) 1) (string-append "0" s) s))))
(define (sha bs) (hex (sha256-bytes bs)))
(define (digest p) (call-with-input-file p (lambda (i) (hex (sha256-bytes i)))))
(define (need c message) (unless c (error 'verified-book-check "~a" message)))
(define (hex64? s) (and (string? s) (regexp-match? #px"^[0-9a-f]{64}$" s)))
(define (clean s) (string-trim (regexp-replace* #px"[\t\r\n]+" s " / ")))
(define (portable-name s) (last (string-split (string-replace s "\\" "/") "/")))
(define (key s) (if (eq? (system-type) 'windows) (string-downcase (portable-name s)) (portable-name s)))
(define (parent-text s) (regexp-replace #px"[/\\\\][^/\\\\]+$" s ""))
(define (field row prefix)
  (define matches (filter (lambda (s) (string-prefix? s prefix)) row))
  (need (= (length matches) 1) (format "field ~a is missing or duplicated" prefix))
  (substring (car matches) (string-length prefix)))
(define (pad n w) (define s (number->string n)) (string-append (make-string (max 0 (- w (string-length s))) #\0) s))
(define (canon bs) (string->bytes/utf-8 (string-join (for/list ([t (string-split (bytes->string/latin-1 bs))]) (if (regexp-match? #px"^[0-9]+$" t) (number->string (string->number t 10)) t)) " ")))
(define (classify text code)
  (define a (regexp-match? #px"\\bACCEPT\\b" text)) (define r (regexp-match? #px"\\bREJECT\\b" text))
  (cond [(and (equal? code 0) a (not r)) "ACCEPT"] [(and (equal? code 1) r (not a)) "REJECT"] [else "UNKNOWN"]))
(define (read-chain path metadata-sha date name)
  (define head (make-string 64 #\0))
  (define rows (for/list ([line (file->lines path)])
    (define c (string-split line "\t" #:trim? #f)) (need (> (length c) 1) "ledger record lacks a chain")
    (define body (drop-right c 1)) (define expected (sha (string->bytes/utf-8 (string-append head "\n" (string-join body "\t")))))
    (need (equal? expected (last c)) "ledger chain differs") (set! head expected) body))
  (need (>= (length rows) 2) "ledger lacks header or end record")
  (define h (car rows)) (define e (last rows))
  (need (and (= (length h) 7) (= (length e) 9) (equal? (car h) "H000001") (equal? (car e) "E000001")) "ledger header/end shape differs")
  (need (and (equal? (cadr h) (string-append "segment " name)) (equal? (cadr e) (cadr h))
             (equal? (list-ref h 2) "previous - -") (equal? (list-ref h 3) (string-append "opened " date))
             (equal? (field h "run-metadata.json ") metadata-sha) (equal? (list-ref e 2) (format "records ~a" (sub1 (length rows))))
             (equal? (last e) (string-append "closed " date))) "ledger header/end metadata differs")
  (need (or (equal? (field h "book-post-v4.rkt ") "embedded-in-executable") (hex64? (field h "book-post-v4.rkt "))) "poster source hash shape differs")
  (need (hex64? (field h "process-image ")) "poster process hash shape differs")
  rows)
(define (local-file folder category recorded)
  (need (and (string? recorded) (positive? (string-length recorded))) "recorded path is empty")
  (define name (portable-name recorded)) (need (not (member name '("." ".."))) "invalid recorded basename")
  (define result (build-path folder category name)) (need (file-exists? result) (format "recorded file missing: ~a" name)) result)
(define (run command timeout)
  (define-values (sp out in err) (parameterize ([subprocess-group-enabled (not (eq? (system-type) 'windows))]) (apply subprocess #f #f #f (car command) (cdr command))))
  (close-output-port in) (define ob (open-output-bytes)) (define eb (open-output-bytes))
  (define t1 (thread (lambda () (copy-port out ob)))) (define t2 (thread (lambda () (copy-port err eb))))
  (define finished? (sync/timeout timeout sp)) (unless finished? (subprocess-kill sp #t)) (subprocess-wait sp)
  (define drained? (and (sync/timeout 5 (thread-dead-evt t1)) (sync/timeout 5 (thread-dead-evt t2)) #t))
  (unless drained? (kill-thread t1) (kill-thread t2)) (close-input-port out) (close-input-port err)
  (define code (cond [(not finished?) 124] [(not drained?) 125] [else (subprocess-status sp)]))
  (define text (bytes->string/utf-8 (bytes-append (get-output-bytes ob) (get-output-bytes eb)) #\?))
  (hasheq 'command (map path->string command) 'exit code 'stdout text 'verdict (classify text code)))
(define AXN '#("Ext" "Pair" "Union" "Power" "Inf" "Found" "Choice"))
(define (ranges bits lo hi)
  (define rs (let loop ([i lo] [start #f] [acc '()])
    (cond [(>= i hi) (reverse (if start (cons (cons start (sub1 i)) acc) acc))]
          [(bitwise-bit-set? bits i) (loop (add1 i) (or start i) acc)]
          [start (loop (add1 i) #f (cons (cons start (sub1 i)) acc))] [else (loop (add1 i) #f acc)])))
  (string-join (for/list ([r rs]) (if (= (car r) (cdr r)) (number->string (car r)) (format "~a-~a" (car r) (cdr r)))) ","))
(define (trace-fields bits n0)
  (define axs (for/list ([i (in-range (min 7 n0))] #:when (bitwise-bit-set? bits i)) (vector-ref AXN i)))
  (define dhi (min 677 n0)) (define dc (for/sum ([i (in-range 7 dhi)]) (if (bitwise-bit-set? bits i) 1 0)))
  (define hc (for/sum ([i (in-range 677 n0)]) (if (bitwise-bit-set? bits i) 1 0)))
  (list (if (null? axs) "ax -" (string-append "ax " (string-join axs " "))) (if (= dc 0) "def 0 -" (format "def ~a ~a" dc (ranges bits 7 dhi))) (if (= hc 0) "hypent -" (string-append "hypent " (ranges bits 677 n0)))))
(define RECEIPT-HEADER "path\tpmp\tracket\treceipt\tsha256\tpmp_exit\tpmp_start\tpmp_end\tpmp_ms\tpmp_out\trkt_exit\trkt_start\trkt_end\trkt_ms\trkt_out")
(define (check-post bundle posting timeout)
  (define home (path->complete-path bundle)) (define folder (path->complete-path posting))
  (define meta-path (build-path folder "run-metadata.json")) (define meta (call-with-input-file meta-path read-json))
  (need (and (equal? (hash-ref meta 'schema #f) "verified-book-run-v1") (equal? (hash-ref meta 'time_unit #f) "milliseconds since Unix epoch")) "posting metadata schema/time unit differs")
  (define date (hash-ref meta 'posting_date)) (need (string? date) "posting date is not text")
  (need (and (exact-positive-integer? (hash-ref meta 'timeout_seconds)) (<= (hash-ref meta 'timeout_seconds) 3600)) "metadata timeout is not a bounded exact integer")
  (define version (if (file-exists? (build-path home "judge" "judge-v5.pmp")) "v5" "v4"))
  (define pmp-src (build-path home "judge" (string-append "judge-" version ".pmp")))
  (define native (build-path home "judge" (string-append "judge-" version "-windows.exe")))
  (define pmp-command (if (file-exists? native) (list native) (list (build-path home "pompetzki.exe") pmp-src)))
  (define racket-exe (build-path home "judge-rkt.exe"))
  (define rkt-source (build-path home "judge" (string-append "judge-" version ".rkt")))
  (define rkt-command (if (file-exists? racket-exe) (list racket-exe) (list (or (find-executable-path "racket") (error 'verified-book-check "Racket executable missing")) rkt-source)))
  (define run-list (hash-ref meta 'runs)) (need (and (list? run-list) (pair? run-list)) "metadata runs must be a nonempty list")
  (define first-pmp-command (hash-ref (hash-ref (car run-list) 'pmp) 'command))
  (need (and (list? first-pmp-command) (pair? first-pmp-command)) "stored pmp command is missing")
  (define recorded-pmp-command
    (if (equal? (key (car first-pmp-command)) (key (path->string (build-path home "pompetzki.exe"))))
        (list (build-path home "pompetzki.exe") pmp-src) pmp-command))
  (define artifacts (append (list (car recorded-pmp-command) pmp-src (build-path home "judge" "registry-auth-v4.rkt")) rkt-command))
  (define artifact-map (make-hash))
  (for ([p artifacts]) (need (file-exists? p) "selected judge artifact missing") (hash-set! artifact-map (key (path->string p)) p))
  (define recorded-artifacts (hash-ref meta 'artifacts)) (define artifact-seen (make-hash))
  (for ([a recorded-artifacts])
    (define k (key (hash-ref a 'path))) (need (and (hash-has-key? artifact-map k) (not (hash-has-key? artifact-seen k))) "unknown or duplicate metadata artifact")
    (need (equal? (hash-ref a 'sha256) (digest (hash-ref artifact-map k))) "metadata artifact hash differs from the selected bundle tool") (hash-set! artifact-seen k #t))
  (need (= (hash-count artifact-seen) (hash-count artifact-map)) "metadata does not bind every selected judge artifact")
  (define book (read-chain (build-path folder "BOOK-1.0.ledger") (digest meta-path) date "BOOK-1.0.ledger"))
  (define negative (read-chain (build-path folder "NEGATIVE-1.0.ledger") (digest meta-path) date "NEGATIVE-1.0.ledger"))
  (define fs (make-hash)) (define ns (make-hash)) (define b-groups (make-hash)) (define nf 0) (define nb 0) (define nn 0) (define current-f #f)
  (for ([r (drop-right (cdr book) 1)])
    (cond [(regexp-match? #px"^F" (car r))
           (set! nf (add1 nf)) (need (and (= (length r) 18) (equal? (car r) (string-append "F" (pad nf 6)))) "F record shape/ordered ID differs")
           (set! current-f (car r)) (define k (key (field r "file "))) (need (not (hash-has-key? fs k)) "duplicate F input identity") (hash-set! fs k r) (hash-set! b-groups current-f '())]
          [(regexp-match? #px"^B" (car r))
           (set! nb (add1 nb)) (need (and current-f (= (length r) 19) (equal? (car r) (string-append "B" (pad nb 7))) (equal? (cadr r) current-f)) "B record shape/ordered ID/F link differs")
           (hash-set! b-groups current-f (cons r (hash-ref b-groups current-f)))]
          [else (error 'verified-book-check "unexpected Book record")]))
  (for ([r (drop-right (cdr negative) 1)])
    (set! nn (add1 nn)) (need (and (= (length r) 11) (equal? (car r) (string-append "N" (pad nn 6))) (equal? (cadr r) "Rejected")) "N record shape/ordered ID differs")
    (define k (key (field r "file "))) (need (and (not (hash-has-key? ns k)) (not (hash-has-key? fs k))) "duplicate positive/negative input identity") (hash-set! ns k r))
  (define (span prefix count width) (if (= count 0) (string-append prefix " -") (string-append prefix (pad 1 width) "-" prefix (pad count width))))
  (need (equal? (take (drop (last book) 3) 5) (list (span "F" nf 6) (span "B" nb 7) "N -" "S -" "C -")) "Book end ranges differ")
  (need (equal? (take (drop (last negative) 3) 5) (list "F -" "B -" (span "N" nn 6) "S -" "C -")) "negative end ranges differ")
  (define receipt-lines (file->lines (build-path folder "RECEIPTS.tsv"))) (need (and (pair? receipt-lines) (equal? (car receipt-lines) RECEIPT-HEADER)) "RECEIPTS header differs")
  (define receipt-map (make-hash))
  (for ([line (cdr receipt-lines)]) (define c (string-split line "\t" #:trim? #f)) (need (= (length c) 15) "RECEIPTS column count differs")
    (define k (key (car c))) (need (not (hash-has-key? receipt-map k)) "duplicate RECEIPTS input identity") (hash-set! receipt-map k c))
  (define seen-inputs (make-hash)) (define previous-end 0) (define first-statements (make-hash)) (define checked-b 0)
  (define reruns (for/list ([receipt run-list])
    (define k (key (hash-ref receipt 'snapshot))) (need (not (hash-has-key? seen-inputs k)) "duplicate metadata input identity") (hash-set! seen-inputs k #t)
    (need (hash-has-key? receipt-map k) "metadata input lacks a RECEIPTS row") (define c (hash-ref receipt-map k))
    (define input (local-file folder "judge-inputs" (hash-ref receipt 'snapshot))) (define input-sha (digest input))
    (need (and (eq? (hash-ref receipt 'unchanged #f) #t) (equal? input-sha (hash-ref receipt 'input_sha256_before)) (equal? input-sha (hash-ref receipt 'input_sha256_after)) (equal? input-sha (list-ref c 4))) "snapshot hashes or unchanged state differ")
    (need (equal? (key (list-ref c 3)) "judge-runs") "receipt directory differs")
    (define stored-texts (for/list ([name '(pmp racket)] [command (list recorded-pmp-command rkt-command)] [offset '(5 10)])
      (define old (hash-ref receipt name)) (define word (hash-ref old 'verdict)) (define code (hash-ref old 'exit_code))
      (need (and (member word '("ACCEPT" "REJECT")) (exact-integer? code) (= code (if (equal? word "ACCEPT") 0 1))) "stored verdict/exit code differs")
      (define begin (hash-ref old 'start_epoch_ms)) (define end (hash-ref old 'end_epoch_ms))
      (need (and (exact-nonnegative-integer? begin) (exact-nonnegative-integer? end) (<= previous-end begin end)) "metadata timestamps are inexact, negative or unordered") (set! previous-end end)
      (define recorded-command (hash-ref old 'command))
      (need (and (list? recorded-command) (= (length recorded-command) (add1 (length command))) (equal? (map key recorded-command) (append (map (lambda (p) (key (path->string p))) command) (list k)))) "recorded judge command differs from selected bundle tools/input")
      (define text (bytes->string/utf-8 (apply bytes-append (for/list ([kind '(stdout stderr)] [hash-key '(stdout_sha256 stderr_sha256)])
        (define path (local-file folder "judge-runs" (hash-ref old kind))) (need (equal? (digest path) (hash-ref old hash-key)) "stored output hash differs") (file->bytes path))) #\?))
      (need (equal? (classify text code) word) "stored judge output is ambiguous or contradicts its verdict")
      (need (and (equal? (list-ref c (if (eq? name 'pmp) 1 2)) word) (equal? (take (drop c offset) 5) (list (number->string code) (number->string begin) (number->string end) (number->string (- end begin)) (clean text)))) "RECEIPTS row differs from exact metadata/logs") text))
    (define fresh-pmp (run (append pmp-command (list input)) timeout)) (define fresh-rkt (run (append rkt-command (list input)) timeout))
    (need (equal? input-sha (digest input)) "snapshot changed during verification")
    (define verdict (hash-ref fresh-pmp 'verdict))
    (need (and (member verdict '("ACCEPT" "REJECT")) (equal? verdict (hash-ref fresh-rkt 'verdict))) "gated judges disagree or did not complete")
    (for ([name '(pmp racket)]) (need (equal? verdict (hash-ref (hash-ref receipt name) 'verdict)) "rerun differs from stored verdict"))
    (define accepted? (equal? verdict "ACCEPT")) (define records (if accepted? fs ns))
    (need (hash-has-key? records k) "judge run has no corresponding F/N record") (define r (hash-ref records k))
    (need (and (equal? (field r "sha256 ") input-sha) (equal? (field r "bytes ") (number->string (file-size input))) (equal? (field r "source ") (parent-text (field r "file "))) (equal? (field r "verdicts ") "RECEIPTS.tsv") (equal? (field r "posted ") date)) "F/N input identity, bytes, source or date differs")
    (for ([name '(pmp racket)] [text stored-texts])
      (define old (hash-ref receipt name))
      (define expected (format "~a exit ~a ~a - ~a ~a ms~a" verdict (hash-ref old 'exit_code) (hash-ref old 'start_epoch_ms) (hash-ref old 'end_epoch_ms) (- (hash-ref old 'end_epoch_ms) (hash-ref old 'start_epoch_ms)) (if accepted? "" (string-append " " (clean text)))))
      (need (equal? (field r (string-append (symbol->string name) " ")) expected) "F/N recorded judge evidence differs"))
    (when accepted?
      (define bs (file->bytes input)) (define-values (n0 reghex authenticated? theorem-count step-count theorems) (inspect-jdg bs))
      (need authenticated? "input registry is not authenticated")
      (define postings (reverse (hash-ref b-groups (car r)))) (need (= (length postings) theorem-count) "theorem posting count differs")
      (define first-b (if (null? postings) (add1 checked-b) (string->number (substring (caar postings) 1))))
      (define union (for/fold ([u 0]) ([t theorems]) (bitwise-ior u (list-ref t 6))))
      (define stmts (sha (apply bytes-append (for/list ([t theorems]) (bytes-append (canon (subbytes bs (list-ref t 1) (list-ref t 2))) #"\n")))))
      (need (and (equal? (field r "registry ") (format "~a prefix ~a" n0 reghex)) (equal? (field r "theorems ") (number->string theorem-count)) (equal? (field r "steps ") (number->string step-count)) (equal? (field r "stmt ") stmts) (equal? (field r "postings ") (format "B~a-B~a" (pad first-b 7) (pad (+ first-b theorem-count -1) 7))) (equal? (take (drop r 13) 3) (trace-fields union n0))) "F mathematical counts, registry, statement aggregate or trace differs")
      (for ([row postings] [theorem theorems])
        (define-values (j start statement-end proof-end steps cites trace hyps) (apply values theorem))
        (define st (sha (canon (subbytes bs start statement-end)))) (define first (hash-ref first-statements st #f))
        (define expected (append (list (car row) (car r) (format "thm ~a" j) (format "entry ~a" (+ n0 j)) (if (null? hyps) "Proved" "Qualified") (string-append "stmt " st) (string-append "drv " (sha (canon (subbytes bs start proof-end)))) (format "steps ~a" steps) (if (null? hyps) "hyps -" (string-append "hyps " (string-join (map number->string hyps) ","))) (if first (string-append "first " first) "first -") (if (null? cites) "cites -" (string-append "cites " (string-join (for/list ([u cites]) (if (< u n0) (format "R~a" u) (format "B~a" (pad (+ first-b (- u n0)) 7)))) " ")))) (trace-fields trace n0) (list (string-append "file " input-sha) (string-append "registry " reghex) (string-append "source " (field r "source ")) (format "pmp ACCEPT ~a" (hash-ref (hash-ref receipt 'pmp) 'end_epoch_ms)) (format "racket ACCEPT ~a" (hash-ref (hash-ref receipt 'racket) 'end_epoch_ms)))))
        (need (equal? row expected) "B record differs from the complete checked theorem evidence")
        (unless first (hash-set! first-statements st (car row))))
      (set! checked-b (+ checked-b theorem-count)))
    (hasheq 'input (path->string input) 'sha256 input-sha 'verdict verdict 'pmp fresh-pmp 'racket fresh-rkt)))
  (need (and (= (hash-count seen-inputs) (hash-count receipt-map)) (= (hash-count seen-inputs) (+ nf nn)) (= checked-b nb)) "input/receipt/ledger counts differ")
  (define snapshot-names (for/list ([p (in-directory (build-path folder "judge-inputs"))] #:when (file-exists? p)) (key (path->string p))))
  (need (and (= (length snapshot-names) (hash-count seen-inputs)) (andmap (lambda (k) (hash-has-key? seen-inputs k)) snapshot-names)) "snapshot directory contains unrecorded or duplicate inputs")
  (for ([a recorded-artifacts]) (need (equal? (hash-ref a 'sha256) (digest (hash-ref artifact-map (key (hash-ref a 'path))))) "selected judge artifact changed during verification"))
  (hasheq 'status "CHECK OK" 'evidence_schema "verified-book-v5" 'files (length reruns) 'positive_files nf 'theorems checked-b 'negative_files nn 'metadata_sha256 (digest meta-path) 'reruns reruns))
(module+ main
  (define bundle #f) (define timeout 300)
  (define posting (command-line #:program "verified-book-check" #:once-each [("--bundle") d "Installed mathematics bundle" (set! bundle d)] [("--timeout") s "Seconds per judge" (define n (string->number s)) (unless (and (exact-positive-integer? n) (<= n 3600)) (error 'verified-book-check "invalid timeout")) (set! timeout n)] #:args (posting) posting))
  (unless bundle (error 'verified-book-check "--bundle is required"))
  (with-handlers ([exn:fail? (lambda (e) (eprintf "CHECK FAILED: ~a\n" (exn-message e)) (exit 1))]) (write-json (check-post bundle posting timeout)) (newline)))
