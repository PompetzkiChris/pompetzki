#lang racket/base
;; eq-v1.rkt -- lane L7, item 1: first-order equality reasoning as an untrusted emitter of JDG1 derivations.
;;  (a) equality chains x0 ~ x1 ~ ... ~ xn (each link in either orientation)  =>  x0 = xn, by Leibniz steps;
;;  (b) congruence closure over the registered symbols that are functional relations (Suc, Sng, Upr, Opr, Emp, App under
;;      Fnc): union-find with a proof line H -> v = rep(v) for every variable, merges justified by Leibniz rewriting and
;;      the replay's uniqueness and injectivity lemmas (SucUq, SngUq, UprUq, OprUq, EmpUq, Kur1, Kur2, SucInj, FncApp);
;;      goals: an equation, or any atom P(...) / x in y congruent to a hypothesis atom.
;; A statement is (h1 & ... & hk) -> goal over the free variables 0..V-1.
(require "l7core-v1.rkt" "omega-base-v1.rkt" racket/list racket/match)
(provide (all-defined-out))

;; ---- atoms (DSL): (eq a b) (in a b) (pr NAME a ...)
(define (asym A) (match A [(list 'pr s _ ...) s] [(list s _ _) s]))
(define (aargs A) (match A [(list 'pr _ as ...) as] [(list _ a b) (list a b)]))
(define (mk sym args) (case sym [(eq in) (cons sym args)] [else (list* 'pr sym args)]))
(define (conj hs) (if (= (length hs) 1) (car hs) (cons 'and hs)))

;; functional symbols: output = argument 0; the uniqueness lemma takes (a b . inputs)
(define FUNS (hash 'Suc "L:SucUq" 'Sng "Z:SngUq" 'Upr "Z:UprUq" 'Opr "L:OprUq" 'Emp "L:EmpUq"))

;; ======================================================================== (a) chains
;; orient: list of booleans, #t: x(i-1) = x(i), #f: x(i) = x(i-1)
(define (chain-hyps orient) (for/list ([o orient] [i (in-naturals 1)]) (if o `(eq ,(sub1 i) ,i) `(eq ,i ,(sub1 i)))))
(define (chain-thm! key orient)
  (define n (length orient))
  (lemma! key (add1 n)
    (lambda ()
      (define Hc (c (conj (chain-hyps orient))))
      (for/fold ([l (T (list (Y (Eqv 0 0))) (Imp Hc (Eqv 0 0)))]) ([o orient] [i (in-naturals 1)])
        (define link (if o (leib `(eq 0 ,HOLE) (sub1 i) i) (leib `(not (eq 0 ,HOLE)) i (sub1 i))))
        (T (list l link) (Imp Hc (Eqv 0 i)))))))
;; the whole chain in one tautology step (for the cost comparison only)
(define (chain-one-step-cost orient)
  (define n (length orient))
  (define Hc (c (conj (chain-hyps orient))))
  (define links (for/list ([o orient] [i (in-naturals 1)])
                  (if o (Imp (Eqv (sub1 i) i) (Imp (Eqv 0 (sub1 i)) (Eqv 0 i))) (Imp (Eqv i (sub1 i)) (Imp (Neg (Eqv 0 i)) (Neg (Eqv 0 (sub1 i))))))))
  (define ok (tautchk2 (foldr Imp (Imp Hc (Eqv 0 n)) (cons (Eqv 0 0) links))))
  (list ok taut-calls))

;; ======================================================================== (b) congruence closure, pure (for choosing goals)
(define (pure-closure V hyps)
  (define parent (make-vector V #f))
  (for ([i V]) (vector-set! parent i i))
  (define (find x) (if (= (vector-ref parent x) x) x (let ([r (find (vector-ref parent x))]) (vector-set! parent x r) r)))
  (define (same? a b) (= (find a) (find b)))
  (define (union! a b) (unless (same? a b) (vector-set! parent (find a) (find b)) #t))
  (let loop ()
    (define changed #f)
    (define (u! a b) (when (and (not (same? a b)) (union! a b)) (set! changed #t)))
    (for ([A hyps]) (when (eq? (asym A) 'eq) (u! (car (aargs A)) (cadr (aargs A)))))
    (for* ([A1 hyps] [A2 hyps])
      (define s (asym A1))
      (when (and (eq? s (asym A2)) (hash-ref FUNS s #f))
        (define x1 (aargs A1)) (define x2 (aargs A2))
        (when (andmap same? (cdr x1) (cdr x2)) (u! (car x1) (car x2))))
      (when (and (eq? s 'Opr) (eq? (asym A2) 'Opr) (same? (car (aargs A1)) (car (aargs A2))))
        (u! (cadr (aargs A1)) (cadr (aargs A2))) (u! (caddr (aargs A1)) (caddr (aargs A2))))
      (when (and (eq? s 'Suc) (eq? (asym A2) 'Suc) (same? (car (aargs A1)) (car (aargs A2))))
        (u! (cadr (aargs A1)) (cadr (aargs A2))))
      (when (and (eq? s 'App) (eq? (asym A2) 'App))
        (match-define (list f x a) (aargs A1)) (match-define (list g y b) (aargs A2))
        (when (and (same? f g) (same? x y) (for/or ([F hyps]) (and (eq? (asym F) 'Fnc) (same? (car (aargs F)) f))))
          (u! a b))))
    (when changed (loop)))
  find)

;; ======================================================================== (b) congruence closure with proof lines
;; inside an open theorem with context Hc (core); returns (values eqline closure-merges)
(define (cc-prove! Hc V hyps)
  (define rep (make-vector V #f))
  (define mem (make-hash))
  (define pl (make-hash))
  (for ([i V]) (vector-set! rep i i) (hash-set! mem i (list i)))
  (define (same? a b) (= (vector-ref rep a) (vector-ref rep b)))
  (define (pline v)
    (or (hash-ref pl v #f)
        (let ([l (T (list (Y (Eqv v v))) (Imp Hc (Eqv v v)))]) (hash-set! pl v l) l)))
  (define merges 0)
  ;; H -> a = b for a ~ b
  (define (eqline a b)
    (define r (vector-ref rep a))
    (unless (= r (vector-ref rep b)) (error 'eqline "~a and ~a are not congruent" a b))
    (cond [(= a b) (pline a)]
          [else (T (list (pline a) (pline b) (rs "Z:EqSym" b r) (rs "Z:EqTr" a r b)) (Imp Hc (Eqv a b)))]))
  ;; merge the classes of a and b, jl: H -> a = b
  (define (merge! a b jl)
    (unless (same? a b)
      (set! merges (add1 merges))
      (define-values (a2 b2 jl2)
        (if (> (length (hash-ref mem (vector-ref rep b))) (length (hash-ref mem (vector-ref rep a))))
            (values b a (T (list jl (rs "Z:EqSym" a b)) (Imp Hc (Eqv b a))))
            (values a b jl)))
      (define ra (vector-ref rep a2)) (define rb (vector-ref rep b2))
      (define la (pline a2)) (define lb (pline b2))
      (for ([v (hash-ref mem rb)])
        (define lv (pline v))
        (define nl (T (list lv lb la jl2 (rs "Z:EqSym" b2 rb) (rs "Z:EqTr" v rb b2) (rs "Z:EqSym" a2 b2)
                            (rs "Z:EqTr" v b2 a2) (rs "Z:EqTr" v a2 ra))
                      (Imp Hc (Eqv v ra))))
        (hash-set! pl v nl)
        (vector-set! rep v ra))
      (hash-set! mem ra (append (hash-ref mem ra) (hash-ref mem rb)))
      (hash-remove! mem rb)))
  ;; rewrite the atom A (a hypothesis or a line) argument by argument to the arguments new; returns the lines needed
  (define (rewrite-lines sym old new)
    (append*
     (for/list ([i (in-range (length old))] #:unless (= (list-ref old i) (list-ref new i)))
       (define args (for/list ([j (in-range (length old))]) (cond [(< j i) (list-ref new j)] [(= j i) HOLE] [else (list-ref old j)])))
       (list (eqline (list-ref old i) (list-ref new i)) (leib (mk sym args) (list-ref old i) (list-ref new i))))))
  (for ([A hyps]) (when (eq? (asym A) 'eq) (merge! (car (aargs A)) (cadr (aargs A)) (T '() (Imp Hc (c A))))))
  (let loop ()
    (define changed #f)
    (for* ([A1 hyps] [A2 hyps] #:unless (eq? A1 A2))
      (define s (asym A1))
      (when (eq? s (asym A2))
        (match-define (cons o1 in1) (aargs A1))
        (match-define (cons o2 in2) (aargs A2))
        (when (and (hash-ref FUNS s #f) (andmap same? in1 in2) (not (same? o1 o2)))
          (define ls (rewrite-lines s (cons o2 in2) (cons o2 in1)))
          (merge! o1 o2 (T (append ls (list (apply rs (hash-ref FUNS s) o1 o2 in1))) (Imp Hc (Eqv o1 o2))))
          (set! changed #t))
        (when (and (eq? s 'Opr) (same? o1 o2) (not (and (same? (car in1) (car in2)) (same? (cadr in1) (cadr in2)))))
          (match-define (list a b) in1) (match-define (list cc d) in2)
          (define ls (rewrite-lines 'Opr (list o2 cc d) (list o1 cc d)))
          (merge! a cc (T (append ls (list (rs "Z:Kur1" o1 a b cc d))) (Imp Hc (Eqv a cc))))
          (merge! b d (T (append ls (list (rs "Z:Kur2" o1 a b cc d))) (Imp Hc (Eqv b d))))
          (set! changed #t))
        (when (and (eq? s 'Suc) (same? o1 o2) (not (same? (car in1) (car in2))))
          (define ls (rewrite-lines 'Suc (list o2 (car in2)) (list o1 (car in2))))
          (merge! (car in1) (car in2) (T (append ls (list (rs "L:SucInj" o1 (car in1) (car in2)))) (Imp Hc (Eqv (car in1) (car in2)))))
          (set! changed #t))
        (when (eq? s 'App)
          (match-define (list f x a) (aargs A1)) (match-define (list g y b) (aargs A2))
          (define F (for/first ([F hyps] #:when (and (eq? (asym F) 'Fnc) (same? (car (aargs F)) f))) F))
          (when (and F (same? f g) (same? x y) (not (same? a b)))
            (define ls (append (rewrite-lines 'App (list g y b) (list f x b)) (rewrite-lines 'Fnc (aargs F) (list f))))
            (merge! a b (T (append ls (list (rs "Z:FncApp" f x a b))) (Imp Hc (Eqv a b))))
            (set! changed #t)))))
    (when changed (loop)))
  (values eqline rewrite-lines (lambda () merges)))

;; the theorem (h1 & ... & hk) -> goal; returns the number of merges, or #f when the goal does not follow by congruence
(define (cc-thm! key V hyps goal)
  (define find (pure-closure V hyps))
  (define gs (asym goal)) (define ga (aargs goal))
  (define source
    (cond [(eq? gs 'eq) (and (= (find (car ga)) (find (cadr ga))) 'eq)]
          [else (for/first ([A hyps] #:when (and (eq? (asym A) gs) (= (length (aargs A)) (length ga))
                                                 (andmap (lambda (u v) (= (find u) (find v))) (aargs A) ga)))
                  A)]))
  (cond
    [(not source) #f]
    [else
     (define mcount #f)
     (lemma! key V
       (lambda ()
         (define Hc (c (conj hyps)))
         (define-values (eqline rewrite-lines merges) (cc-prove! Hc V hyps))
         (set! mcount (merges))
         (if (eq? source 'eq)
             (eqline (car ga) (cadr ga))
             (T (rewrite-lines gs (aargs source) ga) (Imp Hc (c goal))))))
     mcount]))

;; ======================================================================== instances (exact LCG)
(define eq-lcg 20261009)
(define (erand n)
  (set! eq-lcg (modulo (+ (* eq-lcg 6364136223846793005) 1442695040888963407) 18446744073709551616))
  (modulo (arithmetic-shift eq-lcg -33) n))
(define (shuffle-lcg l)
  (define v (list->vector l))
  (for ([i (in-range (sub1 (vector-length v)) 0 -1)])
    (define j (erand (add1 i)))
    (define t (vector-ref v i)) (vector-set! v i (vector-ref v j)) (vector-set! v j t))
  (vector->list v))

;; families with a known goal: (list name V hyps goal)
(define (suc-ladder k)          ; a0 = b0, a(i+1) = S a(i), b(i+1) = S b(i)  =>  ak = bk
  (define (a i) i) (define (b i) (+ k 1 i))
  (list (format "suc-ladder ~a" k) (* 2 (add1 k))
        (shuffle-lcg (append (list `(eq ,(a 0) ,(b 0)))
                             (for/list ([i k]) `(pr Suc ,(a (add1 i)) ,(a i))) (for/list ([i k]) `(pr Suc ,(b (add1 i)) ,(b i)))))
        `(eq ,(a k) ,(b k))))
(define (suc-inj-ladder k)      ; ak = bk, the same chains  =>  a0 = b0 (successor is injective)
  (define (a i) i) (define (b i) (+ k 1 i))
  (list (format "suc-inj-ladder ~a" k) (* 2 (add1 k))
        (shuffle-lcg (append (list `(eq ,(a k) ,(b k)))
                             (for/list ([i k]) `(pr Suc ,(a (add1 i)) ,(a i))) (for/list ([i k]) `(pr Suc ,(b (add1 i)) ,(b i)))))
        `(eq ,(a 0) ,(b 0))))
(define (pair-tower k)          ; p0 = q0 ... pairs p(i+1) = (p(i), c(i)), q(i+1) = (q(i), d(i)), c(i) = d(i)  =>  pk = qk;
  ;; variables: p 0..k, q k+1..2k+1, c 2k+2..3k+1, d 3k+2..4k+1
  (define (p i) i) (define (q i) (+ k 1 i)) (define (cv i) (+ (* 2 k) 2 i)) (define (dv i) (+ (* 3 k) 2 i))
  (list (format "pair-tower ~a" k) (+ (* 4 k) 2)
        (shuffle-lcg (append (list `(eq ,(p 0) ,(q 0)))
                             (for/list ([i k]) `(pr Opr ,(p (add1 i)) ,(p i) ,(cv i)))
                             (for/list ([i k]) `(pr Opr ,(q (add1 i)) ,(q i) ,(dv i)))
                             (for/list ([i k]) `(eq ,(cv i) ,(dv i)))))
        `(eq ,(p k) ,(q k))))
(define (pair-untower k)        ; pk = qk and the same pairs  =>  c0 = d0 (Kuratowski pairs are injective)
  (match-define (list _ V hyps _) (pair-tower k))
  (define (p i) i) (define (q i) (+ k 1 i)) (define (cv i) (+ (* 2 k) 2 i)) (define (dv i) (+ (* 3 k) 2 i))
  (list (format "pair-untower ~a" k) V
        (cons `(eq ,(p k) ,(q k)) (filter (lambda (A) (eq? (asym A) 'Opr)) hyps))
        `(eq ,(cv 0) ,(dv 0))))
(define (app-chain k)           ; Fnc(f), x0 = y0, App(f,x(i),x(i+1)), App(f,y(i),y(i+1))  =>  Sub(xk, z) from Sub(yk, z)
  (define f 0) (define z 1) (define (x i) (+ 2 i)) (define (y i) (+ 3 k i))
  (list (format "app-chain ~a" k) (+ 4 (* 2 k))
        (shuffle-lcg (append (list `(pr Fnc ,f) `(eq ,(x 0) ,(y 0)) `(pr Sub ,(y k) ,z))
                             (for/list ([i k]) `(pr App ,f ,(x i) ,(x (add1 i)))) (for/list ([i k]) `(pr App ,f ,(y i) ,(y (add1 i))))))
        `(pr Sub ,(x k) ,z)))
(define (mixed k)               ; Emp, Sng, Upr, Suc and membership together
  ;; e0, e1 empty; s0 = {e0}, s1 = {e1}; u0 = {e0, s0}, u1 = {e1, s1}; n0 = S u0, n1 = S u1; goal: m in n1 from m in n0
  (list (format "mixed ~a" k) 9
        (shuffle-lcg (list '(pr Emp 0) '(pr Emp 1) '(pr Sng 2 0) '(pr Sng 3 1) '(pr Upr 4 0 2) '(pr Upr 5 1 3)
                           '(pr Suc 6 4) '(pr Suc 7 5) '(in 8 6)))
        '(in 8 7)))
(define (random-cc V nh)
  ;; random atoms over V variables; the goal: a congruent pair that needs the most union steps, or an atom rewritten
  (define syms '(eq eq Suc Suc Opr Sng Upr Emp App Fnc in Sub))
  (define hyps
    (remove-duplicates
     (for/list ([i nh])
       (define s (list-ref syms (erand (length syms))))
       (define (r) (erand V))
       (case s
         [(eq) `(eq ,(r) ,(r))] [(in) `(in ,(r) ,(r))] [(Sub) `(pr Sub ,(r) ,(r))]
         [(Suc Sng) `(pr ,s ,(r) ,(r))] [(Opr Upr) `(pr ,s ,(r) ,(r) ,(r))] [(Emp Fnc) `(pr ,s ,(r))]
         [(App) `(pr App ,(r) ,(r) ,(r))]))))
  (define find (pure-closure V hyps))
  (define direct (for/list ([A hyps] #:when (eq? (asym A) 'eq)) (aargs A)))
  (define pairs (for*/list ([u V] [v V] #:when (and (< u v) (= (find u) (find v))
                                                    (not (member (list u v) direct)) (not (member (list v u) direct))))
                  (list u v)))
  (cond [(pair? pairs) (let ([p (list-ref pairs (erand (length pairs)))]) `(eq ,@p))]
        [else
         (define A (for/first ([A hyps] #:when (memq (asym A) '(in Sub))) A))
         (and A (mk (asym A) (map (lambda (x) (or (for/first ([v V] #:when (and (not (= v x)) (= (find v) (find x)))) v) x)) (aargs A))))]))
