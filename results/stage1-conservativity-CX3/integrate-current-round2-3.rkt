#lang racket/base
(require racket/file racket/list racket/string racket/port racket/path racket/system json openssl/sha1)

;; Each invocation creates a separate, dated receipt set and preserves earlier files.
(define lane "C:/ClaudeOutput/pompetzki/lanes/CX3")
(define owner "C:/ClaudeOutput/pompetzki/lanes/CX3B")
(define candidate "C:/ClaudeOutput/pompetzki/lanes/CEO/executive-20261009-183208/package/coo-candidate-20261009-200631")
(define date-exe "C:/Program Files/Git/usr/bin/date.exe")
(define seq (if (= (vector-length (current-command-line-arguments)) 1)
                (vector-ref (current-command-line-arguments) 0) "1"))
(unless (regexp-match? #px"^[0-9]+$" seq) (error 'sequence "expected an integer receipt sequence"))
(define clock (string-trim (with-output-to-string (lambda () (unless (system* date-exe "+%Y-%m-%dT%H:%M:%S%:z") (error 'date "date.exe failed"))))))
(define base (build-path lane (string-append "CURRENT-ROUND2-INTEGRATION-" seq)))
(define out-json (path-add-extension base #".json"))
(define out-md (path-add-extension base #".md"))
(define out-plan (path-add-extension base #".copy-plan.tsv"))
(define out-sha (path-add-extension base #".sha256"))
(for ([p (in-list (list out-json out-md out-plan out-sha))])
  (when (file-exists? p) (error 'preserve "receipt already exists: ~a" p)))
(define (read-j p) (call-with-input-file p read-json))
(define (sha p) (call-with-input-file p (lambda (i) (bytes->hex-string (sha256-bytes i))) #:mode 'binary))
(define (text-of p) (if (file-exists? p) (file->string p) ""))
(define inventory (read-j (build-path owner "order2-inventory.json")))
(define modules (read-j (build-path owner "round2-recovery-final-modules.json")))
(define file-records (make-hash))
(define copy-plan (make-hash))
(define (record p [relative #f])
  (cond
    [(not (file-exists? p)) #f]
    [else
     (define k (path->string (simplify-path p #f)))
     (hash-ref! file-records k
       (lambda ()
         (define n (file-size p))
         (define h (sha p))
         (define dest (and relative (build-path candidate relative)))
         (define same (and dest (file-exists? dest) (= n (file-size dest)) (equal? h (sha dest))))
         (when relative (hash-set! copy-plan k (list k relative h n same)))
         (hasheq 'path k 'bytes n 'sha256 h
                 'package_relative (or relative 'null)
                 'package_present (and dest (file-exists? dest) #t)
                 'package_matches (and same #t))))]))
(define (source p) (record (build-path owner p) (string-append "rocq/CX3B/" p)))
(define (receipt p) (record (build-path owner p) (string-append "receipts/CX3B/" p)))
(define (compile-ok? m)
  (regexp-match? #px"(?m:^exit-code: 0$)" (text-of (build-path owner (string-append m ".compile1.receipt.txt")))))
(define (kernel-ok? m group)
  (define individual (text-of (build-path owner (string-append m ".check1.receipt.txt"))))
  (define grouped (text-of (build-path owner (string-append group ".check1.receipt.txt"))))
  (define indiv-ok (and (regexp-match? #px"(?m:^exit-code: 0$)" individual)
                        (string-contains? individual (string-append "CX3B." m))))
  (define group-ok (and (regexp-match? #px"(?m:^exit-code: 0$)" grouped)
                        (string-contains? grouped (string-append "CX3B." m))))
  (cond [indiv-ok (string-append m ".check1.receipt.txt")]
        [group-ok (string-append group ".check1.receipt.txt")]
        [else #f]))
(define rows
  (for/list ([i (in-list inventory)])
    (define id (hash-ref i 'id))
    (define m (hash-ref modules (string->symbol id)))
    (define mod (hash-ref m 'module))
    (define group (hash-ref m 'check_group ""))
    (define cert-name (string-append mod ".v"))
    (define cert (text-of (build-path owner cert-name)))
    (define import (regexp-match #px"Round2Data[A-Za-z0-9]+" cert))
    (define data-mod (if import (car import) (string-append "Round2Data" id)))
    (define sr (source cert-name))
    (define dr (source (string-append data-mod ".v")))
    (define object (record (build-path owner (string-append mod ".vo"))))
    (define data-object (record (build-path owner (string-append data-mod ".vo"))))
    (define c-ok (and object (compile-ok? mod) #t))
    (define k (and c-ok (kernel-ok? mod group)))
    (define source-jdg (string->path (hash-ref i 'source)))
    (define jdgr (record source-jdg (string-append "receipts/CX3-current-round2/jdg/" id "-" (hash-ref i 'basename))))
    (unless (and jdgr (equal? (hash-ref jdgr 'sha256) (hash-ref i 'source_sha256)))
      (error 'source "current JDG hash differs from inventory: ~a" id))
    (define print-output (text-of (build-path owner (string-append mod ".compile1.txt"))))
    (define assumption-count (length (regexp-match* #px"Closed under the global context" print-output)))
    (define conditional (and (not (string=? cert ""))
                             (regexp-match? #px"reg_ok[^\n]*->|prefix[^\n]*->|hypothesis[^\n]*->" cert)))
    (for ([s (in-list (list (string-append mod ".compile1.receipt.txt") (string-append mod ".compile1.txt")
                            (string-append data-mod ".compile1.receipt.txt")
                            (string-append "round2-emission" id ".json")
                            (string-append "round2-ast" id ".json")))]) (receipt s))
    (when k
      (receipt k)
      (receipt (string-replace k ".receipt.txt" ".txt")))
    (define theorem (string-append "CX3B." mod ".round2_batch" id "_closed"))
    (hasheq 'id id 'priority (hash-ref i 'priority) 'theorems (hash-ref i 'theorems) 'steps (hash-ref i 'steps)
            'module (string-append "CX3B." mod) 'closure_api theorem
            'statement (hash-ref m 'closed_statement) 'expansion (hash-ref m 'expansion)
            'proof_path (hash-ref m 'proof_path) 'split (hash-ref m 'split_description)
            'source_jdg jdgr 'certificate_source (or sr 'null) 'certificate_object (or object 'null)
            'data_source (or dr 'null) 'data_object (or data-object 'null)
            'compiler_completed c-ok 'kernel_completed (and k #t) 'kernel_receipt (or k 'null)
            'assumption_closed_prints assumption-count 'explicit_registry_premise (and conditional #t)
            'registry_at_start (hash-ref i 'registry)
            'registry_condition "Kernel identity to reg0_677, then reg0_677_correct = stage2_registry and stage2_registry_ok; pending certificates require these proofs before a closure claim."
            'resource_condition "No pmp resource premise enters the mathematical closure theorem. Recorded pmp resource stops remain resource stops; actual interpreter/ELF simulation remains with its owners."
            'recorded_pmp_verdict (hash-ref i 'pmp_verdict) 'recorded_racket_verdict (hash-ref i 'racket_verdict)
            'status (cond [k (if conditional "KERNEL_CHECKED_WITH_EXPLICIT_PREMISES" "KERNEL_CHECKED_CLOSED_MEMBERS")]
                          [c-ok "COMPILED_KERNEL_PENDING"] [else "TARGET_PENDING"]))))

(for ([n (in-list '("Stage2Bridge2.v" "Stage2DataRegistry.v" "Stage2RegistryCertificate2.v" "Round2ExpansionBridge.v"))]) (source n))
(for ([n (in-list '("order2-inventory.json" "round2-recovery-final-modules.json" "Round2KernelP1.targets.json" "Round2KernelP2.targets.json" "Round2KernelP3.targets.json" "Round2ExpansionBridge.compile1.receipt.txt" "Round2ExpansionBridge.compile1.txt"))]) (receipt n))
(for ([n (in-list '("Conservativity2.v" "Stage2Conservativity2.v" "Conservativity2.compile1.receipt.txt" "Stage2Conservativity2.compile1.receipt.txt" "Conservativity2.check1.receipt.txt" "Stage2Conservativity2.check1.receipt.txt"))])
  (record (build-path lane n) (string-append "rocq/CX3/" n)))
(define license-record (record (build-path candidate "LICENSE")))
(define completed (filter (lambda (r) (hash-ref r 'kernel_completed)) rows))
(define compiled (filter (lambda (r) (hash-ref r 'compiler_completed)) rows))
(define (sum rs k) (for/sum ([r (in-list rs)]) (hash-ref r k)))
(define artifact
  (hasheq 'clock_date_exe clock 'lane "CX3" 'source_owner "CX3B order2"
          'candidate candidate 'license "MIT; Copyright (c) 2026 Christopher Pompetzki; candidate LICENSE receipt is included."
          'license_record license-record 'targets (length rows) 'kernel_completed (length completed)
          'kernel_theorems (sum completed 'theorems) 'kernel_steps (sum completed 'steps)
          'compiled (length compiled) 'compiled_theorems (sum compiled 'theorems) 'compiled_steps (sum compiled 'steps)
          'rows rows 'files (sort (hash-values file-records) string<? #:key (lambda (r) (hash-ref r 'path)))
          'context_scope "Assumption summaries belong to the named completed modules only. Other modules and global Corelib contexts are not certified by this table."
          'baseline "Seven previously completed baseline batches: 1656 theorems, 53069 steps; receipts are in INTEGRATION-RECOVERY-1.md/json and are not rerun here."
          'package_scope "Current candidate comparisons are per-file. A new package overlay, outer manifest and archive/extraction receipts belong to the COO. Proof objects are local artifacts and excluded from the source package."
          'jobs_started 0))
(call-with-output-file out-json #:exists 'error (lambda (o) (write-json artifact o) (newline o)))
(call-with-output-file out-plan #:exists 'error
  (lambda (o)
    (displayln "source\tpackage_relative\tsha256\tbytes\talready_matches_candidate" o)
    (for ([v (in-list (sort (hash-values copy-plan) string<? #:key car))])
      (fprintf o "~a\t~a\t~a\t~a\t~a\n" (list-ref v 0) (list-ref v 1) (list-ref v 2) (list-ref v 3) (list-ref v 4)))))
(call-with-output-file out-md #:exists 'error
  (lambda (o)
    (fprintf o "# Current Round 2 Gam and pure-ZF integration\n\nReceipt clock from date.exe: ~a. CX3 reused completed APIs and receipts; no compiler, kernel checker or judge job was started.\n\n" clock)
    (fprintf o "~a/~a targets have completed recursive kernel receipts: ~a theorems and ~a steps. ~a targets have completed compiler receipts: ~a theorems and ~a steps. The remaining rows retain their stated pending status.\n\n" (length completed) (length rows) (sum completed 'theorems) (sum completed 'steps) (length compiled) (sum compiled 'theorems) (sum compiled 'steps))
    (displayln "The seven baseline batches remain separately completed: 1,656 theorems and 53,069 steps. INTEGRATION-RECOVERY-1.md/json contains their source, object, module and kernel receipts.\n" o)
    (displayln "Each completed member theorem gives prov Gam (tof (t_stmt t)) and prov ZFpure of its faithful expansion. The 11-definition stage2_expand applies to wave-2 and L71-L75; L6 and L76 use the 18-definition dependency-closed round2_expand. Both preserve registered definitions. Their proof paths reuse CX3.Stage2Conservativity2.accepted_member_Gam, covered_expansion_pure and CX3.Conservativity2.expanded_theorem_pure.\n" o)
    (displayln "The registry at the start is the canonical 677 prefix. Completed identities and metadata discharge reg_ok, empty theorem hypotheses and exact expansion coverage. Pending targets acquire closure only after those certificates and their recursive kernel receipts complete. Any explicit qualified-registry premise must remain in the exported theorem. The JSON records the exact statement and status separately.\n" o)
    (displayln "No pmp interpreter resource condition is used by these mathematical closure theorems. A recorded gosub/memory resource stop is retained as a resource stop. Actual interpreter-to-check_batch and actual ELF-to-check_batch proofs remain with their owners. Assumption summaries below belong to these named completed modules; no assertion is made about other modules or global Corelib contexts.\n" o)
    (displayln "| ID | Theorems | Steps | Final module | Expansion | Status | Closed assumption prints |\n|---|---:|---:|---|---|---|---:|" o)
    (for ([r (in-list rows)])
      (fprintf o "| ~a | ~a | ~a | ~a | ~a | ~a | ~a |\n" (hash-ref r 'id) (hash-ref r 'theorems) (hash-ref r 'steps) (hash-ref r 'module) (hash-ref r 'expansion) (hash-ref r 'status) (hash-ref r 'assumption_closed_prints)))
    (fprintf o "\nThe JSON lists exact JDG/source/object hashes, closure theorem names, registry/resource conditions, compiler/kernel receipt paths and candidate comparisons. The copy plan lists immutable source and completed receipt inputs for the COO overlay. Local .vo hashes are evidence of checked objects; this source package excludes .vo files.\n\nCandidate inspected: ~a. MIT license, copyright 2026 Christopher Pompetzki; the exact LICENSE hash is recorded in the JSON. Candidate outer-manifest/archive checks must be refreshed after its owner incorporates the overlay.\n" candidate)))
(call-with-output-file out-sha #:exists 'error
  (lambda (o)
    (fprintf o "# date.exe ~a\n" clock)
    (for ([r (in-list (sort (hash-values file-records) string<? #:key (lambda (r) (hash-ref r 'path))))])
      (fprintf o "~a  ~a\n" (hash-ref r 'sha256) (hash-ref r 'path)))
    (for ([p (in-list (list out-json out-md out-plan (build-path lane "integrate-current-round2-3.rkt")))])
      (fprintf o "~a  ~a\n" (sha p) p))))
(printf "~a: ~a/~a kernel targets, ~a/~a compiled, ~a source/hash records; ~a\n" clock (length completed) (length rows) (length compiled) (length rows) (hash-count file-records) out-md)
