#lang racket/base
;; scripts.rkt -- lane L6: the proof scripts, one per Mathlib-environment statement, in dependency order.
;; A script is (auto HINT ...) or (ind VAR (base HINT ...) (step HINT ...)). Hints:
;;   (thm NAME t ...)   an earlier statement of this list at the terms t
;;   (ih t ...)         the induction hypothesis (step only); PRED is the predecessor, VAR itself is S(PRED)
;;   (zf KEY (arg ...)) / (zfs KEY (arg ...))  a ZF lemma instance (schematic / universally closed); W is omega
;;   (releq KEY (arg ...) TERM TARGET)  a ZF lemma concluding R(args of TERM, TARGET): val(TERM) = val(TARGET)
;; Variable names are those printed by leanstmt.rkt (binder name + position).
(provide SCRIPTS)

(define (order2 x y) `((thm "Nat.lt_trichotomy" ,x ,y) (thm "Nat.lt_asymm" ,x ,y) (thm "Nat.lt_irrefl" ,x) (thm "Nat.lt_irrefl" ,y)))
(define (auto2 x y) `(auto ,@(order2 x y)))

(define SCRIPTS
  `(;; ---- addition: the recursion equations, then induction
    ("Nat.add_zero" (auto (releq (Zero add) (W n1 0) (+ n1 0) n1)))
    ("Nat.add_succ" (auto (releq (Step add) (W n1 m2 (+ n1 m2) (S m2) (S (+ n1 m2))) (+ n1 (S m2)) (S (+ n1 m2)))))
    ("Nat.zero_add" (ind n1 (base (thm "Nat.add_zero" 0)) (step (ih) (thm "Nat.add_succ" 0 PRED))))
    ("Nat.succ_add" (ind m2 (base (thm "Nat.add_zero" (S n1)) (thm "Nat.add_zero" n1))
                         (step (ih) (thm "Nat.add_succ" (S n1) PRED) (thm "Nat.add_succ" n1 PRED))))
    ("Nat.add_comm" (ind m2 (base (thm "Nat.add_zero" n1) (thm "Nat.zero_add" n1))
                         (step (ih) (thm "Nat.add_succ" n1 PRED) (thm "Nat.succ_add" PRED n1))))
    ("Nat.add_assoc" (ind k3 (base (thm "Nat.add_zero" (+ n1 m2)) (thm "Nat.add_zero" m2))
                          (step (ih) (thm "Nat.add_succ" (+ n1 m2) PRED) (thm "Nat.add_succ" m2 PRED) (thm "Nat.add_succ" n1 (+ m2 PRED)))))
    ("Nat.add_left_comm" (auto (thm "Nat.add_assoc" n1 m2 k3) (thm "Nat.add_comm" n1 m2) (thm "Nat.add_assoc" m2 n1 k3)))
    ("Nat.add_right_comm" (auto (thm "Nat.add_assoc" n1 m2 k3) (thm "Nat.add_comm" m2 k3) (thm "Nat.add_assoc" n1 k3 m2)))
    ("Nat.add_add_add_comm" (auto (thm "Nat.add_assoc" a1 b2 (+ c3 d4)) (thm "Nat.add_left_comm" b2 c3 d4) (thm "Nat.add_assoc" a1 c3 (+ b2 d4))))
    ("Nat.add_one" (auto (thm "Nat.add_succ" n1 0) (thm "Nat.add_zero" n1)))
    ("Nat.succ_eq_add_one" (auto (thm "Nat.add_one" n1)))
    ("Nat.one_add" (auto (thm "Nat.add_comm" 1 n1) (thm "Nat.add_one" n1)))
    ("Nat.succ_eq_one_add" (auto (thm "Nat.one_add" n1)))
    ("Nat.succ_add_eq_add_succ" (auto (thm "Nat.succ_add" a1 b2) (thm "Nat.add_succ" a1 b2)))
    ;; ---- order: membership on omega
