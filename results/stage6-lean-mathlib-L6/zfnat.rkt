#lang racket/base
;; zfnat.rkt -- lane L6: addition and multiplication on omega in ZF, in the relational form of sigma1.rkt (Stage 2):
;;   Add(x,y,z) = exists f [Fnc(f) & forall o (Emp(o) -> App(f,o,x)) & forall i (i in y -> exists a App(f,i,a))
;;                          & forall i j a b (i in y & Suc(j,i) & App(f,i,a) & App(f,j,b) -> Suc(b,a)) & App(f,y,z)]
;;   Mul(x,y,z): the same with App(f,o,o) at the empty set and Add(a,x,b) as the step.
;; General theorems over omega, each a schematic JDG1 theorem (open in its frame variables):
;;   (Uq k)       Om(w) [& x in w for mul] & y in w & Op(x,y,z) & Op(x,y,z')    -> z = z'          (induction on omega)
;;   (Graph k)    Om(w) & x in w -> exists g (Fnc g & Dom(g,w) & Rng(g,w) & forall a b (App(g,a,b) -> R(a,b)))
;;   (Rec k)      Om(w) & x in w -> exists F RecBody(F)                         (L:RecThm on the graph)
;;   (FinOfRec k) Om(w) & RecBody(F) & y in w & App(F,y,z)                     -> Op(x,y,z)
;;   (Tot k)      Om(w) & x in w & y in w -> exists z (z in w & Op(x,y,z))
;;   (Zero k)     Om(w) & x in w & Emp(o) -> Op(x,o,x)  (add)  /  Op(x,o,o)  (mul)
;;   (Step k)     Om(w) & x in w & y in w & Op(x,y,z) & Suc(s,y) & R(z,z')       -> Op(x,s,z')
;;   (InW k)      Om(w) & x in w & y in w & Op(x,y,z)                          -> z in w
;; with R(a,b) = Suc(b,a) for add and Add(a,x,b) for mul.
(require racket/list racket/match "zfcore.rkt" "zfbatch.rkt")
(provide (all-defined-out))

;; ---- the formulas of sigma1.rkt (fin-parts, fin-body, fin-f), the same construction
(define (fin-parts kind f x y z)
  (define o (fresh-sym 'o)) (define i (fresh-sym 'i)) (define a (fresh-sym 'a))
  (define i2 (fresh-sym 'i)) (define j (fresh-sym 'j)) (define a2 (fresh-sym 'a)) (define b (fresh-sym 'b))
  (list `(pr Fnc ,f)
        (if (eq? kind 'add) `(all ,o (imp (pr Emp ,o) (pr App ,f ,o ,x))) `(all ,o (imp (pr Emp ,o) (pr App ,f ,o ,o))))
        `(all ,i (imp (in ,i ,y) (ex ,a (pr App ,f ,i ,a))))
        `(all ,i2 (all ,j (all ,a2 (all ,b (imp (and (in ,i2 ,y) (pr Suc ,j ,i2) (pr App ,f ,i2 ,a2) (pr App ,f ,j ,b))
                                                 ,(if (eq? kind 'add) `(pr Suc ,b ,a2) (fin-f 'add a2 x b)))))))
        `(pr App ,f ,y ,z)))
(define (fin-body kind f x y z) `(and ,@(fin-parts kind f x y z)))
(define (fin-f kind x y z) (let ([f (fresh-sym 'f)]) `(ex ,f ,(fin-body kind f x y z))))
(define (add-f x y z) (fin-f 'add x y z))
(define (mul-f x y z) (fin-f 'mul x y z))
(define (rel kind x a b) (if (eq? kind 'add) `(pr Suc ,b ,a) (add-f a x b)))   ; R(a,b)
(define (base-of kind x o) (if (eq? kind 'add) x o))

;; the recursion body of (Rec k)
(define (rec-parts kind F w x)
  (define o (fresh-sym 'o)) (define i (fresh-sym 'i)) (define a (fresh-sym 'a)) (define j (fresh-sym 'j)) (define b (fresh-sym 'b))
  (list `(pr Fnc ,F) `(pr Dom ,F ,w) `(pr Rng ,F ,w)
        `(all ,o (imp (pr Emp ,o) (pr App ,F ,o ,(base-of kind x o))))
        `(all ,i (all ,a (all ,j (all ,b (imp (and (pr App ,F ,i ,a) (pr Suc ,j ,i) (pr App ,F ,j ,b)) ,(rel kind x a b))))))))
(define (rec-body kind F w x) `(and ,@(rec-parts kind F w x)))

(define (ids n) (range n))
(define (uq-hyps kind w x y z1 z2)
  (append (list `(pr Om ,w)) (if (eq? kind 'mul) (list `(in ,x ,w)) '()) (list `(in ,y ,w) (fin-f kind x y z1) (fin-f kind x y z2))))
(define (uq-line kind w x y z1 z2) (U `(Uq ,kind) (list w x y z1 z2)))
;; ctx |- a = b from lines for R(c,a), R(c,b) (R functional); w, x in context for mul
(define (rel-uq kind w x c a b)
  (if (eq? kind 'add) (spec 'SucUq (list a b c)) (uq-line 'add w c x a b)))

(define (start-lemma! key nvars hyps)
  (begin-thm! key nvars)
  (set-ctx! (map c hyps)))
(define (finish-lemma! goal-line nvars)
  (define f (line goal-line))
  (end-thm! f (ids nvars)))

;; ---- (Uq k): vars w=0 x=1 y=2 z=3 z'=4
(defgen Uq (key)
  (define kind (cadr key))
  (start-lemma! key 5 (uq-hyps kind 0 1 2 3 4))
  (define w 0) (define x 1) (define y 2) (define z 3) (define z2 4)
  (define omline (hyp (c `(pr Om ,w))))
  (define F1 (c (fin-f kind x y z))) (define F2 (c (fin-f kind x y z2)))
  (define f (fresh!)) (define g (fresh!))
  (define goal (c `(eq ,z ,z2)))
  (define res
    (exE (hyp F1) (ex-body F1) f goal
         (lambda ()
           (exE (hyp F2) (ex-body F2) g goal
                (lambda ()
                  (define pf (map c (fin-parts kind f x y z)))
                  (define pg (map c (fin-parts kind g x y z2)))
                  (define (phi i) (let ([a (fresh-sym 'a)]) `(imp (or (in ,i ,y) (eq ,i ,y)) (all ,a (imp (pr App ,f ,i ,a) (pr App ,g ,i ,a))))))
                  (define (cons-of i) (let ([a (fresh-sym 'a)]) (c `(all ,a (imp (pr App ,f ,i ,a) (pr App ,g ,i ,a))))))
                  (define ind
                    (induct w omline phi
                            ;; base
                            (lambda (e)
                              (define X (base-of kind x e))
                              (define a (fresh!))
                              (intro (c `(or (in ,e ,y) (eq ,e ,y))) (cons-of e)
                                     (lambda ()
                                       (allI a (c `(imp (pr App ,f ,e ,a) (pr App ,g ,e ,a)))
                                             (lambda ()
                                               (intro (c `(pr App ,f ,e ,a)) (c `(pr App ,g ,e ,a))
                                                      (lambda ()
                                                        (have (c `(pr App ,g ,e ,a))
                                                              (inst (list-ref pf 1) e) (inst (list-ref pg 1) e)
                                                              (spec 'FncApp (list f e X a)) (leib `(pr App ,g ,e ,HOLE) X a)))))))))
                            ;; step
                            (lambda (yy s)
                              (define a1 (fresh!))
                              (intro (c `(or (in ,s ,y) (eq ,s ,y))) (cons-of s)
                                     (lambda ()
                                       (allI a1 (c `(imp (pr App ,f ,s ,a1) (pr App ,g ,s ,a1)))
                                             (lambda ()
                                               (intro (c `(pr App ,f ,s ,a1)) (c `(pr App ,g ,s ,a1))
                                                      (lambda ()
                                                        (define sd (unfold 'Suc (list s yy)))
                                                        (define yin (have (c `(in ,yy ,y)) sd (inst (def-body sd) yy) (refl yy)
                                                                          (U 'OmOrd0 (list w)) (spec 'OrdTr (list w yy s y))
                                                                          (leib `(in ,yy ,HOLE) s y)))
                                                        (define ihc (cons-of yy))
                                                        (define ih (have ihc yin (refl yy)))
                                                        (define p3 (inst (list-ref pf 2) yy))
                                                        (define exc (c (let ([a (fresh-sym 'a)]) `(ex ,a (pr App ,f ,yy ,a)))))
                                                        (define cv (fresh!))
                                                        (exE (have exc yin p3) (ex-body exc) cv (c `(pr App ,g ,s ,a1))
                                                             (lambda ()
                                                               (define gyc (have (c `(pr App ,g ,yy ,cv)) ih (inst ihc cv)))
                                                               (define exd (c (let ([b (fresh-sym 'b)]) `(ex ,b (pr App ,g ,s ,b)))))
                                                               (define gs (have exd (inst (list-ref pg 2) s)
                                                                                (leib `(not (pr App ,g ,HOLE ,z2)) s y)
                                                                                (exI z2 (ex-body exd))))
                                                               (define dv (fresh!))
                                                               (exE gs (ex-body exd) dv (c `(pr App ,g ,s ,a1))
                                                                    (lambda ()
                                                                      (have (c `(pr App ,g ,s ,a1))
                                                                            (inst* (list-ref pf 3) (list yy s cv a1))
                                                                            (inst* (list-ref pg 3) (list yy s cv dv))
                                                                            gyc yin
                                                                            (rel-uq kind w x cv a1 dv)
                                                                            (leib `(not (pr App ,g ,s ,HOLE)) a1 dv)))))))))))))))
                  (define phy (c (phi y)))
                  (have goal ind (inst (c (let ([i (fresh-sym 'i)]) `(all ,i (imp (in ,i ,w) ,(phi i))))) y)
                        (refl y) (inst (cons-of y) z) (spec 'FncApp (list g y z z2))))))))
  (finish-lemma! res 5))

;; ---- (Graph k): vars w=0 x=1
(define (graph-body kind g w x)
  (define a (fresh-sym 'a)) (define b (fresh-sym 'b))
  `(and (pr Fnc ,g) (pr Dom ,g ,w) (pr Rng ,g ,w) (all ,a (all ,b (imp (pr App ,g ,a ,b) ,(rel kind x a b))))))
(defgen Graph (key)
  (define kind (cadr key))
  (define w 0) (define x 1)
  (start-lemma! key 2 (list `(pr Om ,w) `(in ,x ,w)))
  (define omline (hyp (c `(pr Om ,w))))
  (define goal (c (let ([g (fresh-sym 'g)]) `(ex ,g ,(graph-body kind g w x)))))
  (define exP (spec 'PrEx (list w w)))
  (define p (fresh!))
  (define res
    (exE exP (ex-body (line exP)) p goal
         (lambda ()
           (define (phi d) (let ([a (fresh-sym 'a)] [b (fresh-sym 'b)]) `(ex ,a (ex ,b (and (pr Opr ,d ,a ,b) ,(rel kind x a b))))))
           (define dd (fresh-sym 'd)) (define rr (fresh-sym 'r)) (define zz (fresh-sym 'z))
           (define sl (Y (c `(all ,zz (ex ,rr (all ,dd (iff (in ,dd ,rr) (and (in ,dd ,zz) ,(phi dd)))))))))
           (define sp (S sl (list p)))
           (define g (fresh!))
           (exE sp (ex-body (line sp)) g goal
                (lambda ()
                  (define Gc (last CTX))
                  (define Gl (hyp Gc))
                  (define prod (c `(pr Prod ,p ,w ,w)))
                  ;; Char1: forall a b (App(g,a,b) -> ((a in w & b in w) & R(a,b)))
                  (define (ch1-body a b) `(imp (pr App ,g ,a ,b) (and (and (in ,a ,w) (in ,b ,w)) ,(rel kind x a b))))
                  (define a (fresh!)) (define b (fresh!))
                  (define ch1
                    (allI a (c (let ([b2 (fresh-sym 'b)]) `(all ,b2 ,(ch1-body a b2))))
                          (lambda ()
                            (allI b (c (ch1-body a b))
                                  (lambda ()
                                    (intro (c `(pr App ,g ,a ,b)) (c `(and (and (in ,a ,w) (in ,b ,w)) ,(rel kind x a b)))
                                           (lambda ()
                                             (define ua (unfold 'App (list g a b)))
                                             (define exd (def-body ua))
                                             (define d (fresh!))
                                             (define tgt (c `(and (and (in ,a ,w) (in ,b ,w)) ,(rel kind x a b))))
                                             (exE (have exd ua) (ex-body exd) d tgt
                                                  (lambda ()
                                                    (define phd (c (phi d)))
                                                    (define a2 (fresh!)) (define b2 (fresh!))
                                                    (define pin (have phd Gl (inst Gc d)))
                                                    (exE pin (ex-body phd) a2 tgt
                                                         (lambda ()
                                                           (define inner (ren (scons a2 sid) (ex-body phd)))
                                                           (exE (hyp inner) (ex-body inner) b2 tgt
                                                                (lambda ()
                                                                  (have tgt (spec 'Kur1 (list d a2 b2 a b)) (spec 'Kur2 (list d a2 b2 a b))
                                                                        (leib (rel kind x HOLE b2) a2 a) (leib (rel kind x a HOLE) b2 b)
                                                                        (spec 'PrMem (list p w w a b d)) Gl (inst Gc d)))))))))))))))
                  (define (ch1-at a b) (have (c (ch1-body a b)) ch1 (inst* (line* ch1) (list a b))))
                  ;; Char2: (a in w & b in w) & R(a,b) -> App(g,a,b)
                  (define (ch2 a b)
                    (intro (c `(and (and (in ,a ,w) (in ,b ,w)) ,(rel kind x a b))) (c `(pr App ,g ,a ,b))
                           (lambda ()
                             (define eo (spec 'OprEx (list a b)))
                             (define d (fresh!))
                             (exE eo (ex-body (line eo)) d (c `(pr App ,g ,a ,b))
                                  (lambda ()
                                    (define phd (c (phi d)))
                                    (define inner-a (ren (scons a sid) (ex-body phd)))       ; exists b' (Opr(d,a,b') & R(a,b'))
                                    (have (c `(pr App ,g ,a ,b))
                                          (exI b (ex-body inner-a)) (exI a (ex-body phd))
                                          (spec 'PrMem (list p w w a b d)) Gl (inst Gc d) (spec 'MemApp (list g a b d))))))))
                  ;; Fnc(g)
                  (define uf (unfold 'Fnc (list g)))
                  (define fa (fresh!)) (define fb (fresh!)) (define fc (fresh!))
                  (define fncb (def-body uf))
                  (define (fnc-inner a b cc) `(imp (and (pr App ,g ,a ,b) (pr App ,g ,a ,cc)) (eq ,b ,cc)))
                  (define fl
                    (allI fa (ren (scons fa sid) (match fncb [(list 'A x) x]))
                          (lambda ()
                            (allI fb (c (let ([c2 (fresh-sym 'c)]) `(all ,c2 ,(fnc-inner fa fb c2))))
                                  (lambda ()
                                    (allI fc (c (fnc-inner fa fb fc))
                                          (lambda ()
                                            (intro (c `(and (pr App ,g ,fa ,fb) (pr App ,g ,fa ,fc))) (c `(eq ,fb ,fc))
                                                   (lambda ()
                                                     (have (c `(eq ,fb ,fc)) (ch1-at fa fb) (ch1-at fa fc)
                                                           (rel-uq kind w x fa fb fc) omline (hyp (c `(in ,x ,w)))))))))))))
                  (define fncl (have (c `(pr Fnc ,g)) uf fl))
                  ;; Dom(g,w)
                  (define ud (unfold 'Dom (list g w)))
                  (define da (fresh!))
                  (define exb (c (let ([b2 (fresh-sym 'b)]) `(ex ,b2 (pr App ,g ,da ,b2)))))
                  (define dl
                    (allI da (c `(imp (in ,da ,w) (core ,exb)))
                          (lambda ()
                            (intro (c `(in ,da ,w)) exb
                                   (lambda ()
                                     (cond
                                       [(eq? kind 'add)
                                        (define se (U 'SucEx (list da)))
                                        (define s (fresh!))
                                        (exE se (ex-body (line se)) s exb
                                             (lambda ()
                                               (have exb (spec 'SucW (list w da s)) omline (ch2 da s) (exI s (ex-body exb)))))]
                                       [else
                                        (define tl (U '(Tot add) (list w da x)))
                                        (define tf (c (let ([z (fresh-sym 'z)]) `(ex ,z (and (in ,z ,w) ,(add-f da x z))))))
                                        (define te (have tf tl omline (hyp (c `(in ,x ,w)))))
                                        (define zv (fresh!))
                                        (exE te (ex-body tf) zv exb
                                             (lambda ()
                                               (have exb (ch2 da zv) (exI zv (ex-body exb)))))]))))))
                  (define doml (have (c `(pr Dom ,g ,w)) ud dl))
                  ;; Rng(g,w) and forall a b (App(g,a,b) -> R(a,b))
                  (define ur (unfold 'Rng (list g w)))
                  (define ra (fresh!)) (define rb (fresh!))
                  (define rngb (def-body ur))
                  (define rl
                    (allI ra (ren (scons ra sid) (match rngb [(list 'A x) x]))
                          (lambda ()
                            (allI rb (c `(imp (pr App ,g ,ra ,rb) (in ,rb ,w)))
                                  (lambda () (have (c `(imp (pr App ,g ,ra ,rb) (in ,rb ,w))) (ch1-at ra rb)))))))
                  (define rngl (have (c `(pr Rng ,g ,w)) ur rl))
                  (define qa (fresh!)) (define qb (fresh!))
                  (define rcl
                    (allI qa (c (let ([b2 (fresh-sym 'b)]) `(all ,b2 (imp (pr App ,g ,qa ,b2) ,(rel kind x qa b2)))))
                          (lambda ()
                            (allI qb (c `(imp (pr App ,g ,qa ,qb) ,(rel kind x qa qb)))
                                  (lambda () (have (c `(imp (pr App ,g ,qa ,qb) ,(rel kind x qa qb))) (ch1-at qa qb)))))))
                  (define gb (c (graph-body kind g w x)))
                  (have goal fncl doml rngl rcl (exI g (ex-body goal))))))))
  (finish-lemma! res 2))


;; ---- (Rec k): vars w=0 x=1
(defgen Rec (key)
  (define kind (cadr key))
  (define w 0) (define x 1)
  (start-lemma! key 2 (list `(pr Om ,w) `(in ,x ,w)))
  (define omline (hyp (c `(pr Om ,w))))
  (define xin (hyp (c `(in ,x ,w))))
  (define goal (c (let ([F (fresh-sym 'F)]) `(ex ,F ,(rec-body kind F w x)))))
  (define gl (U `(Graph ,kind) (list w x)))
  (define gf (c (let ([g (fresh-sym 'g)]) `(ex ,g ,(graph-body kind g w x)))))
  (define g (fresh!))
  (define (with-base thunk)          ; thunk: a0 -> line;  for mul a0 is an empty set from H:EmpEx
    (cond [(eq? kind 'add) (thunk x)]
          [else (define el (U 'EmpEx (list w)))
                (define e (fresh!))
                (exE (have (concl el) el omline) (ex-body (concl el)) e goal (lambda () (thunk e)))]))
  (define res
    (exE (have gf gl omline xin) (ex-body gf) g goal
         (lambda ()
           (define gparts (map c (let ([a (fresh-sym 'a)] [b (fresh-sym 'b)])
                                   (list `(pr Fnc ,g) `(pr Dom ,g ,w) `(pr Rng ,g ,w) `(all ,a (all ,b (imp (pr App ,g ,a ,b) ,(rel kind x a b))))))))
           (with-base
            (lambda (a0)
              (define a0in (if (eq? kind 'add) xin (have (c `(in ,a0 ,w)) (spec 'ZeroW (list w a0)) omline)))
              (define rt (spec 'RecThm (list w g w a0)))
              (define exF (c (let ([F (fresh-sym 'F)]) `(ex ,F (pr RecG ,F ,w ,g ,w ,a0)))))
              (define F (fresh!))
              (exE (have exF rt omline a0in) (ex-body exF) F goal
                   (lambda ()
                     (define up (unfold 'RecG (list F w g w a0)))
                     (define pb (def-body up))
                     ;; pb = ((Fnc F & Dom(F,w)) & (Rng(F,w) & base)) & step
                     (define-values (p-fnc p-dom p-rng p-base p-step)
                       (match pb [(list 'N (list 'I (list 'N (list 'I (list 'N (list 'I fnc (list 'N dom))) (list 'N (list 'N (list 'I rng (list 'N bas)))))) (list 'N st)))
                                  (values fnc dom rng bas st)]))
                     (define pl (have pb up))
                     (define parts (map c (rec-parts kind F w x)))
                     (define base-line
                       (if (eq? kind 'add) (have (list-ref parts 3) pl)
                           (let ([o (fresh!)])
                             (allI o (c `(imp (pr Emp ,o) (pr App ,F ,o ,o)))
                                   (lambda ()
                                     (intro (c `(pr Emp ,o)) (c `(pr App ,F ,o ,o))
                                            (lambda ()
                                              (have (c `(pr App ,F ,o ,o)) pl (inst p-base o) (spec 'EmpUq (list a0 o))
                                                    (leib `(pr App ,F ,o ,HOLE) a0 o)))))))))
                     (define i (fresh!)) (define a (fresh!)) (define j (fresh!)) (define b (fresh!))
                     (define (st-body i a j b) `(imp (and (pr App ,F ,i ,a) (pr Suc ,j ,i) (pr App ,F ,j ,b)) ,(rel kind x a b)))
                     (define step-line
                       (allI i (c (let ([a2 (fresh-sym 'a)] [j2 (fresh-sym 'j)] [b2 (fresh-sym 'b)]) `(all ,a2 (all ,j2 (all ,b2 ,(st-body i a2 j2 b2))))))
                             (lambda ()
                               (allI a (c (let ([j2 (fresh-sym 'j)] [b2 (fresh-sym 'b)]) `(all ,j2 (all ,b2 ,(st-body i a j2 b2)))))
                                     (lambda ()
                                       (allI j (c (let ([b2 (fresh-sym 'b)]) `(all ,b2 ,(st-body i a j b2))))
                                             (lambda ()
                                               (allI b (c (st-body i a j b))
                                                     (lambda ()
                                                       (intro (c `(and (pr App ,F ,i ,a) (pr Suc ,j ,i) (pr App ,F ,j ,b))) (c (rel kind x a b))
                                                              (lambda ()
                                                                (define ain (have (c `(in ,a ,w)) pl (spec 'RngApp (list F w i a))))
                                                                (define exc (c (let ([c2 (fresh-sym 'c)]) `(ex ,c2 (pr App ,g ,a ,c2)))))
                                                                (define cv (fresh!))
                                                                (exE (have exc ain (spec 'TotApp (list g w a))) (ex-body exc) cv (c (rel kind x a b))
                                                                     (lambda ()
                                                                       (have (c (rel kind x a b)) pl (inst* p-step (list i a j cv))
                                                                             (spec 'FncApp (list F j b cv))
                                                                             (inst* (list-ref gparts 3) (list a cv))
                                                                             (leib `(not ,(rel kind x a HOLE)) b cv)))))))))))))))
                     (have goal pl base-line step-line (exI F (ex-body goal))))))))))
  (finish-lemma! res 2))

;; ---- (FinOfRec k): vars w=0 x=1 F=2 y=3 z=4
(defgen FinOfRec (key)
  (define kind (cadr key))
  (define w 0) (define x 1) (define F 2) (define y 3) (define z 4)
  (start-lemma! key 5 (list `(pr Om ,w) (rec-body kind F w x) `(in ,y ,w) `(pr App ,F ,y ,z)))
  (define omline (hyp (c `(pr Om ,w))))
  (define parts (map c (rec-parts kind F w x)))
  (define goal (c (fin-f kind x y z)))
  (define fparts (map c (fin-parts kind F x y z)))
  ;; P3: forall i (i in y -> exists a App(F,i,a))
  (define i (fresh!))
  (define (p3b i) (let ([a (fresh-sym 'a)]) `(imp (in ,i ,y) (ex ,a (pr App ,F ,i ,a)))))
  (define p3
    (allI i (c (p3b i))
          (lambda () (have (c (p3b i)) omline (hyp (c `(in ,y ,w))) (spec 'OmTr (list w y)) (U 'SubE (list y w i))
                           (spec 'TotApp (list F w i))))))
  (define i2 (fresh!)) (define j (fresh!)) (define a (fresh!)) (define b (fresh!))
  (define (p4b i j a b) `(imp (and (in ,i ,y) (pr Suc ,j ,i) (pr App ,F ,i ,a) (pr App ,F ,j ,b)) ,(rel kind x a b)))
  (define p4
    (allI i2 (c (let ([j2 (fresh-sym 'j)] [a2 (fresh-sym 'a)] [b2 (fresh-sym 'b)]) `(all ,j2 (all ,a2 (all ,b2 ,(p4b i2 j2 a2 b2))))))
          (lambda ()
            (allI j (c (let ([a2 (fresh-sym 'a)] [b2 (fresh-sym 'b)]) `(all ,a2 (all ,b2 ,(p4b i2 j a2 b2)))))
                  (lambda ()
                    (allI a (c (let ([b2 (fresh-sym 'b)]) `(all ,b2 ,(p4b i2 j a b2))))
                          (lambda ()
                            (allI b (c (p4b i2 j a b))
                                  (lambda () (have (c (p4b i2 j a b)) (inst* (list-ref parts 4) (list i2 a j b))))))))))))
  (define res (have goal p3 p4 (exI F (ex-body goal))))
  (finish-lemma! res 5))

;; ---- (Tot k): vars w=0 x=1 y=2
(define (tot-f kind w x y) (let ([z (fresh-sym 'z)]) `(ex ,z (and (in ,z ,w) ,(fin-f kind x y z)))))
(define (with-rec kind w x goal thunk)        ; ctx has Om(w), x in w; thunk: F -> line proving goal with RecBody(F)
  (define rl (U `(Rec ,kind) (list w x)))
  (define rf (c (let ([F (fresh-sym 'F)]) `(ex ,F ,(rec-body kind F w x)))))
  (define F (fresh!))
  (exE (have rf rl) (ex-body rf) F goal (lambda () (thunk F))))
(defgen Tot (key)
  (define kind (cadr key))
  (define w 0) (define x 1) (define y 2)
  (start-lemma! key 3 (list `(pr Om ,w) `(in ,x ,w) `(in ,y ,w)))
  (define goal (c (tot-f kind w x y)))
  (define res
    (with-rec kind w x goal
              (lambda (F)
                (define exz (c (let ([z (fresh-sym 'z)]) `(ex ,z (pr App ,F ,y ,z)))))
                (define zv (fresh!))
                (exE (have exz (spec 'TotApp (list F w y))) (ex-body exz) zv goal
                     (lambda ()
                       (have goal (spec 'RngApp (list F w y zv)) (U `(FinOfRec ,kind) (list w x F y zv))
                             (exI zv (ex-body goal))))))))
  (finish-lemma! res 3))

;; ---- (Zero k): vars w=0 x=1 o=2
(defgen Zero (key)
  (define kind (cadr key))
  (define w 0) (define x 1) (define o 2)
  (start-lemma! key 3 (list `(pr Om ,w) `(in ,x ,w) `(pr Emp ,o)))
  (define bv (base-of kind x o))
  (define goal (c (fin-f kind x o bv)))
  (define res
    (with-rec kind w x goal
              (lambda (F)
                (define parts (map c (rec-parts kind F w x)))
                (have goal (spec 'ZeroW (list w o)) (inst (list-ref parts 3) o) (U `(FinOfRec ,kind) (list w x F o bv))))))
  (finish-lemma! res 3))

;; ---- (Step k): vars w=0 x=1 y=2 z=3 s=4 z'=5
(defgen Step (key)
  (define kind (cadr key))
  (define w 0) (define x 1) (define y 2) (define z 3) (define s 4) (define z2 5)
  (start-lemma! key 6 (list `(pr Om ,w) `(in ,x ,w) `(in ,y ,w) (fin-f kind x y z) `(pr Suc ,s ,y) (rel kind x z z2)))
  (define goal (c (fin-f kind x s z2)))
  (define res
    (with-rec kind w x goal
              (lambda (F)
                (define parts (map c (rec-parts kind F w x)))
                (define exc (c (let ([z (fresh-sym 'c)]) `(ex ,z (pr App ,F ,y ,z)))))
                (define cv (fresh!))
                (exE (have exc (spec 'TotApp (list F w y))) (ex-body exc) cv goal
                     (lambda ()
                       (define fy (have (c (fin-f kind x y cv)) (U `(FinOfRec ,kind) (list w x F y cv))))
                       (define ceq (have (c `(eq ,cv ,z)) fy (uq-line kind w x y cv z)))
                       (define sin (have (c `(in ,s ,w)) (spec 'SucW (list w y s))))
                       (define exd (c (let ([d (fresh-sym 'd)]) `(ex ,d (pr App ,F ,s ,d)))))
                       (define dv (fresh!))
                       (exE (have exd sin (spec 'TotApp (list F w s))) (ex-body exd) dv goal
                            (lambda ()
                              (have goal (inst* (list-ref parts 4) (list y cv s dv)) ceq
                                    (leib (rel kind x HOLE dv) cv z) (rel-uq kind w x z z2 dv)
                                    sin (U `(FinOfRec ,kind) (list w x F s dv))
                                    (leib `(not ,(fin-f kind x s HOLE)) z2 dv)))))))))
  (finish-lemma! res 6))

;; ---- (InW k): vars w=0 x=1 y=2 z=3
(defgen InW (key)
  (define kind (cadr key))
  (define w 0) (define x 1) (define y 2) (define z 3)
  (start-lemma! key 4 (list `(pr Om ,w) `(in ,x ,w) `(in ,y ,w) (fin-f kind x y z)))
  (define goal (c `(in ,z ,w)))
  (define tf (c (tot-f kind w x y)))
  (define zv (fresh!))
  (define res
    (exE (have tf (U `(Tot ,kind) (list w x y))) (ex-body tf) zv goal
         (lambda ()
           (have goal (uq-line kind w x y z zv) (leib `(not (in ,HOLE ,w)) z zv)))))
  (finish-lemma! res 4))
