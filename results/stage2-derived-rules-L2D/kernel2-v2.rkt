;; kernel2-v2.rkt (kernel2-v1.rkt requiring kernel-v6 without its ids, which core-v1 also provides) -- lane L2D: more arithmetic on omega (commutativity and associativity of Ad; Mu: existence,
;; uniqueness, recursion equations, range; distributivity), over kernel-v6.rkt. Not trusted; checked step by step by
;; core-v1's copy of the checker, then by the judges.
(require racket/list racket/match (file "C:/ClaudeOutput/pompetzki/lanes/L2D/core-v1.rkt")
         (file "C:/ClaudeOutput/pompetzki/lanes/L2D/nd-v3.rkt")
         (except-in (file "C:/ClaudeOutput/pompetzki/lanes/L2D/kernel-v6.rkt") ids))
(provide (all-defined-out))

;; generic: in context k prove  forall v1..vn (h1 -> ... -> hm -> c)  as the formula (phi-of ...) expects.
;; vars: number of fresh variables; hyps: (vars) -> list of formulas; con: (vars) -> formula;
;; body: (k2 vars) -> fact con in k2 = k + hyps.  goal: the target formula (ac language) for the final have.
(define (close-all k nv hyps con body goal)
  (define vs (for/list ([i nv]) (fresh!)))
  (define hs (apply hyps vs))
  (define k2 (apply cx+ k hs))
  (define r (apply body k2 vs))
  (define f (have k `(imp ,@hs ,(apply con vs)) r))
  (define g (for/fold ([cur f]) ([v (reverse vs)]) (all-i k v cur)))
  (have k goal g))

(define (lemma-fact k key . sig) (cons-of k (U key (append '(0 1 2 3) sig))))
(define (l0 k y . ls) (have k (Ad 3 y y) (all-e k (lemma-fact k 'KL0) y) ls))

;; ------------------------------------------------------------------ commutativity
(define (comm-phi v) (let ([x (gs 'x)] [z (gs 'z)]) `(all ,x ,z (imp (in ,x 0) ,(Ad x v z) ,(Ad v x z)))))
(defkey KComm (key)
  (begin-thm! key 4)
  (define k (kctx))
  (induct k comm-phi
    (lambda (k)
      (close-all k 2 (lambda (x z) (list `(in ,x 0) (Ad x 3 z))) (lambda (x z) (Ad 3 x z))
        (lambda (k2 x z)
          (define zx (add-uq k2 x 3 z x (zerow k2 3) (add-z k2 x)))
          (have k2 (Ad 3 x z) (l0 k2 x) zx (leibF `(not ,(Ad 3 x LHOLE)) z x)))
        (comm-phi 3)))
    (lambda (k d t lphi)
      (close-all k 2 (lambda (x z) (list `(in ,x 0) (Ad x t z))) (lambda (x z) (Ad t x z))
        (lambda (k2 x z)
          (define tw (sucw k2 d t))
          (ex-e k2 (add-ex k2 x d)
            (lambda (k3 z0)
              (ex-e k3 (suc-ex k3 z0)
                (lambda (k4 s1)
                  (define a1 (add-s k4 x d z0 t s1))
                  (define zs (add-uq k4 x t z s1 tw a1))
                  (define ih (have k4 (Ad d x z0) (all-e k4 lphi x z0)))
                  (define l1 (all-e k4 (lemma-fact k4 'KL1) x))
                  (define l1b (have k4 (rhs-of (concl k4 l1)) l1))
                  (define a2 (have k4 (Ad t x s1) (all-e k4 l1b d z0 t s1) ih))
                  (have k4 (Ad t x z) a2 zs (leibF `(not ,(Ad t x LHOLE)) z s1)))))))
        (comm-phi t))))
  (define yy (gs 'y))
  (end-thm! (ac `(imp ,CTX-DSL (all ,yy (imp (in ,yy 0) ,(comm-phi yy))))) (ids 4)))

;; ------------------------------------------------------------------ associativity: (x+y)+z = v, y+z = s => x+s = v
(define (assoc-phi zz)
  (define-values (x y u v s) (values (gs 'x) (gs 'y) (gs 'u) (gs 'v) (gs 's)))
  `(all ,x ,y ,u ,v ,s (imp (in ,x 0) (in ,y 0) ,(Ad x y u) ,(Ad u zz v) ,(Ad y zz s) ,(Ad x s v))))
(defkey KAssoc (key)
  (begin-thm! key 4)
  (define k (kctx))
  (define (hy zz) (lambda (x y u v s) (list `(in ,x 0) `(in ,y 0) (Ad x y u) (Ad u zz v) (Ad y zz s))))
  (define (cn x y u v s) (Ad x s v))
  (induct k assoc-phi
    (lambda (k)
      (close-all k 5 (hy 3) cn
        (lambda (k2 x y u v s)
          (define ow (zerow k2 3))
          (define uw (add-w k2 x y u))
          (define vu (add-uq k2 u 3 v u ow (add-z k2 u uw)))
          (define sy (add-uq k2 y 3 s y ow (add-z k2 y)))
          (define a1 (have k2 (Ad x s u) sy (leibF `(not ,(Ad x LHOLE u)) s y)))
          (have k2 (Ad x s v) a1 vu (leibF `(not ,(Ad x s LHOLE)) v u)))
        (assoc-phi 3)))
    (lambda (k d t lphi)
      (close-all k 5 (hy t) cn
        (lambda (k2 x y u v s)
          (define tw (sucw k2 d t))
          (define uw (add-w k2 x y u))
          (ex-e k2 (add-ex k2 u d uw)
            (lambda (k3 v0)
              (ex-e k3 (add-ex k3 y d)
                (lambda (k4 s0)
                  (ex-e k4 (suc-ex k4 v0)
                    (lambda (k5 v1)
                      (ex-e k5 (suc-ex k5 s0)
                        (lambda (k6 s1)
                          (define vv (add-uq k6 u t v v1 tw (add-s k6 u d v0 t v1)))
                          (define ss (add-uq k6 y t s s1 tw (add-s k6 y d s0 t s1)))
                          (define ih (have k6 (Ad x s0 v0) (all-e k6 lphi x y u v0 s0)))
                          (define s0w (add-w k6 y d s0))
                          (define a2 (add-s k6 x s0 v0 s1 v1 ih s0w))
                          (define a3 (have k6 (Ad x s v1) a2 ss (leibF `(not ,(Ad x LHOLE v1)) s s1)))
                          (have k6 (Ad x s v) a3 vv (leibF `(not ,(Ad x s LHOLE)) v v1)))))))))))
        (assoc-phi t))))
  (define zz (gs 'z))
  (end-thm! (ac `(imp ,CTX-DSL (all ,zz (imp (in ,zz 0) ,(assoc-phi zz))))) (ids 4)))

