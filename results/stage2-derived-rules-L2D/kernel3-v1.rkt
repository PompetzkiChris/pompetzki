#lang racket/base
;; kernel3-v1.rkt -- lane L2D: multiplication on omega (Mu: existence, uniqueness, x*0 = 0, x*S(y) = x + x*y, range)
;; and distributivity x*(y+z) = x*y + x*z, over kernel-v6.rkt and kernel2-v2.rkt. Not trusted; checked step by step by
;; core-v1's copy of the checker, then by the judges.
(require racket/list racket/match (file "C:/ClaudeOutput/pompetzki/lanes/L2D/core-v1.rkt")
         (file "C:/ClaudeOutput/pompetzki/lanes/L2D/nd-v3.rkt")
         (except-in (file "C:/ClaudeOutput/pompetzki/lanes/L2D/kernel-v6.rkt") ids)
         (except-in (file "C:/ClaudeOutput/pompetzki/lanes/L2D/kernel2-v2.rkt") ids))
(provide (all-defined-out))

;; Rec(e,w,f,a,c) by fact hl in k: the five parts with Tot and Rng as atoms
(define (rec-atoms k hl e w f a c)
  (define d (defn 'Rec (list e w f a c)))
  (define body (def-rhs d))
  (define-values (b1 stp) (kparts body))
  (define-values (b2 b3) (kparts b1))
  (define-values (fnc tot) (kparts b2))
  (define-values (rng zer) (kparts b3))
  (values (have k fnc hl d) (have k tot hl d) (have k rng hl d) (have k zer hl d) (have k stp hl d)))
(define (gtot) (use (rp 128) '(1 0 2)))               ; Pr & CapS -> Tot(g,w)
;; a1, a2 both Rec(.,w,g,w,x): forall i in w forall v (App(a1,i,v) <-> App(a2,i,v)), instantiated at i, v
(define (agree k a1 a2 x h1 h2 i v . ls)
  (define un (use (rp 133) (list 0 2 0 a1 x a2)))
  (define u2 (have k (rhs-of (line un)) un (gtot) h1 h2))
  (define u3 (all-e k u2 i))
  (define u4 (have k (rhs-of (concl k u3)) u3 ls))
  (all-e k u4 v))

(define (Mu-in m x y z) (let ([a (gs 'a)]) `(ex ,a (and (and (pr Rec ,a 0 2 0 ,x) (pr Rec ,m 0 ,a 0 3)) (pr App ,m ,y ,z)))))
;; Mu(x,y,z) from facts Rec(a,..x), Rec(m,..a..), App(m,y,z)
(define (mu-pack k m a x y z . ls)
  (define b (have k `(and (and (pr Rec ,a 0 2 0 ,x) (pr Rec ,m 0 ,a 0 3)) (pr App ,m ,y ,z)) ls))
  (define i (ex-i k b a (Mu-in m x y z)))
  (ex-i k i m (Mu x y z)))
;; unpack Mu(x,y,z) (fact l): body receives (k3 m a)
(define (mu-unpack k l body)
  (ex-e k l (lambda (k2 m) (ex-e k2 (have k2 (last (cx-hyps k2))) (lambda (k3 a) (body k3 m a))))))

;; KRecMul: Ctx -> (Rec(a,w,g,w,x) -> exists m Rec(m,w,a,w,o))      a = 4, x = 5
(defkey KRecMul (key)
  (begin-thm! key 6)
  (define-values (a x) (values 4 5))
  (define k (cx+ (kctx) `(pr Rec ,a 0 2 0 ,x)))
  (define hl (have k `(pr Rec ,a 0 2 0 ,x)))
  (define-values (fnc tot rng zer stp) (rec-atoms k hl a 0 2 0 x))
  (define r (use (rp 95) '() 0 a 0 3))
  (define res (have k `(ex m (pr Rec m 0 ,a 0 3)) r fnc tot rng (zerow k 3)))
  (define fin `(imp (pr Rec ,a 0 2 0 ,x) (ex m (pr Rec m 0 ,a 0 3))))
  (have (kctx) fin res)
  (end-thm! (ac `(imp ,CTX-DSL ,fin)) (ids 6)))

;; KRecTr: Ctx -> (Rec(a1,w,g,w,x) -> Rec(a2,w,g,w,x) -> Rec(m,w,a2,w,o) -> Rec(m,w,a1,w,o))   a1=4 a2=5 x=6 m=7
(defkey KRecTr (key)
  (begin-thm! key 8)
  (define-values (a1 a2 x m) (values 4 5 6 7))
  (define k (cx+ (kctx) `(pr Rec ,a1 0 2 0 ,x) `(pr Rec ,a2 0 2 0 ,x) `(pr Rec ,m 0 ,a2 0 3)))
  (define h1 (have k `(pr Rec ,a1 0 2 0 ,x)))
  (define h2 (have k `(pr Rec ,a2 0 2 0 ,x)))
  (define hm (have k `(pr Rec ,m 0 ,a2 0 3)))
  (define-values (fnc tot rng zer stp) (rec-atoms k hm m 0 a2 0 3))
  (define rngu (unf k 'Rng (list m 0) rng))
  (define d (defn 'Rec (list m 0 a1 0 3)))
  (define-values (b1 stp1) (kparts (def-rhs d)))
  ;; the step clause with a1
  (define-values (d1 d2 d3 d4) (values (fresh!) (fresh!) (fresh!) (fresh!)))
  (define k2 (cx+ k `(pr App ,m ,d1 ,d2) `(pr Suc ,d3 ,d1) `(pr App ,a1 ,d2 ,d4)))
  (define d2w (have k2 `(in ,d2 0) (all-e k2 rngu d1 d2)))
  (define ag (agree k2 a1 a2 x h1 h2 d2 d4 d2w))
  (define s1 (have k2 `(pr App ,m ,d3 ,d4) ag (all-e k2 stp d1 d2 d3 d4)))
  (define s2 (have k `(imp (and (and (pr App ,m ,d1 ,d2) (pr Suc ,d3 ,d1)) (pr App ,a1 ,d2 ,d4)) (pr App ,m ,d3 ,d4)) s1))
  (define s3 (all-i k d1 (all-i k d2 (all-i k d3 (all-i k d4 s2)))))
  (unless (equal? (concl k s3) stp1) (error 'KRecTr "step clause ~a vs ~a" (show (concl k s3)) (show stp1)))
  (define res (have k `(pr Rec ,m 0 ,a1 0 3) d fnc tot rng zer s3))
  (define fin `(imp (pr Rec ,a1 0 2 0 ,x) (pr Rec ,a2 0 2 0 ,x) (pr Rec ,m 0 ,a2 0 3) (pr Rec ,m 0 ,a1 0 3)))
  (have (kctx) fin res)
  (end-thm! (ac `(imp ,CTX-DSL ,fin)) (ids 8)))

;; KMulEx: Ctx -> (x in w -> y in w -> exists z (z in w & Mu(x,y,z)))     x = 4, y = 5
(defkey KMulEx (key)
  (begin-thm! key 6)
  (define-values (x y) (values 4 5))
  (define k (cx+ (kctx) `(in ,x 0) `(in ,y 0)))
  (define goal `(ex z (and (in z 0) ,(Mu x y 'z))))
  (define res
    (ex-e k (have k `(ex e (pr Rec e 0 2 0 ,x)) (U 'KRecAdd (list 0 1 2 3 x)))
      (lambda (k2 a)
        (define ha (have k2 `(pr Rec ,a 0 2 0 ,x)))
        (ex-e k2 (have k2 `(ex m (pr Rec m 0 ,a 0 3)) (U 'KRecMul (list 0 1 2 3 a x)) ha)
          (lambda (k3 m)
            (define hm (have k3 `(pr Rec ,m 0 ,a 0 3)))
            (define-values (fnc tot rng zer stp) (rec-parts k3 hm m 0 a 0 3))
            (ex-e k3 (have k3 `(ex z (pr App ,m ,y z)) (all-e k3 tot y))
              (lambda (k4 z)
                (define zw (have k4 `(in ,z 0) (all-e k4 rng y z)))
                (define mu (mu-pack k4 m a x y z ha hm))
                (ex-i k4 (have k4 `(and (in ,z 0) ,(Mu x y z)) mu zw) z goal))))))))
  (define fin `(imp (in ,x 0) (in ,y 0) ,goal))
  (have (kctx) fin res)
  (end-thm! (ac `(imp ,CTX-DSL ,fin)) (ids 6)))

;; KMulUq: Ctx -> (y in w -> Mu(x,y,z) -> Mu(x,y,u) -> z = u)       x=4 y=5 z=6 u=7
(defkey KMulUq (key)
  (begin-thm! key 8)
  (define-values (x y z u) (values 4 5 6 7))
  (define k (cx+ (kctx) `(in ,y 0) (Mu x y z) (Mu x y u)))
  (define res
    (mu-unpack k (have k (Mu x y z))
      (lambda (k2 m1 a1)
        (mu-unpack k2 (have k2 (Mu x y u))
          (lambda (k3 m2 a2)
            (define ha1 (have k3 `(pr Rec ,a1 0 2 0 ,x)))
            (define ha2 (have k3 `(pr Rec ,a2 0 2 0 ,x)))
            (define hm1 (have k3 `(pr Rec ,m1 0 ,a1 0 3)))
            (define hm2 (have k3 `(pr Rec ,m2 0 ,a2 0 3)))
            (define hm2b (have k3 `(pr Rec ,m2 0 ,a1 0 3) (U 'KRecTr (list 0 1 2 3 a1 a2 x m2)) ha1 ha2 hm2))
            (define-values (fnca tota rnga zera stpa) (rec-atoms k3 ha1 a1 0 2 0 x))
            (define-values (fncm totm rngm zerm stpm) (rec-atoms k3 hm1 m1 0 a1 0 3))
            (define un (use (rp 133) (list 0 a1 0 m1 3 m2)))
            (define u2 (have k3 (rhs-of (line un)) un tota hm1 hm2b))
            (define u3 (all-e k3 u2 y))
            (define u4 (have k3 (rhs-of (concl k3 u3)) u3))
            (define u5 (all-e k3 u4 u))
            (have k3 `(eq ,z ,u) u5 fncm (use (rp 16) '() m1 y z u))))))))
  (define fin `(imp (in ,y 0) ,(Mu x y z) ,(Mu x y u) (eq ,z ,u)))
  (have (kctx) fin res)
  (end-thm! (ac `(imp ,CTX-DSL ,fin)) (ids 8)))

;; KMulZ: Ctx -> (x in w -> Mu(x,o,o))       x = 4
(defkey KMulZ (key)
  (begin-thm! key 5)
  (define x 4)
  (define k (cx+ (kctx) `(in ,x 0)))
  (define res
    (ex-e k (have k `(ex e (pr Rec e 0 2 0 ,x)) (U 'KRecAdd (list 0 1 2 3 x)))
      (lambda (k2 a)
        (define ha (have k2 `(pr Rec ,a 0 2 0 ,x)))
        (ex-e k2 (have k2 `(ex m (pr Rec m 0 ,a 0 3)) (U 'KRecMul (list 0 1 2 3 a x)) ha)
          (lambda (k3 m)
            (define hm (have k3 `(pr Rec ,m 0 ,a 0 3)))
            (define-values (fnc tot rng zer stp) (rec-parts k3 hm m 0 a 0 3))
            (define z1 (have k3 `(pr App ,m 3 3) (all-e k3 zer 3)))
            (mu-pack k3 m a x 3 3 ha hm z1))))))
  (define fin `(imp (in ,x 0) ,(Mu x 3 3)))
  (have (kctx) fin res)
  (end-thm! (ac `(imp ,CTX-DSL ,fin)) (ids 5)))

;; KMulW: Ctx -> (Mu(x,y,z) -> z in w)       x=4 y=5 z=6
(defkey KMulW (key)
  (begin-thm! key 7)
  (define-values (x y z) (values 4 5 6))
  (define k (cx+ (kctx) (Mu x y z)))
  (define res
    (mu-unpack k (have k (Mu x y z))
      (lambda (k3 m a)
        (define hm (have k3 `(pr Rec ,m 0 ,a 0 3)))
        (define-values (fnc tot rng zer stp) (rec-parts k3 hm m 0 a 0 3))
        (have k3 `(in ,z 0) (all-e k3 rng y z)))))
  (define fin `(imp ,(Mu x y z) (in ,z 0)))
  (have (kctx) fin res)
  (end-thm! (ac `(imp ,CTX-DSL ,fin)) (ids 7)))

;; KMulS: Ctx -> (y in w -> Mu(x,y,z) -> Suc(y1,y) -> Ad(x,z,z1) -> Mu(x,y1,z1))     x=4 y=5 z=6 y1=7 z1=8
(defkey KMulS (key)
  (begin-thm! key 9)
  (define-values (x y z y1 z1) (values 4 5 6 7 8))
  (define k (cx+ (kctx) `(in ,y 0) (Mu x y z) `(pr Suc ,y1 ,y) (Ad x z z1)))
  (define res
    (mu-unpack k (have k (Mu x y z))
      (lambda (k3 m a)
        (define ha (have k3 `(pr Rec ,a 0 2 0 ,x)))
        (define hm (have k3 `(pr Rec ,m 0 ,a 0 3)))
        (define-values (fnc tot rng zer stp) (rec-parts k3 hm m 0 a 0 3))
        (define zw (have k3 `(in ,z 0) (all-e k3 rng y z)))
        (ex-e k3 (have k3 (Ad x z z1))
          (lambda (k4 a2)
            (define ha2 (have k4 `(pr Rec ,a2 0 2 0 ,x)))
            (define ag (agree k4 a a2 x ha ha2 z z1 zw))
            (define ap (have k4 `(pr App ,a ,z ,z1) ag))
            (define s1 (have k4 `(pr App ,m ,y1 ,z1) (all-e k4 stp y z y1 z1) ap))
            (mu-pack k4 m a x y1 z1 ha hm s1))))))
  (define fin `(imp (in ,y 0) ,(Mu x y z) (pr Suc ,y1 ,y) ,(Ad x z z1) ,(Mu x y1 z1)))
  (have (kctx) fin res)
  (end-thm! (ac `(imp ,CTX-DSL ,fin)) (ids 9)))

(define (mul-ex k x y . ls) (have k `(ex z (and (in z 0) ,(Mu x y 'z))) (U 'KMulEx (list 0 1 2 3 x y)) ls))
(define (mul-uq k x y z u . ls) (have k `(eq ,z ,u) (U 'KMulUq (list 0 1 2 3 x y z u)) ls))
(define (mul-z k x . ls) (have k (Mu x 3 3) (U 'KMulZ (list 0 1 2 3 x)) ls))
(define (mul-w k x y z . ls) (have k `(in ,z 0) (U 'KMulW (list 0 1 2 3 x y z)) ls))
(define (mul-s k x y z y1 z1 . ls) (have k (Mu x y1 z1) (U 'KMulS (list 0 1 2 3 x y z y1 z1)) ls))
;; comm: Ad(x,y,z) -> Ad(y,x,z)  (x, y in w);  assoc: Ad(x,y,u), Ad(u,z,v), Ad(y,z,s) -> Ad(x,s,v)  (x, y, z in w)
(define (add-comm k x y z . ls)
  (define f (all-e k (lemma-fact k 'KComm) y))
  (have k (Ad y x z) (all-e k (have k (rhs-of (concl k f)) f ls) x z) ls))
(define (add-assoc k x y zz u v s . ls)
  (define f (all-e k (lemma-fact k 'KAssoc) zz))
  (have k (Ad x s v) (all-e k (have k (rhs-of (concl k f)) f ls) x y u v s) ls))

;; ------------------------------------------------------------------ distributivity
;; phi(zz) = forall x y s p q r (x in w -> y in w -> Ad(y,zz,s) -> Mu(x,y,p) -> Mu(x,zz,q) -> Ad(p,q,r) -> Mu(x,s,r))
(define (dist-phi zz)
  (define-values (x y s p q r) (values (gs 'x) (gs 'y) (gs 's) (gs 'p) (gs 'q) (gs 'r)))
  `(all ,x ,y ,s ,p ,q ,r (imp (in ,x 0) (in ,y 0) ,(Ad y zz s) ,(Mu x y p) ,(Mu x zz q) ,(Ad p q r) ,(Mu x s r))))
(defkey KDist (key)
  (begin-thm! key 4)
  (define k (kctx))
  (define (hy zz) (lambda (x y s p q r) (list `(in ,x 0) `(in ,y 0) (Ad y zz s) (Mu x y p) (Mu x zz q) (Ad p q r))))
  (define (cn x y s p q r) (Mu x s r))
  (induct k dist-phi
    (lambda (k)
      (close-all k 6 (hy 3) cn
        (lambda (k2 x y s p q r)
          (define ow (zerow k2 3))
          (define sy (add-uq k2 y 3 s y ow (add-z k2 y)))
          (define qo (mul-uq k2 x 3 q 3 ow (mul-z k2 x)))
          (define pw (mul-w k2 x y p))
          (define apo (have k2 (Ad p 3 r) qo (leibF `(not ,(Ad p LHOLE r)) q 3)))
          (define rp1 (add-uq k2 p 3 r p ow apo (add-z k2 p pw)))
          (define m1 (have k2 (Mu x s p) sy (leibF `(not ,(Mu x LHOLE p)) s y)))
          (have k2 (Mu x s r) m1 rp1 (leibF `(not ,(Mu x s LHOLE)) r p)))
        (dist-phi 3)))
    (lambda (k d t lphi)
      (close-all k 6 (hy t) cn
        (lambda (k2 x y s p q r)
          (define tw (sucw k2 d t))
          (define pw (mul-w k2 x y p))
          (ex-e k2 (add-ex k2 y d)
            (lambda (k3 s0)
              (ex-e k3 (suc-ex k3 s0)
                (lambda (k4 s1)
                  (define ss (add-uq k4 y t s s1 tw (add-s k4 y d s0 t s1)))
                  (ex-e k4 (mul-ex k4 x d)
                    (lambda (k5 q0)
                      (define q0w (mul-w k5 x d q0))
                      (ex-e k5 (add-ex k5 x q0 q0w)
                        (lambda (k6 q1)
                          (define qq (mul-uq k6 x t q q1 tw (mul-s k6 x d q0 t q1)))
                          (ex-e k6 (add-ex k6 p q0 pw q0w)
                            (lambda (k7 r0)
                              (define ih (have k7 (Mu x s0 r0) (all-e k7 lphi x y s0 p q0 r0)))
                              (define r0w (add-w k7 p q0 r0))
                              (define s0w (add-w k7 y d s0))
                              (ex-e k7 (add-ex k7 x r0 r0w)
                                (lambda (k8 r1)
                                  (define m1 (mul-s k8 x s0 r0 s1 r1 ih s0w))     ; Mu(x,s1,r1)
                                  (ex-e k8 (add-ex k8 x p pw)
                                    (lambda (k9 h)
                                      (define hw (add-w k9 x p h))
                                      (ex-e k9 (add-ex k9 h q0 hw q0w)
                                        (lambda (k10 v)
                                          (define xr0v (add-assoc k10 x p q0 h v r0 pw q0w))     ; Ad(x,r0,v)
                                          (define r1v (add-uq k10 x r0 r1 v r0w xr0v))           ; r1 = v
                                          (define pxh (add-comm k10 x p h pw))                   ; Ad(p,x,h)
                                          (define pq1v (add-assoc k10 p x q0 h v q1 pw q0w pxh)) ; Ad(p,q1,v)
                                          (define apq1 (have k10 (Ad p q1 r) qq (leibF `(not ,(Ad p LHOLE r)) q q1)))
                                          (define q1w (add-w k10 x q0 q1))
                                          (define rv (add-uq k10 p q1 r v q1w apq1 pq1v))        ; r = v
                                          (define m2 (have k10 (Mu x s r1) m1 ss (leibF `(not ,(Mu x LHOLE r1)) s s1)))
                                          (define m3 (have k10 (Mu x s v) m2 r1v (leibF `(not ,(Mu x s LHOLE)) r1 v)))
                                          (have k10 (Mu x s r) m3 rv (leibF `(not ,(Mu x s LHOLE)) r v)))))))))))))))))))
        (dist-phi t))))
  (define zz (gs 'z))
  (end-thm! (ac `(imp ,CTX-DSL (all ,zz (imp (in ,zz 0) ,(dist-phi zz))))) (ids 4)))

(module+ main
  (load-base!)
  (reset-batch!)
  (define keys (map string->symbol (vector->list (current-command-line-arguments))))
  (for ([kk keys]) (ensure! kk))
  (define text (batch-text))
  (define-values (rg ths) (read-jdg-text text))
  (printf "theorems ~a steps ~a bytes ~a; copy of the checker: ~a\n" (length ths) (for/sum ([t ths]) (length (caddr t))) (string-length text) (check-batch rg ths))
  (for ([kk keys]) (printf "~a: ~a\n" kk (show (reg-stmt (reg-index kk))))))
