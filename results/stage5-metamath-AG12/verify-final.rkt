#lang racket/base
(require racket/file racket/list racket/string
         (prefix-in reg: "registry-reader-v3.rkt")
         (prefix-in proto: "set-extension-prototypes.rkt"))
(define (table path)
  (define lines (file->lines path))
  (define headers (string-split (car lines) "\t" #:trim? #f))
  (for/list ([line (cdr lines)] #:unless (string=? line ""))
    (define cells (string-split line "\t" #:trim? #f))
    (unless (= (length cells) (length headers)) (error 'verify "column count ~a" path))
    (for/hash ([h headers] [c cells]) (values h c))))
(define maps (table "MAP.tsv"))
(define coverage (table "COVERAGE.tsv"))
(define source (table "SOURCE-LABELS.tsv"))
(define extensions (table "EXTENSION-FORMULAS-v2.tsv"))
(define booleans (table "LOGIC-BOOLEAN-CHECK.tsv"))
(define (labels rows) (sort (map (lambda (r) (hash-ref r "label")) rows) string<?))
(unless (and (= (length maps) 167) (= (length source) 167) (= (length extensions) 167)
             (equal? (labels maps) (labels source)) (equal? (labels maps) (labels extensions)))
  (error 'verify "label sets"))
(unless (= (length (remove-duplicates (labels maps))) 167) (error 'verify "duplicate label"))
(define absent (filter (lambda (r) (equal? (hash-ref r "match_class") "no counterpart")) maps))
(unless (= (length absent) 159) (error 'verify "no counterpart count"))
(for ([r absent])
  (unless (and (not (string=? (hash-ref r "extension_new_defining_formula") ""))
               (not (string=? (hash-ref r "extension_new_symbol_typed_counts") ""))
               (not (string=? (hash-ref r "extension_new_symbol_fixed_registry_arity") "")))
    (error 'verify "missing extension data ~a" (hash-ref r "label"))))
(for ([r maps] #:unless (equal? (hash-ref r "match_class") "no counterpart"))
  (define idx (string->number (hash-ref r "registry_index")))
  (unless (and (exact-nonnegative-integer? idx)
               (equal? (hash-ref r "registry_name") (reg:reg-entry-name (reg:registry-ref idx)))
               (equal? (hash-ref r "registry_de_bruijn_prefix")
                       (reg:formula->prefix (reg:reg-entry-formula (reg:registry-ref idx)))))
    (error 'verify "registry identity ~a" (hash-ref r "label"))))
(define previous 0)
(define map-by-label (for/hash ([r maps]) (values (hash-ref r "label") r)))
(define covered 0) (define empty-covered 0) (define syntax 0) (define logical-covered 0)
(for ([r coverage])
  (define order (string->number (hash-ref r "theorem_order")))
  (unless (and (exact-positive-integer? order) (> order previous)) (error 'verify "source order"))
  (set! previous order)
  (define deps (string-split (hash-ref r "required_labels")))
  (define missing
    (filter (lambda (lab) (equal? (hash-ref (hash-ref map-by-label lab) "match_class") "no counterpart")) deps))
  (unless (equal? missing (string-split (hash-ref r "no_counterpart_labels"))) (error 'verify "coverage dependencies"))
  (define ok? (null? missing))
  (unless (equal? (hash-ref r "registry_only_covered") (if ok? "1" "0")) (error 'verify "coverage flag"))
  (when (string-prefix? (hash-ref r "statement") "wff ") (set! syntax (add1 syntax)))
  (when ok?
    (set! covered (add1 covered))
    (when (null? deps) (set! empty-covered (add1 empty-covered)))
    (when (string-prefix? (hash-ref r "statement") "|- ") (set! logical-covered (add1 logical-covered)))))
(define assignments (for/sum ([r booleans]) (string->number (hash-ref r "assignments_checked"))))
(define false-assignments (for/sum ([r booleans]) (string->number (hash-ref r "false_assignments"))))
(unless (and (= (length coverage) 5757) (= covered 22) (= empty-covered 22)
             (= syntax 4) (= logical-covered 18) (= assignments 84) (= false-assignments 0)
             (= (length reg:registry) 677) (= (length proto:prototypes) 11))
  (error 'verify "aggregate totals"))
(call-with-output-file "VERIFY-FINAL.tsv" #:exists 'error
  (lambda (out)
    (displayln "check\tcount\tresult" out)
    (for ([r (list (list "map_source_extension_labels" 167) (list "missing_formulas_and_arities" 159)
                   (list "numbered_registry_identities" 8) (list "coverage_rows_and_order" 5757)
                   (list "covered" 22) (list "covered_with_empty_dependencies" 22)
                   (list "covered_logical" 18) (list "covered_syntax" 4)
                   (list "registry_entries" 677) (list "set_extension_prototypes" 11)
                   (list "boolean_assignments" 84) (list "boolean_false_assignments" 0))])
      (fprintf out "~a\t~a\tPASS\n" (car r) (cadr r)))))
(displayln "PASS:167 labels;159 extension formulas/arities;5757 ordered coverage rows;677 registry entries;11 prototypes;84 boolean assignments")
