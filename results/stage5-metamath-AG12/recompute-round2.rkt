#lang racket/base
(require "round2-core.rkt" racket/file racket/list racket/string)
(define old (table "COVERAGE.tsv"))
(define source (table "CLASS-FREE.tsv"))
(define maps (table "MAP.tsv"))
(define routes (table "ROUTES-2.tsv"))
(define logical-input (table "LOGIC-ROUTES.tsv"))
(define extensions (by-label (table "EXTENSION-FORMULAS-v2.tsv")))
(define mh (by-label maps))
(define rh (by-label routes))
(define registry (for/hash ([r maps] #:unless (string=? (hash-ref r "registry_index") ""))
                   (values (hash-ref r "label") r)))
(unless (and (= (length old) 5757) (= (length source) 5757)
             (= (length maps) 167) (= (length routes) 85) (= (hash-count registry) 8)
             (equal? (sort (hash-keys rh) string<?)
                     (sort (map (lambda (r) (hash-ref r "label")) logical-input) string<?)))
  (error 'coverage "input counts or route labels"))
(define (routed? lab [strict? #f])
  (and (hash-has-key? rh lab)
       (equal? (hash-ref (hash-ref rh lab)
                         (if strict? "full_signature_covered" "covered_by_order")) "1")))
(define (numbered? lab) (hash-has-key? registry lab))
(define outrows '())
(define all-missing (make-hash))
(define groups (make-hash))
(define covered 0)
(define full-covered 0)
(define covered-proof 0)
(define covered-syntax 0)
(define empty-deps 0)
(define first1000-source 0)
(define first1000-cohort 0)
(define newly-covered 0)
(define old-covered 0)
(define previous-order 0)
(define previous-idx -1)
(for ([r old] [s source] [position (in-naturals 1)])
  (define order (string->number (hash-ref r "theorem_order")))
  (define idx (string->number (hash-ref r "assertion_index")))
  (unless (and (exact-positive-integer? order) (> order previous-order)
               (exact-nonnegative-integer? idx) (> idx previous-idx))
    (error 'coverage "source order"))
  (set! previous-order order)
  (set! previous-idx idx)
  (for ([field '("theorem_order" "assertion_index" "theorem" "statement")])
    (unless (equal? (hash-ref r field) (hash-ref s field))
      (error 'coverage "cohort/source field mismatch ~a" field)))
  (define deps (words (hash-ref r "required_labels")))
  (unless (and (= (length deps) (length (remove-duplicates deps)))
               (equal? deps (words (hash-ref s "decoded_dependencies")))
               (equal? (hash-ref s "dependencies_equal") "1")
               (equal? (hash-ref s "decoded_class_free") "1"))
    (error 'coverage "decoded dependency check: ~a" (hash-ref r "theorem")))
  (for ([lab deps]) (unless (hash-has-key? mh lab) (error 'coverage "unknown dependency: ~a" lab)))
  (define numbered (filter numbered? deps))
  (define logical (filter routed? deps))
  (define missing (filter (lambda (lab) (not (or (numbered? lab) (routed? lab)))) deps))
  (define full-missing (filter (lambda (lab) (not (or (numbered? lab) (routed? lab #t)))) deps))
  (define old-missing (filter (lambda (lab) (not (numbered? lab))) deps))
  (unless (and (equal? old-missing (words (hash-ref r "no_counterpart_labels")))
               (equal? (hash-ref r "registry_only_covered") (if (null? old-missing) "1" "0")))
    (error 'coverage "earlier criterion mismatch"))
  (unless (= (length deps) (+ (length numbered) (length logical) (length missing)))
    (error 'coverage "overlapping classification"))
  (when (equal? (hash-ref r "registry_only_covered") "1") (set! old-covered (add1 old-covered)))
  (when (null? full-missing) (set! full-covered (add1 full-covered)))
  (define ok? (null? missing))
  (when ok?
    (set! covered (add1 covered))
    (if (string-prefix? (hash-ref r "statement") "|- ")
        (set! covered-proof (add1 covered-proof))
        (set! covered-syntax (add1 covered-syntax)))
    (when (null? deps) (set! empty-deps (add1 empty-deps)))
    (when (<= order 1000) (set! first1000-source (add1 first1000-source)))
    (when (<= position 1000) (set! first1000-cohort (add1 first1000-cohort)))
    (when (equal? (hash-ref r "registry_only_covered") "0") (set! newly-covered (add1 newly-covered))))
  (for ([lab missing]) (hash-update! all-missing lab add1 0))
  (unless ok?
    (define signature (string-join (sort missing string<?) " "))
    (hash-update! groups signature (lambda (rs) (cons r rs)) '()))
  (set! outrows
        (cons (list order idx (hash-ref r "theorem") (if ok? 1 0)
                    (hash-ref r "registry_only_covered") (if (null? full-missing) 1 0)
                    (string-join deps " ") (string-join numbered " ")
                    (string-join logical " ")
                    (string-join (for/list ([lab logical])
                                   (string-append lab "=" (hash-ref (hash-ref rh lab) "judge_step_kinds"))) "; ")
                    (string-join missing " ") (length missing)
                    (string-join full-missing " ") (hash-ref r "statement")) outrows)))
(set! outrows (reverse outrows))
(unless (and (= old-covered 22) (= covered (+ old-covered newly-covered)))
  (error 'coverage "earlier/new coverage totals"))
(new-table "COVERAGE-2.tsv"
           '("theorem_order" "assertion_index" "theorem" "covered" "registry_only_covered"
             "full_signature_sensitivity_covered" "required_labels" "numbered_counterpart_labels"
             "routed_logic_labels" "routed_step_kinds" "missing_labels" "missing_count"
             "full_signature_sensitivity_missing_labels" "statement") outrows)
(define (gain labels)
  (for/sum ([(signature rs) (in-hash groups)] #:when (subset? (words signature) labels)) (length rs)))
(define ranked
  (sort (hash-keys all-missing)
        (lambda (a b)
          (define ca (hash-ref all-missing a)) (define cb (hash-ref all-missing b))
          (or (> ca cb) (and (= ca cb) (string<? a b))))))
(new-table "BLOCKERS.tsv"
           '("label" "theorems_blocked" "extension_formula" "rank"
             "theorems_unlocked_by_label_alone" "mandatory_signature" "essential_hypotheses"
             "distinct_variable_pairs" "extension_kind" "extension_arity"
             "new_symbol" "new_defining_formula" "exact_defining_rhs"
             "registry_extension_boundary" "formula_registration_boundary")
           (for/list ([lab ranked] [rank (in-naturals 1)])
             (define e (hash-ref extensions lab))
             (define m (hash-ref mh lab))
             (unless (equal? (hash-ref e "exact_source_extension_formula")
                             (hash-ref m "setmm_statement"))
               (error 'coverage "blocker formula/source mismatch: ~a" lab))
             (list lab (hash-ref all-missing lab) (hash-ref e "exact_source_extension_formula") rank
                   (gain (list lab)) (hash-ref e "mandatory_signature")
                   (hash-ref e "essential_hypotheses") (hash-ref e "distinct_variable_pairs")
                   (hash-ref e "extension_kind") (hash-ref e "extension_arity")
                   (hash-ref e "new_symbol") (hash-ref e "new_defining_formula")
                   (hash-ref e "exact_defining_rhs") (hash-ref e "registry_extension_boundary")
                   (hash-ref e "formula_registration_boundary"))))
(define bundles
  (for/list ([(signature rs) (in-hash groups)])
    (define labels (words signature))
    (define unlocked (gain labels))
    (list signature (length labels) (length rs) unlocked (+ covered unlocked)
          (/ unlocked (length labels)) (string-join (map (lambda (r) (hash-ref r "theorem")) (reverse rs)) " "))))
(define sorted-bundles
  (sort bundles (lambda (a b)
                  (or (> (list-ref a 5) (list-ref b 5))
                      (and (= (list-ref a 5) (list-ref b 5))
                           (or (> (list-ref a 3) (list-ref b 3))
                               (and (= (list-ref a 3) (list-ref b 3)) (string<? (car a) (car b)))))))))
(new-table "MISSING-SETS-2.tsv"
           '("addition_labels" "addition_count" "theorems_with_exact_missing_set"
             "newly_unlocked_theorems" "total_covered_after_additions" "newly_unlocked_per_addition_exact"
             "theorems_with_exact_missing_set_labels") sorted-bundles)
(define prefix '())
(define last-gain 0)
(new-table "UNLOCK-PREFIX-2.tsv"
           '("addition_count" "last_added_label" "last_label_blocked_count"
             "newly_unlocked_at_this_addition" "cumulative_newly_unlocked" "total_covered"
             "remaining_uncovered" "addition_labels")
           (for/list ([lab ranked] [k (in-naturals 1)])
             (set! prefix (append prefix (list lab)))
             (define n (gain prefix))
             (define result (list k lab (hash-ref all-missing lab) (- n last-gain) n (+ covered n)
                                  (- 5757 covered n) (string-join prefix " ")))
             (set! last-gain n)
             result))
(unless (= (+ covered last-gain) 5757) (error 'coverage "complete extension union"))
(define metric-rows
  (list (list "cohort_rows" 5757) (list "cohort_provable_assertions" 5753)
        (list "cohort_syntax_assertions" 4) (list "source_labels" (length maps))
        (list "numbered_registry_matches" (hash-count registry))
        (list "logic_routes" (length routes))
        (list "covered_logic_routes" (count (lambda (r) (equal? (hash-ref r "covered_by_order") "1")) routes))
        (list "missing_logic_routes" (count (lambda (r) (equal? (hash-ref r "covered_by_order") "0")) routes))
        (list "registry_only_covered" old-covered) (list "covered" covered)
        (list "newly_covered" newly-covered) (list "covered_provable_assertions" covered-proof)
        (list "covered_syntax_assertions" covered-syntax) (list "covered_empty_dependencies" empty-deps)
        (list "uncovered" (- 5757 covered)) (list "full_signature_sensitivity_covered" full-covered)
        (list "conditional_route_coverage_difference" (- covered full-covered))
        (list "blocker_labels" (length ranked)) (list "distinct_missing_sets" (hash-count groups))
        (list "first_1000_source_theorems_covered" first1000-source)
        (list "first_1000_cohort_rows_covered" first1000-cohort)
        (list "cohort_decoded_dependency_differences" 0)))
(new-table "ROUND2-METRICS.tsv" '("metric" "count") metric-rows)
(for ([r metric-rows]) (displayln (format "~a=~a" (car r) (cadr r))))
(for ([lab (take ranked (min 10 (length ranked)))])
  (displayln (format "blocker ~a: blocks ~a; alone unlocks ~a" lab (hash-ref all-missing lab) (gain (list lab)))))
