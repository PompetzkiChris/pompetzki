#lang racket/base
(require racket/file racket/list racket/string)

(define (read-table path)
  (define lines (file->lines path))
  (define headers (string-split (car lines) "\t" #:trim? #f))
  (for/list ([line (in-list (cdr lines))] #:unless (string=? line ""))
    (define cells (string-split line "\t" #:trim? #f))
    (unless (= (length headers) (length cells))
      (error 'audit "column count: ~a" path))
    (for/hash ([h (in-list headers)] [c (in-list cells)]) (values h c))))
(define (index rows) (for/hash ([r (in-list rows)]) (values (hash-ref r "label") r)))
(define (words value) (string-split value))
(define discrepancies '())
(define checks (make-hash))
(define (check kind subject actual expected)
  (hash-update! checks kind add1 0)
  (unless (equal? actual expected)
    (set! discrepancies
          (cons (list kind subject (format "~a" actual) (format "~a" expected)) discrepancies))))
(define maps (read-table "MAP.tsv"))
(define original (read-table "COVERAGE.tsv"))
(define cohort (read-table "CLASS-FREE.tsv"))
(define old-routes (read-table "LOGIC-ROUTES.tsv"))
(define new-routes (read-table "ROUTES-2.tsv"))
(define coverage (read-table "COVERAGE-2.tsv"))
(define blocker-table (read-table "BLOCKERS.tsv"))
(define extensions (index (read-table "EXTENSION-FORMULAS-v2.tsv")))
(define maps-by-label (index maps))
(define old-routes-by-label (index old-routes))
(define new-routes-by-label (index new-routes))
(define unrouted '("ax-prv1" "ax-prv2" "ax-prv3"))
(define conditional '("ax-frege52c" "ax-frege54c"))
(define (numbered? label) (not (string=? (hash-ref (hash-ref maps-by-label label) "registry_index") "")))
(define (routed? label)
  (and (hash-has-key? old-routes-by-label label) (not (member label unrouted))))
(define (fully-routed? label) (and (routed? label) (not (member label conditional))))
(define (missing deps [full? #f])
  (filter (lambda (label) (not (or (numbered? label) ((if full? fully-routed? routed?) label)))) deps))
(check "route_count" "rows" (length new-routes) 85)
(check "route_label_set" "labels"
       (sort (hash-keys new-routes-by-label) string<?)
       (sort (hash-keys old-routes-by-label) string<?))
(for ([r (in-list new-routes)])
  (define label (hash-ref r "label"))
  (define old (hash-ref old-routes-by-label label))
  (check "route_flag" label (hash-ref r "covered_by_order") (if (routed? label) "1" "0"))
  (check "route_full_flag" label (hash-ref r "full_signature_covered") (if (fully-routed? label) "1" "0"))
  (for ([f '("operator_signature" "source_statement" "source_mandatory_variables"
              "source_disjoint_pairs" "essential_hypotheses")])
    (check "route_source_field" (string-append label ":" f) (hash-ref r f) (hash-ref old f)))
  (check "route_prior_basis" label (hash-ref r "source_kernel_route") (hash-ref old "kernel_route"))
  (check "route_step_kind_present" label
         (and (not (string=? (hash-ref r "judge_step_kinds") ""))
              (if (routed? label) (not (string=? (hash-ref r "judge_step_kinds") "none"))
                  (string=? (hash-ref r "judge_step_kinds") "none"))) #t))
(check "coverage_count" "rows" (length coverage) 5757)
(check "original_count" "rows" (length original) 5757)
(check "decoded_cohort_count" "rows" (length cohort) 5757)
(define missing-rows '())
(define blocker-counts (make-hash))
(define signature-counts (make-hash))
(define prior-order 0)
(define prior-index -1)
(define covered-total 0)
(define full-covered-total 0)
(for ([r (in-list coverage)] [old (in-list original)] [source (in-list cohort)])
  (define label (hash-ref r "theorem"))
  (define order (string->number (hash-ref r "theorem_order")))
  (define assertion-index (string->number (hash-ref r "assertion_index")))
  (check "strict_source_order" label (> order prior-order) #t)
  (check "strict_assertion_order" label (> assertion-index prior-index) #t)
  (set! prior-order order)
  (set! prior-index assertion-index)
  (for ([f '("theorem_order" "assertion_index" "theorem" "statement" "registry_only_covered" "required_labels")])
    (check "original_coverage_field" (string-append label ":" f) (hash-ref r f) (hash-ref old f)))
  (for ([f '("theorem_order" "assertion_index" "theorem" "statement")])
    (check "decoded_source_field" (string-append label ":" f) (hash-ref r f) (hash-ref source f)))
  (define deps (words (hash-ref old "required_labels")))
  (check "decoded_dependencies" label deps (words (hash-ref source "decoded_dependencies")))
  (check "decoded_dependencies_receipt" label (hash-ref source "dependencies_equal") "1")
  (check "decoded_class_free_receipt" label (hash-ref source "decoded_class_free") "1")
  (define absent (missing deps))
  (define full-absent (missing deps #t))
  (define logical (filter routed? deps))
  (define numbered (filter numbered? deps))
  (set! missing-rows (cons absent missing-rows))
  (when (null? absent) (set! covered-total (add1 covered-total)))
  (when (null? full-absent) (set! full-covered-total (add1 full-covered-total)))
  (for ([lab (in-list absent)]) (hash-update! blocker-counts lab add1 0))
  (unless (null? absent)
    (hash-update! signature-counts (string-join (sort absent string<?) " ") add1 0))
  (check "coverage_flag" label (hash-ref r "covered") (if (null? absent) "1" "0"))
  (check "coverage_missing_labels" label (words (hash-ref r "missing_labels")) absent)
  (check "coverage_missing_count" label (string->number (hash-ref r "missing_count")) (length absent))
  (check "coverage_numbered_labels" label (words (hash-ref r "numbered_counterpart_labels")) numbered)
  (check "coverage_logic_labels" label (words (hash-ref r "routed_logic_labels")) logical)
  (check "coverage_step_kinds" label (hash-ref r "routed_step_kinds")
         (string-join (for/list ([lab (in-list logical)])
                        (string-append lab "=" (hash-ref (hash-ref new-routes-by-label lab) "judge_step_kinds"))) "; "))
  (check "coverage_full_flag" label (hash-ref r "full_signature_sensitivity_covered") (if (null? full-absent) "1" "0"))
  (check "coverage_full_missing_labels" label (words (hash-ref r "full_signature_sensitivity_missing_labels")) full-absent))
(set! missing-rows (reverse missing-rows))
(define expected-order
  (sort (hash-keys blocker-counts)
        (lambda (a b)
          (or (> (hash-ref blocker-counts a) (hash-ref blocker-counts b))
              (and (= (hash-ref blocker-counts a) (hash-ref blocker-counts b)) (string<? a b))))))
(define (gain labels)
  (for/sum ([absent (in-list missing-rows)]
            #:when (and (pair? absent) (for/and ([lab (in-list absent)]) (member lab labels)))) 1))
(check "blocker_count" "rows" (length blocker-table) (hash-count blocker-counts))
(check "blocker_order" "labels" (map (lambda (r) (hash-ref r "label")) blocker-table) expected-order)
(for ([r (in-list blocker-table)] [rank (in-naturals 1)])
  (define label (hash-ref r "label"))
  (define e (hash-ref extensions label))
  (define m (hash-ref maps-by-label label))
  (check "blocker_frequency" label (string->number (hash-ref r "theorems_blocked")) (hash-ref blocker-counts label))
  (check "blocker_rank" label (string->number (hash-ref r "rank")) rank)
  (check "blocker_alone_gain" label (string->number (hash-ref r "theorems_unlocked_by_label_alone")) (gain (list label)))
  (check "blocker_extension_formula" label (hash-ref r "extension_formula") (hash-ref e "exact_source_extension_formula"))
  (check "blocker_source_formula" label (hash-ref r "extension_formula") (hash-ref m "setmm_statement"))
  (for ([f '("mandatory_signature" "essential_hypotheses" "distinct_variable_pairs" "extension_kind"
              "extension_arity" "new_symbol" "new_defining_formula" "exact_defining_rhs"
              "registry_extension_boundary" "formula_registration_boundary")])
    (check "blocker_extension_field" (string-append label ":" f) (hash-ref r f) (hash-ref e f))))
(check "covered_aggregate" "rows" covered-total 4798)
(check "full_covered_aggregate" "rows" full-covered-total 4796)
(check "uncovered_aggregate" "rows" (- 5757 covered-total) 959)
(check "missing_label_aggregate" "labels" (hash-count blocker-counts) 77)
(check "missing_signature_aggregate" "sets" (hash-count signature-counts) 164)
(when (file-exists? "MISSING-SETS-2.tsv")
  (define bundles (read-table "MISSING-SETS-2.tsv"))
  (check "bundle_count" "rows" (length bundles) 164)
  (check "bundle_set_equality" "signatures"
         (sort (map (lambda (r) (hash-ref r "addition_labels")) bundles) string<?)
         (sort (hash-keys signature-counts) string<?))
  (for ([r (in-list bundles)])
    (define signature (hash-ref r "addition_labels"))
    (define labels (words signature))
    (check "bundle_size" signature (string->number (hash-ref r "addition_count")) (length labels))
    (check "bundle_exact_count" signature (string->number (hash-ref r "theorems_with_exact_missing_set")) (hash-ref signature-counts signature))
    (check "bundle_gain" signature (string->number (hash-ref r "newly_unlocked_theorems")) (gain labels))
    (check "bundle_total" signature (string->number (hash-ref r "total_covered_after_additions")) (+ covered-total (gain labels)))
    (check "bundle_ratio" signature (string->number (hash-ref r "newly_unlocked_per_addition_exact")) (/ (gain labels) (length labels)))
    (check "bundle_theorem_labels" signature (words (hash-ref r "theorems_with_exact_missing_set_labels"))
           (for/list ([source (in-list original)] [absent (in-list missing-rows)]
                      #:when (string=? signature (string-join (sort absent string<?) " ")))
             (hash-ref source "theorem")))))
(when (file-exists? "UNLOCK-PREFIX-2.tsv")
  (define prefix-table (read-table "UNLOCK-PREFIX-2.tsv"))
  (check "prefix_count" "rows" (length prefix-table) 77)
  (define labels '())
  (define last-gain 0)
  (for ([r (in-list prefix-table)] [lab (in-list expected-order)] [k (in-naturals 1)])
    (set! labels (append labels (list lab)))
    (define current-gain (gain labels))
    (check "prefix_label" k (hash-ref r "last_added_label") lab)
    (check "prefix_size" k (string->number (hash-ref r "addition_count")) k)
    (check "prefix_blocked" k (string->number (hash-ref r "last_label_blocked_count")) (hash-ref blocker-counts lab))
    (check "prefix_labels" k (words (hash-ref r "addition_labels")) labels)
    (check "prefix_increment" k (string->number (hash-ref r "newly_unlocked_at_this_addition")) (- current-gain last-gain))
    (check "prefix_gain" k (string->number (hash-ref r "cumulative_newly_unlocked")) current-gain)
    (check "prefix_total" k (string->number (hash-ref r "total_covered")) (+ covered-total current-gain))
    (check "prefix_remaining" k (string->number (hash-ref r "remaining_uncovered")) (- 5757 covered-total current-gain))
    (set! last-gain current-gain)))
(call-with-output-file "INDEPENDENT-FINAL-AUDIT-2.tsv" #:exists 'error
  (lambda (out)
    (displayln "check\tsubject\tactual\texpected\tresult" out)
    (for ([kind (in-list (sort (hash-keys checks) string<?))])
      (fprintf out "~a\tcheck_count\t~a\t~a\t~a\n" kind (hash-ref checks kind) (hash-ref checks kind)
               (if (for/or ([d (in-list discrepancies)]) (string=? (car d) kind)) "DIFFERENCE" "PASS")))
    (for ([d (in-list (reverse discrepancies))])
      (fprintf out "~a\t~a\t~a\t~a\tDIFFERENCE\n" (car d) (cadr d) (caddr d) (cadddr d)))
    (fprintf out "all_discrepancies\ttotal\t~a\t0\t~a\n" (length discrepancies)
             (if (null? discrepancies) "PASS" "DIFFERENCE"))))
(printf "FINAL independent checks=~a; discrepancies=~a; coverage=~a; full-coverage=~a; blockers=~a; sets=~a\n"
        (for/sum ([v (in-hash-values checks)]) v) (length discrepancies)
        covered-total full-covered-total (hash-count blocker-counts) (hash-count signature-counts))
(unless (null? discrepancies) (error 'audit "~a discrepancies" (length discrepancies)))
