(define f1 (i ph (i ps ph)))
(define f2 (i (i ph (i ps ch)) (i (i ph ps) (i ph ch))))
(define f3 (i (i (n ph) (n ps)) (i ps ph)))
;; Bound x has index 0; free y and z have indices 1 and 2 in each body.
