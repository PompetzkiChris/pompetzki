(define (Neg a) (intern 'neg a #f (F-fvb a)))
(define (Imp a b) (intern 'imp a b (max (F-fvb a) (F-fvb b))))
(define (All a) (intern 'all a #f (max 0 (sub1 (F-fvb a)))))

