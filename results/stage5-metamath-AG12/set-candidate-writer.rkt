(define source-path "C:/ClaudeOutput/formalization-toolchain-20260924/libraries/metamath-set-mm-28167ed89a49/set.mm")
(define source (file->string source-path))
(define labels '("axinf" "axinf2" "inf0" "omex" "dfac5" "dfac0" "ac8" "axac" "axac2" "axregs" "axtco"))
(call-with-output-file "SET-DERIVATION-SOURCES.md" #:exists 'error
  (lambda (out)
    (displayln "# Named set derivations verified in the source\n" out)
    (fprintf out "Source: `~a`. Each row was extracted from its actual `$p` assertion declaration. Lines are one-based source line numbers. These are source assertions and dependency references, not JDG1 acceptance results.\n\n" source-path)
    (for ([label (in-list labels)])
      (define rx (pregexp (string-append "(?m:^\\s*" (regexp-quote label) "\\s+\\$p\\s+)(?s:(.*?))\\s+\\$=")))
      (define positions (regexp-match-positions rx source))
      (unless positions (error 'source-verification "theorem absent: ~a" label))
      (define declaration-start (caar positions))
      (define line (+ 1 (for/sum ([c (in-string (substring source 0 declaration-start))] #:when (char=? c #\newline)) 1)))
      (define statement (string-join (string-split (substring source (caadr positions) (cdadr positions))) " "))
      (define rest (substring source (cdar positions)))
      (define proof-position (regexp-match-positions #px"(?s:^\\s*\\((.*?)\\))" rest))
      (define references (and proof-position (string-join (string-split (substring rest (caadr proof-position) (cdadr proof-position))) " ")))
      (fprintf out "## ~a\n\nSource declaration starts at line ~a.\n\n```text\n~a\n```\n\n" label line statement)
      (when references (fprintf out "Compressed-proof reference table:\n\n```text\n~a\n```\n\n" references)))
    (displayln "The displayed source names axinf and axinf2 establish the two Infinity presentations. The displayed source names dfac5, dfac0, ac8, axac2, and axac establish the Choice presentation routes. Scope and dependencies are given in SET-MATCH-ANALYSIS.md and SET-CANDIDATES.tsv." out)))
(printf "candidate_rows=~a source_theorems_verified=~a\n" (length rows) (length labels))
