;; ============================================================================
;; Proof step decoder
;; ============================================================================
(define (decode-proof-labels db a)
  (define p (assr-proof a))
  (cond
    [(and (pair? p) (equal? (car p) "("))
     ;; In compressed proofs, the labels in parentheses contain all referenced
     ;; assertions. The letters map to indices into (assr-hyps a) and plabs.
     (define-values (plabs rest)
       (let loop ([l (cdr p)] [acc '()])
         (if (equal? (car l) ")")
             (values (reverse acc) (cdr l))
             (loop (cdr l) (cons (car l) acc)))))
     plabs]
    [else
     ;; In uncompressed proofs, proof tokens are the label sequence
     (filter (lambda (t) (and (not (equal? t "?"))
                              (not (equal? t "$("))
                              (not (equal? t "$)"))))
             p)]))

