#lang racket/base
;; mm2jdg7.rkt -- lane L5 (Stage 5 of PMP-BUILDOUT-2026-10-09): Metamath set.mm -> JDG1, propositional and predicate
;; calculus (set.mm up to ax-ext and the first uses of it). Not trusted: every file goes to both judges.
;;
;; Formulas
;;  - a set variable is a frame variable of the theorem; a wff variable ph of a set.mm theorem T is the atom
;;    Pr (1000000 + i) [the set variables of T that ph may contain], i.e. all of T's set variables (in declaration
;;    order) except those with $d ph x. Predicate symbols >= 1000000 are outside the 670 registered definitions, so a
;;    statement over them is a schema (Prov.v prov_psub gives every instance). Dummy wff variables of a proof are
;;    closed atoms.
;;  - defined symbols are eliminated by their set.mm definitions: <-> /\ \/ -/\ \/_ -\/ if- 3o 3a T. F. hadd cadd as
;;    in mm2jdg3.rkt; E. = X (df-ex); F/ x ph = E. x ph -> A. x ph (df-nf); [ t / x ] ph = A. y ( y = t -> A. x
;;    ( x = y -> ph ) ) with y fresh (df-sb); E* x ph = E. y A. x ( ph -> x = y ) with y fresh (df-mo);
;;    E! x ph = E. x ph /\ E* x ph (df-eu); x = y, x e. y on set variables (cv) are Eqv, Mem. Every df-* axiom
;;    becomes a tautology.
;;
;; Statements. An assertion with hypotheses e1..ek and conclusion c becomes cl(e1) -> ... -> cl(ek) -> c, cl the
;; universal closure (frame variables generalized in increasing order). Frame variables are numbered by first
;; occurrence in e1 .. ek c; sig is the identity.
;;
;; Proofs. Every |- step of a set.mm proof becomes JDG1 steps, in the proof's order. A line resting on the hypotheses
;; is carried as G -> line, G the conjunction cl(e1) /\ ... /\ cl(ek) (closed), and its hypothesis lines come from
;; V steps (instantiation of the closure) and T.
;;   ax-mp -> M;  ax-1 ax-2 ax-3 -> Y (k s c);  ax-gen -> G (or H under G);  ax-4 -> Y dist;  ax-5, ax-10 -> Y vac;
;;   ax-6 -> V refl T;  ax-7 ax-8 ax-9 -> Z (Leibniz);  ax-11 -> V V T H H;  ax-12 -> Z refl V T H with a fresh
;;   variable;  ax-13 -> vac, refl or Z by the identification pattern of its variables;  ax-ext -> U 0 (the
;;   registry's Extensionality) V M V M;
;;   a use whose instance follows tautologically from its hypothesis lines -> T (every propositional theorem, every
;;   df-*);
;;   any other use of a theorem B at a substitution instance -> U of the JDG1 theorem "B at that instance", built
;;   once per file from B's own set.mm proof (recursively), then G/H over each hypothesis line's free variables and M
;;   (or T under G). The judge has no step that substitutes formulas for predicate symbols, so instances of wff
;;   variables are derived, never assumed.
;; Each emitted step is checked by this program's own copy of Replay2.v's sstep before it is written.
;;
;; Usage:
;;   racket mm2jdg5.rkt emit SETMM DIR FROM TO PER   the $p numbered FROM..TO (1-based, set.mm order) and the |-
;;                                                   axioms among them; PER of those $p per file
;;   racket mm2jdg5.rkt mutate DIR OUTDIR            10 mutants per DIR/*.jdg (each breaks a needed step)
;;   racket mm2jdg5.rkt judge DIR OUT                both judges on DIR/*.jdg and DIR/mut/*.jdg
;; Exact integers only.
(require racket/list racket/string racket/file racket/match racket/port racket/path "mm3.rkt"
         (only-in "jdg2mm2.rkt" read-jdg))

;; ============================================================================================ forms
(define (Kf a b) `(N (I ,a (N ,b))))
(define (Df a b) `(I (N ,a) ,b))
(define (Qf a b) (Kf `(I ,a ,b) `(I ,b ,a)))
(define (Xf a) `(N (A (N ,a))))
(define (tof d)
  (match d
    [(list 'e x y) `(E ,x ,y)] [(list 'q x y) `(Q ,x ,y)] [(list 'p p a) `(P ,p ,a)]
    [(list 'n a) `(N ,(tof a))] [(list 'i a b) `(I ,(tof a) ,(tof b))] [(list 'a a) `(A ,(tof a))]
    [(list 'k a b) (Kf (tof a) (tof b))] [(list 'd a b) (Df (tof a) (tof b))]
    [(list 'b a b) (Qf (tof a) (tof b))] [(list 'x a) (Xf (tof a))]))

(define (nlist l) (string-join (map number->string (cons (length l) l)) " "))
(define (dtext d)
  (match d
    [(list 'e x y) (format "e ~a ~a" x y)] [(list 'q x y) (format "q ~a ~a" x y)]
    [(list 'p p args) (format "p ~a ~a" p (nlist args))]
    [(list (and t (or 'n 'a 'x)) a) (format "~a ~a" t (dtext a))]
    [(list (and t (or 'i 'k 'd 'b)) a b) (format "~a ~a ~a" t (dtext a) (dtext b))]))
(define (steptext s)
  (match s
    [(list 'U r sig) (format "U ~a ~a" r (nlist sig))] [(list 'S l ts) (format "S ~a ~a" l (nlist ts))]
    [(list 'G l k) (format "G ~a ~a" l k)] [(list 'M i j) (format "M ~a ~a" i j)]
    [(list 'T ls g) (format "T ~a ~a" (nlist ls) (dtext g))] [(list 'E t g) (format "E ~a ~a" t (dtext g))]
    [(list 'L l k g) (format "L ~a ~a ~a" l k (dtext g))] [(list 'H k l g) (format "H ~a ~a ~a" k l (dtext g))]
    [(list 'V t g) (format "V ~a ~a" t (dtext g))] [(list 'Z a g) (format "Z ~a ~a" (dtext a) (dtext g))]
    [(list 'Y g) (format "Y ~a" (dtext g))]))

;; renamings: on dforms (with the abbreviations) and on core forms; under a binder up s
(define (sid n) n)
(define ((scons y s) n) (if (= n 0) y (s (sub1 n))))
(define ((absk k) j) (if (= j k) 0 (add1 j)))
(define (succ n) (add1 n))
(define (dren s d)
  (let go ([d d] [k 0])
    (define (v n) (if (< n k) n (+ k (s (- n k)))))
    (match d
      [(list 'e x y) `(e ,(v x) ,(v y))] [(list 'q x y) `(q ,(v x) ,(v y))] [(list 'p p a) `(p ,p ,(map v a))]
      [(list 'n a) `(n ,(go a k))] [(list 'i a b) `(i ,(go a k) ,(go b k))]
      [(list 'a a) `(a ,(go a (add1 k)))] [(list 'x a) `(x ,(go a (add1 k)))]
      [(list (and t (or 'k 'd 'b)) a b) (list t (go a k) (go b k))])))
(define (cren s f)
  (let go ([f f] [k 0])
    (define (v n) (if (< n k) n (+ k (s (- n k)))))
    (match f
      [(list 'E x y) `(E ,(v x) ,(v y))] [(list 'Q x y) `(Q ,(v x) ,(v y))] [(list 'P p a) `(P ,p ,(map v a))]
      [(list 'N a) `(N ,(go a k))] [(list 'I a b) `(I ,(go a k) ,(go b k))] [(list 'A a) `(A ,(go a (add1 k)))])))
(define (cfree? n f)
  (match f
    [(list (or 'E 'Q) x y) (or (= x n) (= y n))] [(list 'P _ a) (and (memv n a) #t)]
    [(list 'N a) (cfree? n a)] [(list 'I a b) (or (cfree? n a) (cfree? n b))] [(list 'A a) (cfree? (add1 n) a)]))
(define (cclosed? k f)
  (match f
    [(list (or 'E 'Q) x y) (and (< x k) (< y k))] [(list 'P _ a) (andmap (lambda (x) (< x k)) a)]
    [(list 'N a) (cclosed? k a)] [(list 'I a b) (and (cclosed? k a) (cclosed? k b))] [(list 'A a) (cclosed? (add1 k) a)]))
(define (cfreevars f)   ; free variables of a core form, ascending
  (sort (remove-duplicates
         (let go ([f f] [k 0])
           (match f
             [(list (or 'E 'Q) x y) (filter (lambda (n) (>= n 0)) (list (- x k) (- y k)))]
             [(list 'P _ a) (filter (lambda (n) (>= n 0)) (map (lambda (x) (- x k)) a))]
             [(list 'N a) (go a k)] [(list 'I a b) (append (go a k) (go b k))] [(list 'A a) (go a (add1 k))])))
        <))
(define (dgen k d) `(a ,(dren (absk k) d)))     ; A (frame variable k) d

