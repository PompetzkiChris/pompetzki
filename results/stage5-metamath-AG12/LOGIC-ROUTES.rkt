#lang racket/base
(require racket/file racket/list racket/string)
(define df-specs
 '(("df-bi" "2wff" "Q(ph,ps) := K(I(ph,ps),I(ps,ph))" "Qf expansion; source assertion follows by propositional tautology")
   ("df-an" "2wff" "K(ph,ps) := N(I(ph,N(ps)))" "Kf expansion")
   ("df-or" "2wff" "D(ph,ps) := I(N(ph),ps)" "Df expansion")
   ("df-ifp" "3wff" "if-(ph,ps,ch) := D(K(ph,ps),K(N(ph),ch))" "syntactic expansion")
   ("df-3or" "3wff" "or3(ph,ps,ch) := D(D(ph,ps),ch)" "syntactic expansion")
   ("df-3an" "3wff" "and3(ph,ps,ch) := K(K(ph,ps),ch)" "syntactic expansion")
   ("df-nan" "2wff" "nand(ph,ps) := N(K(ph,ps))" "syntactic expansion")
   ("df-xor" "2wff" "xor(ph,ps) := N(Q(ph,ps))" "syntactic expansion")
   ("df-nor" "2wff" "nor(ph,ps) := N(D(ph,ps))" "syntactic expansion")
   ("df-tru" "0" "T. := I(A[x](Eq(x,x)),A[x](Eq(x,x)))" "closed formula abbreviation; x is bound")
   ("df-fal" "0" "F. := N(T.)" "closed formula abbreviation")
   ("df-had" "3wff" "hadd(ph,ps,ch) := N(Q(N(Q(ph,ps)),ch))" "xor expansion")
   ("df-cad" "3wff" "cadd(ph,ps,ch) := D(K(ph,ps),K(ch,N(Q(ph,ps))))" "and/or/xor expansion")
   ("df-ex" "1wff+1set_binder" "X[x](ph) := N(A[x](N(ph)))" "Xf expansion")
   ("df-nf" "1wff+1set_binder" "NF[x](ph) := I(X[x](ph),A[x](ph))" "syntactic expansion")
   ("df-sb" "1wff+1set_binder+1set_term" "SB[t/x](ph) := A[y](I(Eq(y,t),A[x](I(Eq(x,y),ph))))" "capture-avoiding substitution; y fresh; source justification hypothesis retained")
   ("df-mo" "1wff+1set_binder" "MO[x](ph) := X[y](A[x](I(ph,Eq(x,y))))" "syntactic expansion; y fresh; source justification hypothesis retained")
   ("df-eu" "1wff+1set_binder" "EU[x](ph) := K(X[x](ph),MO[x](ph))" "syntactic expansion")
   ("df-nfc" "1class+1set_binder" "NFC[x](A) := A[y](NF[x](Mem(y,A)))" "class membership expansion; y fresh")
   ("df-ne" "2class" "NE(A,B) := N(ClassEq(A,B))" "class equality expansion; set operands reduce to Eq")
   ("df-nel" "2class" "NEL(A,B) := N(ClassMem(A,B))" "class membership expansion; set operands reduce to Mem")
   ("df-ral" "1wff+1set_binder+1class" "RAL[x,A](ph) := A[x](I(Mem(x,A),ph))" "bounded universal expansion")
   ("df-rex" "1wff+1set_binder+1class" "REX[x,A](ph) := X[x](K(Mem(x,A),ph))" "bounded existential expansion")
   ("df-rmo" "1wff+1set_binder+1class" "RMO[x,A](ph) := MO[x](K(Mem(x,A),ph))" "bounded uniqueness expansion")
   ("df-reu" "1wff+1set_binder+1class" "REU[x,A](ph) := EU[x](K(Mem(x,A),ph))" "bounded existence and uniqueness expansion")
   ("df-cdeq" "1wff+2set" "CondEq(x=y -> ph) := I(Eq(x,y),ph)" "syntactic expansion")
   ("df-2reu" "1wff+2set_binder+2class" "2REU[x,A,y,B](ph) := K(REU[x,A](REX[y,B](ph)),REU[y,B](REX[x,A](ph)))" "two restricted uniqueness operators")
   ("df-bnj17" "4wff" "and4(ph,ps,ch,th) := K(K(K(ph,ps),ch),th)" "syntactic expansion")
   ("df-3nand" "3wff" "nand3(ph,ps,ch) := I(ph,I(ps,N(ch)))" "syntactic expansion")
   ("df-bj-nnf" "1wff+1set_binder" "NNF[x](ph) := K(I(X[x](ph),ph),I(ph,A[x](ph)))" "syntactic expansion")
   ("df-redundp" "3wff" "redund(ph,ps,ch) := K(I(ph,ps),Q(K(ph,ch),K(ps,ch)))" "syntactic expansion")
   ("df-vd1" "2wff" "VD1(ph,ps) := I(ph,ps)" "alternate connective notation expansion")
   ("df-vd2" "3wff" "VD2(ph,ps,ch) := I(K(ph,ps),ch)" "alternate connective notation expansion")
   ("df-vhc2" "2wff" "VHC2(ph,ps) := K(ph,ps)" "alternate connective notation expansion")
   ("df-vhc3" "3wff" "VHC3(ph,ps,ch) := K(K(ph,ps),ch)" "alternate connective notation expansion")
   ("df-vd3" "4wff" "VD3(ph,ps,ch,th) := I(K(K(ph,ps),ch),th)" "alternate connective notation expansion")
   ("df-ich" "1wff+2set_binder" "ICH[x,y](ph) := A[x](A[y](Q(SB[x/a](SB[y/x](SB[a/y](ph))),ph)))" "interchange expansion; a fresh")
   ("df-als" "2wff+1set_binder" "ALS[x](ph,ps) := K(A[x](I(ph,ps)),X[x](ph))" "all and some expansion")
   ("df-rals" "2wff+1set_binder+1class" "RALS[x,A](ph,ps) := K(RAL[x,A](I(ph,ps)),REX[x,A](ph))" "restricted all and some expansion")
   ("df-alseu" "2wff+1set_binder" "ALSEU[x](ph,ps) := K(A[x](I(ph,ps)),EU[x](ph))" "all and unique existence expansion")
   ("df-ralseu" "2wff+1set_binder+1class" "RALSEU[x,A](ph,ps) := K(RAL[x,A](I(ph,ps)),REU[x,A](ph))" "restricted all and unique existence expansion")))
(define ax-routes
 '(("ax-mp" "SMp; rule with2 essential hypotheses")
   ("ax-gen" "SGen; generalization rule with1 essential hypothesis")
   ("ax-4" "SAx; quantifier distribution")
   ("ax-5" "SAx; vacuous quantification; source $d(ph,x) retained")
   ("ax-6" "reflexivity and existential introduction; source derived theorem ax6")
   ("ax-7" "SLeib on equality plus symmetry; source derived theorem ax7")
   ("ax-8" "SLeib on Mem(x,z); source derived theorem ax8")
   ("ax-9" "SLeib on Mem(z,x); source derived theorem ax9")
   ("ax-10" "vacuous quantification after binding x; first-order derivation required")
   ("ax-11" "quantifier commutation via instantiation/generalization; first-order derivation required")
   ("ax-12" "Leibniz and quantifier instantiation; source derived theorem ax12")
   ("ax-13" "equality case split and vacuity; source derived theorem ax13")
   ("ax-c4" "quantifier distribution and idempotence; source derived theorem axc4")
   ("ax-c5" "SInst at the same variable; source derived theorem sp")
   ("ax-c7" "quantifier vacuity and specialization; source derived theorem axc7")
   ("ax-c10" "specialization at y, equality reflexivity, specialization; source derived theorem axc10")
   ("ax-c11" "quantifier specialization and equality substitution; source derived theorem axc11")
   ("ax-c11n" "equality symmetry and quantification; source derived theorem axc11n")
   ("ax-c15" "equality substitution under quantification; source derived theorem axc15")
   ("ax-c9" "equality case split and vacuity; source derived theorem axc9")
   ("ax-c14" "membership substitution and vacuity; source derived theorem axc14")
   ("ax-c16" "equality case split and vacuity; source derived theorem axc16; source $d(x,y) retained")
   ("ax-wl-13v" "equality and vacuity with source disjoint pairs; first-order derivation required")
   ("ax-frege52c" "Leibniz after class-substitution lowering; class operands require an explicit interpretation")
   ("ax-frege54c" "class-equality reflexivity after lowering; SAx reflexivity when A is a set variable")
   ("ax-frege58b" "SInst after capture-avoiding substitution expansion")
   ("ax-prv1" "missing provability necessitation rule; no fixed first-order definition supplies the rule")
   ("ax-prv2" "missing provability distribution schema; no fixed first-order definition supplies it")
   ("ax-prv3" "missing provability positive-introspection schema; no fixed first-order definition supplies it")))
(define prop-labels '("ax-1" "ax-2" "ax-3" "ax-luk1" "ax-luk2" "ax-luk3" "ax-frege1"
 "ax-frege2" "ax-frege8" "ax-frege28" "ax-frege31" "ax-frege41" "ax-frege52a" "ax-frege54a" "ax-frege58a"))
(define df-h (for/hash ([s (in-list df-specs)]) (values (car s) (cdr s))))
(define ax-h (for/hash ([s (in-list ax-routes)]) (values (car s) (cadr s))))
(define rows (map (lambda (l) (string-split l "\t" #:trim? #f)) (cdr (file->lines "SOURCE-LABELS.tsv"))))
(define outrows 0)
(call-with-output-file "LOGIC-ROUTES.tsv"
 (lambda (out)
  (displayln "label\tstrict_registry_match\toperator_signature\texpansion_or_missing_statement\tkernel_route\tsource_statement\tsource_mandatory_variables\tsource_disjoint_pairs\tessential_hypotheses" out)
  (for ([r (in-list rows)])
   (define label (list-ref r 1)) (define df (hash-ref df-h label #f))
   (define ax (hash-ref ax-h label #f)) (define prop? (member label prop-labels))
   (when (or df ax prop?)
    (set! outrows (add1 outrows))
    (define signature (if df (car df) (list-ref r 5)))
    (define expansion (if df (cadr df) (list-ref r 3)))
    (define route (cond [df (caddr df)] [ax ax] [else "STaut after logical abbreviation expansion; exact truth table verified"] ))
    (fprintf out "~a\tno counterpart\t~a\t~a\t~a\t~a\t~a\t~a\t~a\n" label signature expansion route
      (list-ref r 3) (list-ref r 5) (list-ref r 6) (list-ref r 4))))) #:exists 'error)
(printf "logical_definitions=~a logical_axioms=~a rows=~a\n" (length df-specs) (+ (length ax-routes) (length prop-labels)) outrows)
