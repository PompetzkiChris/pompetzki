#lang racket/base
(require racket/file racket/list racket/string)

(define (read-table path)
  (define lines (file->lines path))
  (define headers (string-split (car lines) "\t" #:trim? #f))
  (for/list ([line (in-list (cdr lines))] #:unless (string=? line ""))
    (define cells (string-split line "\t" #:trim? #f))
    (unless (= (length headers) (length cells))
      (error 'independent-verification "column count: ~a" path))
    (for/hash ([h (in-list headers)] [c (in-list cells)]) (values h c))))

(define maps (read-table "MAP.tsv"))
(define routes (read-table "LOGIC-ROUTES.tsv"))
(define coverage (read-table "COVERAGE.tsv"))
(define extensions (read-table "EXTENSION-FORMULAS-v2.tsv"))
(define map-index (for/hash ([r (in-list maps)]) (values (hash-ref r "label") r)))
(define extension-index (for/hash ([r (in-list extensions)]) (values (hash-ref r "label") r)))
(define unrouted '("ax-prv1" "ax-prv2" "ax-prv3"))
(define logical-index
  (for/hash ([r (in-list routes)] #:unless (member (hash-ref r "label") unrouted))
    (values (hash-ref r "label") r)))
(define numbered-index
  (for/hash ([r (in-list maps)] #:unless (string=? (hash-ref r "registry_index") ""))
    (values (hash-ref r "label") r)))
(define (covered-label? label)
  (or (hash-has-key? logical-index label) (hash-has-key? numbered-index label)))
(define expected-missing
  (for/list ([r (in-list coverage)])
    (filter (lambda (label) (not (covered-label? label)))
            (string-split (hash-ref r "required_labels")))))
(define covered-count (count null? expected-missing))
(define blockers (make-hash))
(for ([labs (in-list expected-missing)])
  (for ([label (in-list labs)])
    (hash-update! blockers label add1 0)))
(define ordered-blockers
  (sort (hash-keys blockers)
        (lambda (a b)
          (or (> (hash-ref blockers a) (hash-ref blockers b))
              (and (= (hash-ref blockers a) (hash-ref blockers b)) (string<? a b))))))
(define label-bits
  (for/hash ([label (in-list (sort (hash-keys blockers) string<?))] [i (in-naturals)])
    (values label (arithmetic-shift 1 i))))
(define set-frequencies (make-hash))
(define set-labels (make-hash))
(for ([labs (in-list expected-missing)] #:unless (null? labs))
  (define mask (for/fold ([mask 0]) ([label (in-list labs)])
                 (bitwise-ior mask (hash-ref label-bits label))))
  (hash-update! set-frequencies mask add1 0)
  (hash-set! set-labels mask labs))
(define ordered-masks
  (sort (hash-keys set-frequencies)
        (lambda (a b)
          (or (> (hash-ref set-frequencies a) (hash-ref set-frequencies b))
              (and (= (hash-ref set-frequencies a) (hash-ref set-frequencies b))
                   (string<? (string-join (hash-ref set-labels a) " ")
                             (string-join (hash-ref set-labels b) " ")))))))
(define (gain addition-mask)
  (let loop ([submask addition-mask] [total 0])
    (if (zero? submask) total
        (loop (bitwise-and (sub1 submask) addition-mask)
              (+ total (hash-ref set-frequencies submask 0))))))
(define ordered-labels (sort (hash-keys blockers) string<?))
(define label-vector (list->vector ordered-labels))
(define best-gain (make-vector 4 -1))
(define best-sets (make-vector 4 '()))
(define examined (make-vector 4 0))
(define (consider labels)
  (define k (length labels))
  (define mask (for/fold ([mask 0]) ([label (in-list labels)])
                 (bitwise-ior mask (hash-ref label-bits label))))
  (define g (gain mask))
  (vector-set! examined k (add1 (vector-ref examined k)))
  (cond [(> g (vector-ref best-gain k))
         (vector-set! best-gain k g)
         (vector-set! best-sets k (list labels))]
        [(= g (vector-ref best-gain k))
         (vector-set! best-sets k (cons labels (vector-ref best-sets k)))]))
(define n (vector-length label-vector))
(for ([i (in-range n)]) (consider (list (vector-ref label-vector i))))
(for* ([i (in-range n)] [j (in-range (add1 i) n)])
  (consider (list (vector-ref label-vector i) (vector-ref label-vector j))))
(for* ([i (in-range n)] [j (in-range (add1 i) n)] [k (in-range (add1 j) n)])
  (consider (list (vector-ref label-vector i) (vector-ref label-vector j) (vector-ref label-vector k))))

(unless (= (length coverage) 5757) (error 'independent-verification "cohort count"))
(unless (= (hash-count numbered-index) 8) (error 'independent-verification "numbered count"))
(unless (= (hash-count logical-index) 82) (error 'independent-verification "logic route count"))
(for ([r (in-list maps)])
  (define label (hash-ref r "label"))
  (define e (hash-ref extension-index label))
  (unless (and (string=? (hash-ref r "setmm_statement") (hash-ref e "exact_source_extension_formula"))
               (string=? (hash-ref r "extension_exact_source_extension_formula") (hash-ref e "exact_source_extension_formula")))
    (error 'independent-verification "source/extension mismatch: ~a" label)))
(for ([r (in-list coverage)] [order (in-naturals 1)])
  (unless (= (string->number (hash-ref r "theorem_order")) order)
    (error 'independent-verification "theorem order: ~a" order))
  (define deps (string-split (hash-ref r "required_labels")))
  (unless (= (length deps) (length (remove-duplicates deps)))
    (error 'independent-verification "duplicate dependency: ~a" order))
  (for ([label (in-list deps)])
    (unless (hash-has-key? map-index label)
      (error 'independent-verification "unmapped dependency: ~a" label))))

(call-with-output-file "INDEPENDENT-COVERAGE-2.tsv" #:exists 'error
  (lambda (out)
    (displayln "section\tkey\tvalue\tdetails" out)
    (define (row section key value details) (fprintf out "~a\t~a\t~a\t~a\n" section key value details))
    (for ([p (in-list (list (cons "cohort" (length coverage))
                            (cons "logic_routes" (hash-count logical-index))
                            (cons "numbered_matches" (hash-count numbered-index))
                            (cons "covered" covered-count)
                            (cons "uncovered" (- (length coverage) covered-count))
                            (cons "distinct_missing_labels" (hash-count blockers))
                            (cons "distinct_missing_dependency_sets" (hash-count set-frequencies))))])
      (row "metric" (car p) (cdr p) ""))
    (row "metric" "covered_provable"
         (for/sum ([r (in-list coverage)] [labs (in-list expected-missing)]
                   #:when (and (null? labs) (string-prefix? (hash-ref r "statement") "|- "))) 1) "")
    (row "metric" "covered_syntax"
         (for/sum ([r (in-list coverage)] [labs (in-list expected-missing)]
                   #:when (and (null? labs) (string-prefix? (hash-ref r "statement") "wff "))) 1) "")
    (row "metric" "covered_first1000" (count null? (take expected-missing 1000)) "")
    (row "metric" "strict_class_route_sensitivity_covered"
         (for/sum ([r (in-list coverage)])
           (if (for/and ([label (in-list (string-split (hash-ref r "required_labels")))])
                 (and (covered-label? label) (not (member label '("ax-frege52c" "ax-frege54c"))))) 1 0))
         "excludes ax-frege52c and ax-frege54c from routed labels")
    (for ([label (in-list ordered-blockers)] [rank (in-naturals 1)])
      (row "blocker" label (hash-ref blockers label)
           (format "rank=~a; formula=~a" rank (hash-ref (hash-ref map-index label) "extension_exact_source_extension_formula"))))
    (for ([mask (in-list ordered-masks)] [i (in-naturals 1)])
      (row "missing_set" i (hash-ref set-frequencies mask) (string-join (hash-ref set-labels mask) " ")))
    (for ([k (in-range 1 4)])
      (row "optimization" (format "best_~a_additions_gain" k) (vector-ref best-gain k)
           (format "covered=~a; examined=~a; tie_count=~a"
                   (+ covered-count (vector-ref best-gain k))
                   (vector-ref examined k) (length (vector-ref best-sets k))))
      (for ([labels (in-list (reverse (vector-ref best-sets k)))])
        (row "optimal_addition_set" k (vector-ref best-gain k) (string-join labels " "))))))
(printf "BASELINE cohort=~a; covered=~a; uncovered=~a; missing-labels=~a; missing-sets=~a\n"
        (length coverage) covered-count (- (length coverage) covered-count)
        (hash-count blockers) (hash-count set-frequencies))
(for ([label (in-list (take ordered-blockers (min 10 (length ordered-blockers))))])
  (printf "BLOCKER ~a ~a\n" label (hash-ref blockers label)))
(for ([k (in-range 1 4)])
  (printf "OPT ~a gain=~a examined=~a ties=~a first=~a\n" k
          (vector-ref best-gain k) (vector-ref examined k)
          (length (vector-ref best-sets k)) (car (reverse (vector-ref best-sets k)))))
