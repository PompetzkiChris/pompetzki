#lang racket/base
(require racket/file racket/list racket/string)
(define (table path)
  (define lines (file->lines path))
  (define headers (string-split (car lines) "\t" #:trim? #f))
  (for/list ([line (in-list (cdr lines))] #:unless (string=? line ""))
    (define cells (string-split line "\t" #:trim? #f))
    (unless (= (length cells) (length headers)) (error 'summary "column count"))
    (for/hash ([h (in-list headers)] [c (in-list cells)]) (values h c))))
(define baseline (table "INDEPENDENT-COVERAGE-2.tsv"))
(define metrics (for/hash ([r (in-list baseline)] #:when (string=? (hash-ref r "section") "metric"))
                  (values (hash-ref r "key") (string->number (hash-ref r "value")))))
(define covered (hash-ref metrics "covered"))
(define cohort (hash-ref metrics "cohort"))
(define labels (hash-ref metrics "distinct_missing_labels"))
(define verification-bytes (file->bytes "INDEPENDENT-FINAL-AUDIT-2.tsv"))
(call-with-output-file "INDEPENDENT-VERIFICATION-2.tsv" #:exists 'error
  (lambda (out) (write-bytes verification-bytes out)))
(define (choose n k)
  (for/fold ([r 1]) ([i (in-range 1 (add1 k))]) (/ (* r (- n (sub1 i))) i)))
(call-with-output-file "OPTIMAL-ADDITIONS-2.tsv" #:exists 'error
  (lambda (out)
    (displayln "addition_budget\toptimal_addition_labels\tnewly_unlocked_theorems\ttotal_covered\tremaining_uncovered\tcandidates_enumerated\toptimal_sets_count\tmethod" out)
    (for ([k (in-range 1 4)])
      (define candidates
        (filter (lambda (r) (and (string=? (hash-ref r "section") "optimal_addition_set")
                                (= (string->number (hash-ref r "key")) k))) baseline))
      (define optimization
        (findf (lambda (r) (and (string=? (hash-ref r "section") "optimization")
                               (string=? (hash-ref r "key") (format "best_~a_additions_gain" k)))) baseline))
      (define examined (choose labels k))
      (unless (regexp-match? (regexp (format "examined=~a;" examined)) (hash-ref optimization "details"))
        (error 'summary "enumeration receipt mismatch: ~a" k))
      (for ([r (in-list candidates)])
        (define gain (string->number (hash-ref r "value")))
        (unless (and (exact-nonnegative-integer? gain)
                     (= gain (string->number (hash-ref optimization "value"))))
          (error 'summary "optimal gain receipt mismatch: ~a" k))
        (fprintf out "~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\n"
                 k (hash-ref r "details") gain (+ covered gain) (- cohort covered gain)
                 examined (length candidates)
                 "Exhaustive exact-integer bitmask enumeration; gain sums all nonempty missing-set submasks")))))
(displayln "WROTE INDEPENDENT-VERIFICATION-2.tsv and OPTIMAL-ADDITIONS-2.tsv")
