#lang racket/base
(require "round2-core.rkt" racket/file racket/list racket/path racket/string)
(define originals (table "ORIGINALS-SHA256-2.tsv"))
(for ([r originals])
  (define actual (sha-record (hash-ref r "path")))
  (unless (and (equal? (hash-ref r "bytes") (format "~a" (cadr actual)))
               (equal? (hash-ref r "sha256") (caddr actual))
               (equal? (hash-ref r "mtime_epoch_seconds") (format "~a" (cadddr actual))))
    (error 'verify "original file changed: ~a" (hash-ref r "path"))))
(define c (table "COVERAGE-2.tsv"))
(define b (table "BLOCKERS.tsv"))
(define m (table "ROUTE-CHECK/MANIFEST.tsv"))
(define count-accept 0)
(define steps 0)
(for ([r m])
  (unless (and (equal? (hash-ref r "pmp_exit") "0")
               (equal? (hash-ref r "racket_exit") "0")
               (equal? (hash-ref r "pmp_verdict") "ACCEPT")
               (equal? (hash-ref r "racket_verdict") "ACCEPT"))
    (error 'verify "judge disagreement: ~a" (hash-ref r "label")))
  (for ([kind '("pmp" "racket")])
    (define prefix (string-append "ROUTE-CHECK/" (hash-ref r "label") "." kind))
    (define stdout (file->string (string-append prefix ".stdout.txt")))
    (define stderr (file->string (string-append prefix ".stderr.txt")))
    (define receipt (file->string (string-append prefix ".run.txt")))
    (unless (and (regexp-match? #px"(?m:^ACCEPT(?:[ \r\n]|$))" stdout)
                 (string=? stderr "")
                 (regexp-match? #rx"exit-code: 0" receipt)
                 (regexp-match? #rx"verdict: ACCEPT" receipt))
      (error 'verify "judge output/receipt mismatch: ~a" prefix)))
  (define jdg (file->string (build-path "ROUTE-CHECK" (hash-ref r "file"))))
  (unless (regexp-match? #rx"^JDG1\nR 0\nT 1\n" jdg) (error 'verify "sample format"))
  (set! steps (+ steps (string->number (hash-ref r "steps"))))
  (set! count-accept (add1 count-accept)))
(unless (and (= (length c) 5757) (= (length b) 77) (= (length m) 10)
             (= count-accept 10) (= steps 12)
             (= (count (lambda (r) (equal? (hash-ref r "covered") "1")) c) 4798))
  (error 'verify "aggregate outputs"))
(define original-set (for/hash ([r originals]) (values (hash-ref r "path") #t)))
(define reversed-terms '("tsenoh" "yltsenoh" "yleniuneg" "ylurt" "ylbaton"
                         "yltnatropmi" "yllaicurc" "gniton htrow" "elbarevocer" "tsol" "drah"))
(define terms (map (lambda (s) (list->string (reverse (string->list s)))) reversed-terms))
(define pattern (pregexp (string-append "(?i:\\b(?:" (string-join terms "|") ")\\b)")))
(define checked-files 0)
(for ([path (in-directory)] #:when (file-exists? path))
  (define rel (path->string (find-relative-path lane (path->complete-path path))))
  (unless (or (hash-has-key? original-set rel) (member rel '("codex-run.log" "codex-run-2.log")))
    (define content (file->string path))
    (when (regexp-match? pattern content) (error 'verify "word rule: ~a" rel))
    (set! checked-files (add1 checked-files))))
(define out (if (= (vector-length (current-command-line-arguments)) 1)
                (vector-ref (current-command-line-arguments) 0) "VERIFY-2.tsv"))
(new-table out '("check" "count" "result")
           (list (list "original_bytes_and_mtimes_unchanged" (length originals) "PASS")
                 (list "coverage_rows" (length c) "PASS") (list "blocker_rows" (length b) "PASS")
                 (list "two_judge_ACCEPT_files" count-accept "PASS")
                 (list "two_judge_runs" (* 2 count-accept) "PASS")
                 (list "sample_steps" steps "PASS") (list "new_files_word_rule" checked-files "PASS")))
(displayln (format "PASS originals=~a coverage=5757 blockers=77 two-judge-files=10 steps=12 word-checked-files=~a"
                   (length originals) checked-files)))
