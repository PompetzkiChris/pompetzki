#lang racket/base
;; Exact dependency extraction for the AG8 class-free cohort.
(require racket/file racket/list racket/string racket/match
         (file "C:/ClaudeOutput/pompetzki/lanes/L5/mm3.rkt"))
(provide (all-defined-out))
(define source-path "C:/ClaudeOutput/formalization-toolchain-20260924/libraries/metamath-set-mm-28167ed89a49/set.mm")
(define queue-path "C:/ClaudeOutput/pompetzki/lanes/AG8/setmm_queue.tsv")
(define (has-abstraction? ts) (for/or ([t ts]) (equal? t "|")))
(define (words s) (if (string=? s "") '() (string-split s)))
(define (stmt db a) (string-append (assr-type a) " " (string-join (vector->list (assr-toks a)) " ")))
(define (essentials db a)
  (for/list ([h (assr-hyps a)] #:when (ehyp? (lookup db h)))
    (define r (lookup db h))
    (string-append h ": " (ehyp-type r) " " (string-join (vector->list (ehyp-toks r)) " "))))
(define (variables db a)
  (for/list ([h (assr-hyps a)] #:when (fhyp? (lookup db h)))
    (define r (lookup db h)) (string-append (fhyp-var r) ":" (fhyp-type r))))
(define (dvs a) (string-join (for/list ([p (sort (assr-dvs a) string<? #:key (lambda (p) (string-append (car p) " " (cdr p))))])
                             (string-append (car p) " " (cdr p))) "; "))
(define (extract [out-prefix ""])
  (define db (read-db source-path))
  (define cohort '()) (define queue-deps (make-hash)) (define p-order (make-hash))
  (call-with-input-file queue-path
    (lambda (in)
      (read-line in)
      (for ([line (in-lines in)] [pidx (in-naturals 1)] #:unless (or (string=? (string-trim line) "") (string-prefix? line "#")))
        (define cols (string-split line "\t" #:trim? #f))
        (unless (= (length cols) 9) (error 'inventory "queue columns: ~a" pidx))
        (when (equal? (list-ref cols 5) "0")
          (define lab (car cols))
          (set! cohort (cons lab cohort))
          (hash-set! queue-deps lab (words (list-ref cols 4)))
          (hash-set! p-order lab pidx)))))
  (set! cohort (reverse cohort))
  (unless (= (length cohort) 5757) (error 'inventory "cohort count: ~a" (length cohort)))
  (define axdfs
    (for/list ([lab (mmdb-order db)]
               #:when (let ([a (lookup db lab)])
                        (and (eq? (assr-kind a) 'a) (equal? (assr-type a) "|-")
                             (or (string-prefix? lab "ax-") (string-prefix? lab "df-"))))) lab))
  (define bit-index (for/hash ([lab axdfs] [i (in-naturals)]) (values lab i)))
  (define deps (make-vector (vector-length (mmdb-order db)) 0))
  (define abstraction (make-vector (vector-length deps) #f))
  (define direct (make-hash))
  (define unused-table-entries 0)
  (for ([lab (mmdb-order db)])
    (define a (lookup db lab)) (define idx (assr-idx a))
    (define own-abstraction
      (or (member lab '("cab" "crab" "copab")) (has-abstraction? (assr-toks a))
          (for/or ([h (assr-hyps a)])
            (define r (lookup db h)) (and (ehyp? r) (has-abstraction? (ehyp-toks r))))))
    (cond
      [(eq? (assr-kind a) 'a)
       (when (hash-has-key? bit-index lab)
         (vector-set! deps idx (arithmetic-shift 1 (hash-ref bit-index lab))))
       (vector-set! abstraction idx (and own-abstraction #t))]
      [else
       (define used
         (remove-duplicates
          (for/list ([x (decode-proof db a)]
                     #:when (and (vector? x) (eq? (vector-ref x 0) 'L)
                                 (assr? (lookup db (vector-ref x 1)))))
            (vector-ref x 1))))
       (hash-set! direct lab used)
       (define mask 0) (define cab? (and own-abstraction #t))
       (for ([pl used])
         (define ref (lookup db pl))
         (unless (< (assr-idx ref) idx) (error 'inventory "non-earlier proof reference ~a -> ~a" lab pl))
         (set! mask (bitwise-ior mask (vector-ref deps (assr-idx ref))))
         (set! cab? (or cab? (vector-ref abstraction (assr-idx ref)))))
       (vector-set! deps idx mask) (vector-set! abstraction idx cab?)
       (when (and (pair? (assr-proof a)) (equal? (car (assr-proof a)) "("))
         (define table (takef (cdr (assr-proof a)) (lambda (x) (not (equal? x ")")))))
         (set! unused-table-entries (+ unused-table-entries
                                      (count (lambda (x) (and (assr? (lookup db x)) (not (member x used)))) table))))]))
  (define (mask->labels mask)
    (for/list ([lab axdfs] [i (in-naturals)] #:when (bitwise-bit-set? mask i)) lab))
  (define cohort-set (for/hash ([lab cohort]) (values lab #t)))
  (define actually-free
    (for/list ([lab (mmdb-order db)] #:when (let ([a (lookup db lab)])
                                             (and (eq? (assr-kind a) 'p)
                                                  (not (vector-ref abstraction (assr-idx a)))))) lab))
  (define mismatch-count 0) (define union-mask 0) (define counts (make-hash))
  (call-with-output-file (string-append out-prefix "CLASS-FREE.tsv") #:exists 'error
    (lambda (out)
      (display "theorem_order\tassertion_index\ttheorem\tag8_dependencies\tdecoded_dependencies\tdependencies_equal\tdecoded_class_free\tstatement\n" out)
      (for ([lab cohort])
        (define a (lookup db lab)) (define mask (vector-ref deps (assr-idx a)))
        (define actual (mask->labels mask)) (define expected (hash-ref queue-deps lab))
        (define same? (equal? (sort actual string<?) (sort expected string<?)))
        (unless same? (set! mismatch-count (add1 mismatch-count)))
        (set! union-mask (bitwise-ior union-mask mask))
        (for ([x actual]) (hash-update! counts x add1 0))
        (fprintf out "~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\n"
                 (hash-ref p-order lab) (assr-idx a) lab (string-join expected " ")
                 (string-join actual " ") (if same? 1 0)
                 (if (vector-ref abstraction (assr-idx a)) 0 1) (stmt db a)))))
  (define union (mask->labels union-mask))
  (call-with-output-file (string-append out-prefix "SOURCE-LABELS.tsv") #:exists 'error
    (lambda (out)
      (display "assertion_index\tlabel\tuses_in_cohort\tstatement\tessential_hypotheses\tvariables\tdisjoint_pairs\n" out)
      (for ([lab union])
        (define a (lookup db lab))
        (fprintf out "~a\t~a\t~a\t~a\t~a\t~a\t~a\n" (assr-idx a) lab (hash-ref counts lab)
                 (stmt db a) (string-join (essentials db a) "; ")
                 (string-join (variables db a) " ") (dvs a)))))
  (call-with-output-file (string-append out-prefix "INVENTORY.tsv") #:exists 'error
    (lambda (out)
      (display "metric\tcount\n" out)
      (for ([row (list (cons "assertions" (vector-length (mmdb-order db)))
                             (cons "cohort" (length cohort)) (cons "decoded_class_free_all" (length actually-free))
                             (cons "decoded_class_free_cohort" (count (lambda (x) (not (vector-ref abstraction (assr-idx (lookup db x))))) cohort))
                             (cons "cohort_dependency_mismatches" mismatch-count)
                             (cons "unused_compressed_table_assertions" unused-table-entries)
                             (cons "relevant_labels" (length union))
                             (cons "relevant_axioms" (count (lambda (x) (string-prefix? x "ax-")) union))
                             (cons "relevant_definitions" (count (lambda (x) (string-prefix? x "df-")) union))
                             (cons "additional_decoded_class_free" (count (lambda (x) (not (hash-ref cohort-set x #f))) actually-free)))])
        (fprintf out "~a\t~a\n" (car row) (cdr row)))))
  (printf "cohort=~a union=~a mismatches=~a actual-class-free=~a unused-table=~a\n"
          (length cohort) (length union) mismatch-count (length actually-free) unused-table-entries)
  (values db cohort union))
(module+ main (define-values (db cohort union) (extract)))
