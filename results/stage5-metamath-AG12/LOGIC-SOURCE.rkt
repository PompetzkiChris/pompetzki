#lang racket/base
(require racket/file racket/list racket/string)
(define source "C:/ClaudeOutput/formalization-toolchain-20260924/libraries/metamath-set-mm-28167ed89a49/set.mm")
(define queue "C:/ClaudeOutput/pompetzki/lanes/AG8/setmm_queue.tsv")
(define union (make-hash))
(define n 0)
(call-with-input-file queue
  (lambda (in)
    (read-line in)
    (for ([l (in-lines in)])
      (define c (string-split l "\t" #:trim? #f))
      (when (and (= (length c) 9) (equal? (list-ref c 5) "0"))
        (set! n (add1 n))
        (for ([a (in-list (string-split (list-ref c 4)))])
          (hash-update! union a add1 0))))))
(define src (file->string source))
(define vartypes (make-hash))
(for ([m (in-list (regexp-match* #px"(?m:^\\s*[^\\s]+\\s+\\$f\\s+([^\\s]+)\\s+([^\\s]+)\\s+\\$\\.)" src #:match-select values))])
  (hash-set! vartypes (list-ref m 2) (list-ref m 1)))
(call-with-output-file "LOGIC-SOURCE-UNION.tsv"
  (lambda (out)
    (displayln "label\tclass_free_uses\tstatement\twff_variables\tset_variables\tclass_variables" out)
    (for ([a (in-list (sort (hash-keys union) string<?))])
      (define rx (pregexp (string-append "(?m:^\\s*" (regexp-quote a) "\\s+\\$a\\s+([^$]+)\\$\\.)")))
      (define m (regexp-match rx src))
      (unless m (error 'extract "assertion not found: ~a" a))
      (define toks (string-split (string-trim (list-ref m 1))))
      (define vars (remove-duplicates toks))
      (define (of-type t)
        (string-join (filter (lambda (v) (equal? (hash-ref vartypes v #f) t)) vars) " "))
      (fprintf out "~a\t~a\t~a\t~a\t~a\t~a\n" a (hash-ref union a) (string-join toks " ")
               (of-type "wff") (of-type "setvar") (of-type "class"))))
  #:exists 'error)
(printf "class_free=~a union=~a\n" n (hash-count union))
