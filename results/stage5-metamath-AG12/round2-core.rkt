#lang racket/base
(require racket/file racket/list racket/string racket/path file/sha1)
(provide (all-defined-out))
(define lane (simplify-path (current-directory)))
(define (table path)
  (define lines (file->lines path))
  (unless (pair? lines) (error 'table "empty table: ~a" path))
  (define headers (string-split (car lines) "\t" #:trim? #f))
  (for/list ([line (cdr lines)] #:unless (string=? line ""))
    (define cells (string-split line "\t" #:trim? #f))
    (unless (= (length cells) (length headers))
      (error 'table "column count: ~a" path))
    (for/hash ([h headers] [c cells]) (values h c))))
(define (row out cells)
  (define strings (map (lambda (v) (format "~a" v)) cells))
  (when (for/or ([s strings]) (regexp-match? #rx"[\t\r\n]" s))
    (error 'row "embedded separator"))
  (displayln (string-join strings "\t") out))
(define (new-table path headers rows)
  (call-with-output-file path #:exists 'error
    (lambda (out) (row out headers) (for ([r rows]) (row out r)))))
(define (words s) (string-split s))
(define (by-label rows) (for/hash ([r rows]) (values (hash-ref r "label") r)))
(define (sha-record path [label (path->string (if (path? path) path (string->path path)))])
  (define data (file->bytes path))
  (list label (bytes-length data)
        (string-upcase (bytes->hex-string (sha256-bytes data)))
        (file-or-directory-modify-seconds path)))
(define (subset? a b) (for/and ([x a]) (member x b)))
