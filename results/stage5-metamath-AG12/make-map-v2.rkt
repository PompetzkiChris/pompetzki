#lang racket/base
;; Combine source, registry, typed extension, and qualification tables.
(require racket/file racket/list racket/string racket/match "registry-reader-v3.rkt")
(define (read-tsv path)
  (define lines (filter (lambda (x) (not (string=? x ""))) (file->lines path)))
  (define (fields line) (string-split (regexp-replace #rx"\r$" line "") "\t" #:trim? #f))
  (define header (fields (car lines)))
  (define rows
    (for/list ([line (cdr lines)])
      (define cells (fields line))
      (unless (= (length cells) (length header)) (error 'tsv "column count in ~a" path))
      (for/hash ([k header] [v cells]) (values k v))))
  (values header rows))
(define (by-label rows) (for/hash ([r rows]) (values (hash-ref r "label") r)))
(define-values (source-header source-rows) (read-tsv "SOURCE-LABELS.tsv"))
(define sources (by-label source-rows))
(define-values (extension-header extension-rows) (read-tsv "EXTENSION-FORMULAS-v2.tsv"))
(define extensions (by-label extension-rows))
(define-values (logic-header logic-rows) (read-tsv "LOGIC-MATCHES.tsv"))
(define logic (by-label logic-rows))
(define-values (candidate-header candidate-rows) (read-tsv "SET-CANDIDATES.tsv"))
(define candidates (by-label candidate-rows))
(define matches
  (hash "ax-ext" (list 0 "identical up to variable renaming" "Universal closure of free x,y; bound z renamed.")
        "ax-pow" (list 3 "identical up to variable renaming" "Universal closure of free x; bound variables renamed.")
        "ax-pr" (list 1 "equivalent by a short derivation" "Pair formulations: equality substitution; specialize the source universal w to x and y.")
        "ax-un" (list 2 "equivalent by a short derivation" "Existential antecedent elimination and universal introduction; interchange independent universal binders.")
        "ax-reg" (list 5 "equivalent by a short derivation" "Quantifier duality: forall z(z in y -> not z in x) iff not exists z(z in x and z in y).")
        "ax-inf2" (list 4 "equivalent by a short derivation" "Conjunction commutation in empty-set and successor witnesses; alpha conversion.")
        "ax-inf" (list 4 "equivalent by a short derivation" "ZF infinity-form equivalence; source axinf and axinf2. Relative to remaining ZF, including Foundation and the required schemas.")
        "ax-ac" (list 6 "equivalent by a short derivation" "ZF choice-form equivalence by disjoint-family tagging; source ac8/dfac5 and axac/ax-ac2. Relative to remaining ZF, including Foundation.")))
(unless (= (length source-rows) 167) (error 'source "expected167"))
(unless (= (length extension-rows) 167) (error 'extensions "expected167"))
(unless (equal? (sort (hash-keys sources) string<?) (sort (hash-keys extensions) string<?))
  (error 'extensions "source label mismatch"))
(for ([lab (hash-keys matches)]) (unless (hash-has-key? sources lab) (error 'matches "unused label~a" lab)))

;; Independent set.mm core parser for the literal matches and Inf2 check.
(define (parse-set-statement statement outer-vars)
  (define tokens (cdr (string-split statement)))
  (define (pop!) (when (null? tokens) (error 'parse "end")) (begin0 (car tokens) (set! tokens (cdr tokens))))
  (define (expect! expected) (define t (pop!)) (unless (equal? t expected) (error 'parse "expected~a got~a" expected t)))
  (define (variable name bound)
    (define i (index-of bound name)) (unless i (error 'parse "free variable~a" name)) i)
  (define (form bound)
    (define t (pop!))
    (cond
      [(equal? t "-.") (list 'N (form bound))]
      [(member t '("A." "E."))
       (define x (pop!)) (list (if (equal? t "A.") 'A 'X) (form (cons x bound)))]
      [(equal? t "(")
       (define a (form bound)) (define op (pop!)) (define b (form bound)) (expect! ")")
       (list (hash-ref (hash "->" 'I "<->" 'Q "/\\" 'K "\\/" 'D) op) a b)]
      [else
       (define op (pop!)) (define y (pop!))
       (list (hash-ref (hash "=" '= "e." 'E) op) (variable t bound) (variable y bound))]))
  (define body (form (reverse outer-vars)))
  (unless (null? tokens) (error 'parse "remaining tokens~a" tokens))
  (for/fold ([f body]) ([x (reverse outer-vars)]) (list 'A f)))
(define (commute-conjunctions f)
  (match f
    [(list 'K a b)
     (define ab (sort (list (commute-conjunctions a) (commute-conjunctions b)) string<? #:key (lambda (x) (format "~s" x))))
     (cons 'K ab)]
    [(list (and op (or 'A 'X 'N)) a) (list op (commute-conjunctions a))]
    [(list (and op (or 'I 'D 'Q)) a b) (list op (commute-conjunctions a) (commute-conjunctions b))]
    [_ f]))
(define checks
  (for/list ([spec (list (list "ax-ext" '("x" "y") 0 #f)
                        (list "ax-pow" '("x") 3 #f)
                        (list "ax-inf2" '() 4 #t))])
    (match-define (list lab outer idx comm?) spec)
    (define a (parse-set-statement (hash-ref (hash-ref sources lab) "statement") outer))
    (define b (reg-entry-formula (registry-ref idx)))
    (define ok? (equal? ((if comm? commute-conjunctions values) a) ((if comm? commute-conjunctions values) b)))
    (unless ok? (error 'match-check "failed~a" lab))
    (list lab idx (if comm? "alpha+conjunction-commutation" "alpha+universal-closure") 1)))

(define extra-extension (filter (lambda (x) (not (equal? x "label"))) extension-header))
(define extra-logic '("operator_signature" "expansion_or_missing_statement" "kernel_route"))
(define extra-candidate (filter (lambda (x) (not (equal? x "label"))) candidate-header))
(define map-header
  (append '("assertion_index" "label" "uses_in_cohort" "setmm_statement" "essential_hypotheses" "mandatory_variables" "disjoint_pairs"
            "registry_index" "registry_name" "registry_formula" "registry_named_prefix" "registry_de_bruijn_prefix" "match_class" "derivation")
          (map (lambda (x) (string-append "extension_" x)) extra-extension)
          (map (lambda (x) (string-append "logic_" x)) extra-logic)
          (map (lambda (x) (string-append "qualified_" x)) extra-candidate)))
(define (write-row out cells) (displayln (string-join (map (lambda (x) (format "~a" x)) cells) "\t") out))
(call-with-output-file "MAP.tsv" #:exists 'error
  (lambda (out)
    (write-row out map-header)
    (for ([s source-rows])
      (define lab (hash-ref s "label")) (define m (hash-ref matches lab #f))
      (define entry (and m (registry-ref (car m))))
      (define e (hash-ref extensions lab)) (define l (hash-ref logic lab (hash))) (define c (hash-ref candidates lab (hash)))
      (write-row out
        (append (for/list ([k '("assertion_index" "label" "uses_in_cohort" "statement" "essential_hypotheses" "variables" "disjoint_pairs")]) (hash-ref s k))
                (if entry (list (reg-entry-index entry) (reg-entry-name entry) (formula->pretty (reg-entry-formula entry))
                                (formula->named (reg-entry-formula entry)) (formula->prefix (reg-entry-formula entry)))
                    (list "" "" "" "" ""))
                (list (if m (cadr m) "no counterpart") (if m (caddr m) "No entry for the full source signature; consult typed extension and qualified set interpretation columns."))
                (for/list ([k extra-extension]) (hash-ref e k ""))
                (for/list ([k extra-logic]) (hash-ref l k ""))
                (for/list ([k extra-candidate]) (hash-ref c k "")))))))
(define-values (cohort-header cohort-rows) (read-tsv "CLASS-FREE.tsv"))
(define covered 0) (define first1000 0)
(define coverage-header '("theorem_order" "assertion_index" "theorem" "registry_only_covered" "required_labels" "no_counterpart_labels" "numbered_counterpart_labels" "statement"))
(define previous 0)
(call-with-output-file "COVERAGE.tsv" #:exists 'error
  (lambda (out)
    (write-row out coverage-header)
    (for ([r cohort-rows])
      (define ordinal (string->number (hash-ref r "theorem_order")))
      (unless (and (exact-positive-integer? ordinal) (> ordinal previous)) (error 'order "nonincreasing~a" ordinal))
      (set! previous ordinal)
      (define deps (string-split (hash-ref r "decoded_dependencies")))
      (for ([lab deps]) (unless (hash-has-key? sources lab) (error 'coverage "unknown~a" lab)))
      (define absent (filter (lambda (lab) (not (hash-has-key? matches lab))) deps))
      (define present (filter (lambda (lab) (hash-has-key? matches lab)) deps))
      (define ok? (null? absent))
      (when ok? (set! covered (add1 covered)) (when (<= ordinal 1000) (set! first1000 (add1 first1000))))
      (write-row out (list ordinal (hash-ref r "assertion_index") (hash-ref r "theorem") (if ok? 1 0)
                           (string-join deps " ") (string-join absent " ") (string-join present " ") (hash-ref r "statement"))))))
(unless (= (length cohort-rows) 5757) (error 'coverage "expected5757"))
(unless (= covered 22) (error 'coverage "unexpected count~a" covered))
(call-with-output-file "MATCH-VALIDATION.tsv" #:exists 'error
  (lambda (out) (write-row out '("label" "registry_index" "check" "passed")) (for ([r checks]) (write-row out r))))
(call-with-output-file "MAP-SUMMARY.tsv" #:exists 'error
  (lambda (out)
    (write-row out '("metric" "count"))
    (for ([r (list (list "map_labels" 167) (list "axioms" 80) (list "definitions" 87)
                   (list "numbered_counterparts" (hash-count matches)) (list "identical" 2)
                   (list "equivalent" 6) (list "no_counterpart" (- 167 (hash-count matches)))
                   (list "coverage_rows" (length cohort-rows)) (list "registry_only_covered" covered)
                   (list "registry_only_uncovered" (- 5757 covered)) (list "first1000_registry_only_covered" first1000)
                   (list "source_registry_checks" (length checks)))]) (write-row out r))))
(printf "MAP=167 numbered=8 none=159 COVERAGE=5757 covered=~a first1000=~a checks=3\n" covered first1000)
