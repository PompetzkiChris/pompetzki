#lang racket/base
;; mkmod-0033.rkt - lane L2R, 2026-10-10. Wraps a Rocq Scheme extraction (IN.scm) as a Racket module (OUT.rkt, new file):
;; drops the (load "macros_extr.scm") line, requires extr-macros-0033.rkt, provides every definition.
(require racket/file racket/string racket/match)
(define (go in out)
  (define body (filter (lambda (l) (not (regexp-match? #rx"^\(load " l))) (file->lines in)))
  (call-with-output-file out #:exists 'error
    (lambda (o)
      (fprintf o "#lang racket/base\n;; ~a - generated by mkmod-0033.rkt from ~a\n(require \"extr-macros-0033.rkt\")\n(provide (all-defined-out))\n" out in)
      (for ([l body]) (displayln l o)))))
(module+ main
  (match (vector->list (current-command-line-arguments))
    [(list in out) (go in out)]))
