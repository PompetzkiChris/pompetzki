#lang racket/base
;; Resolve historical aliases only to manifest-listed files inside this archive.
(require racket/file racket/path racket/runtime-path racket/string)
(provide portable-path)
(define-runtime-path code-dir ".")
(define root (simplify-path (path->complete-path (build-path code-dir 'up)) #t))
(define (canon p)
  (define s (string-replace (if (path? p) (path->string p) p) "\\" "/"))
  (define m (regexp-match-positions #px"[A-Za-z]:/" s))
  (string-downcase (if m (substring s (caar m)) s)))
(define (fail message p)
  (error 'portable-path "~a: ~a" message p))
(define (contained p)
  (define target (simplify-path (path->complete-path p root) #t))
  (define relative (find-relative-path root target))
  (unless (and (relative-path? relative) (not (member 'up (explode-path relative))))
    (fail "path leaves archive root" p))
  ;; Archive payloads use ordinary directories/files, without junction or link hops.
  (for/fold ([prefix root]) ([part (in-list (explode-path relative))])
    (define next (build-path prefix part))
    (when (link-exists? next) (fail "archive path traverses a link" p))
    next)
  target)
(define (mapped-path p)
  (when (or (complete-path? p) (regexp-match? #px"^[A-Za-z]:" (if (path? p) (path->string p) p)))
    (fail "mapped archive path must be relative" p))
  (contained p))
(define manifest (make-hash))
(call-with-input-file (build-path root "SHA256SUMS.txt")
  (lambda (in)
    (for ([s (in-lines in)])
      (define f (regexp-match #px"^([0-9a-f]{64}) \\*(.+)$" s))
      (unless f (fail "invalid manifest row" s))
      (define target (mapped-path (caddr f)))
      (define key (canon target))
      (when (hash-has-key? manifest key) (fail "duplicate manifest file" target))
      (hash-set! manifest key (cadr f)))))
(define aliases (make-hash))
(call-with-input-file (build-path root "PATH-ALIASES.tsv")
  (lambda (in)
    (unless (equal? (read-line in) "original\tportable\tsha256\tkind")
      (fail "invalid alias header" "PATH-ALIASES.tsv"))
    (for ([s (in-lines in)])
      (define f (string-split s "\t" #:trim? #f))
      (unless (= (length f) 4) (fail "invalid alias row" s))
      (define target (mapped-path (cadr f)))
      (define key (canon (car f)))
      (unless (file-exists? target) (fail "mapped archive file missing" target))
      (unless (equal? (hash-ref manifest (canon target) #f) (caddr f))
        (fail "mapped archive file absent from manifest or digest differs" target))
      (when (hash-has-key? aliases key) (fail "duplicate historical alias" (car f)))
      (hash-set! aliases key target))))
(define (portable-path p)
  (define alias (hash-ref aliases (canon p) #f))
  (cond
    [alias alias]
    [else
     ;; Contained missing local paths remain valid file-exists? probes.
     (when (and (regexp-match? #px"^[A-Za-z]:/" (canon p))
                (not (complete-path? p)))
       (fail "historical path missing alias" p))
     (define target (contained p))
     (when (and (file-exists? target) (not (hash-has-key? manifest (canon target))))
       (fail "archive file absent from manifest" target))
     target]))
